// Shared structs, the Rust bridge, design tokens and small widgets.
import { Palette, Button, LineEdit, ComboBox } from "std-widgets.slint";

export enum Confidence { confirmed, derived, unresolved }

export struct SlotInfo { slot: int, used: bool, name: string, hr: int, playtime: string }

// One value of a change, in game terms: "Wycademy points  9,793,209 → 9,999,999".
// warning: why the game cannot produce the new value ("" when it can)
export struct ValueLine { label: string, old: string, new: string, warning: string }

// A Review entry. The first entry of a page group carries the group label.
export struct ChangeRow {
    id: int, group: string, first: bool,
    title: string, sub: string, confidence: Confidence,
    // one value: shown on the title row
    single: bool, old: string, new: string,
    lines: [ValueLine], more: int, note: string,
    key: string,  // the field to open (first value)
    warning: string,  // one value: why the game cannot produce it; several: how many it cannot
}

export struct WriteRow { title: string, right: string, confidence: Confidence, old: string, new: string, warning: string }

export struct SnapRow { dir: string, when: string, before: string }

export struct DetectedSave { path: string, title: string, sub: string, when: string, short: string }

// Settings as the dialog shows them; indexes into its option lists.
export struct SettingsInfo {
    language: int,         // 0 the system's, then i18n::LANGS
    languages: [string],   // the choices, each in its own language
    theme: int,            // 0 system, 1 light, 2 dark
    scale: int,            // System, 100 % … 200 %
    scale-now: string,     // the size in use, when a new one waits for a restart
    snapshot-dir: string, snapshot-custom: bool,
    keep: int,             // All, 5, 10, 20, 50
    snapshot-first: bool,
    folders: [string],
    emulators: [string],   // added ones
    builtin: string,       // the names always checked
    reopen: bool, recent: int,
    confirmed-only: bool,
    check-updates: bool,
    // matugen (Linux): offered, ticked, what it reads now, the template saved, the
    // lines for matugen's config.toml
    matugen-offered: bool, matugen: bool, matugen-hint: string,
    matugen-template: bool, matugen-snippet: string,
}

// The colours of one scheme (Tok): built in, or from matugen. Text keeps the widgets'
// foreground: plain Text elements take it and cannot be given another.
export struct Scheme {
    page: color, side: color, card: color, raised: color,
    muted: color, faint: color,
    line: color, track: color, hover: color,
    accent-text: color, bad: color,
    input: color, input-active: color, input-border: color, input-edge: color,
}

// Self update. state: "" idle, "checking", "current" (no newer one), "error" (check
// failed), "available", "downloading", "failed" (install failed), "ready" (restart)
export struct UpdateInfo {
    state: string,
    version: string,       // the newer one
    status: string,        // one line for Settings
    body: string,          // the dialog's text
    progress: float,       // 0-1 while downloading
    can-install: bool,     // this copy can replace itself
}

export struct MonsterRow {
    index: int, name: string, icon: image, has-icon: bool, large: bool, has-size: bool, sub: string,
    hunts: int, captures: int, min: int, max: int, mini: bool, crown: int, notes: bool, has-notes: bool,
    thresholds: string,
    // value in the file when staged, else ""
    was-hunts: string, was-captures: string, was-min: string, was-max: string, was-notes: string,
    changed: bool,
    warning: string,  // why the game cannot produce its counts or sizes ("" when it can)
}

// The Database (read-only): an entry of a tab's list.
export struct DbRow { index: int, name: string, sub: string, icon: image, has-icon: bool }

// A quest's chance (0-1) to give a crown size.
export struct CrownOdds { quest: string, sub: string, chance: float, label: string }

// One item of a carve or reward table; `have` is what the item box holds.
export struct DropItem { name: string, icon: image, has-icon: bool, chance: string, have: string }
export struct DropTable { title: string, items: [DropItem] }

// A quest's monster in the Database: size %, the sizes it can roll, crown chances.
export struct DbQuestMonster { index: int, name: string, icon: image, has-icon: bool, size: string, range: string, gold: string, mini: string }

// Where an item comes from: a monster's carve or a quest's reward (kind "monster" or
// "quest", index what open-db takes).
export struct DbSource { kind: string, index: int, where: string, how: string, chance: string, icon: image, has-icon: bool }

// An item in the Database (index = item ID, -1: none).
export struct DbItem { index: int, name: string, sub: string, icon: image, has-icon: bool, sources: [DbSource], more: string, uses: [DbSource], uses-more: string }

// A line of a Database list: name, a second line, a value at the right; `link` > 0: the
// entry open-db opens on a click (kind given by the list).
export struct DbLine { name: string, sub: string, value: string, icon: image, has-icon: bool, link: int }

// A row of tables side by side (the levels of a piece of equipment).
export struct DbTables { tables: [DropTable] }

// A piece of equipment in the Database (index = equipment ID or decoration item, -1:
// none): what forging it and upgrading into it take, the pieces before and after it, and
// each level's materials.
export struct DbEquip { index: int, name: string, sub: string, icon: image, has-icon: bool, make: [DropTable], tree: [DbLine], levels: [DbTables], note: string }

// A skill tree in the Database (index = tree, -1: none): the skills it activates, the
// decorations, talismans and armor pieces that give its points (the `-more` lines: those
// left out, and the decorations that lower it).
export struct DbSkill { index: int, name: string, sub: string, tiers: [DbLine], decos: [DbLine], decos-more: string, charms: [DbLine], armor: [DbLine], armor-more: string }

// A quest in the Database (index -1: none). `note` says why rewards are missing.
export struct DbFact { label: string, value: string }
// main: reward rows A to D (the reward screen's red Base rows); extra: the subquest's
export struct DbQuest { index: int, name: string, sub: string, objective: string, subquest: string, sub-reward: string, facts: [DbFact], monsters: [DbQuestMonster], main: [DropTable], extra: [DropTable], note: string }

// A monster in the Database. The size scale runs from `lo` to `hi` (%); min/max are the
// save's record (0 = none). crown: 0 none, 1 silver, 2 gold. Carves of the rank
// `carve-rank` of `carve-ranks` (their ids in `carve-ids`).
export struct DbMonster {
    index: int, name: string, sub: string, icon: image, has-icon: bool,
    has-size: bool, fixed: bool, size-note: string,
    lo: int, hi: int, min: int, max: int, mini-le: int, silver-ge: int, gold-ge: int, mini: bool, crown: int,
    gold-odds: [CrownOdds], gold-more: string, mini-odds: [CrownOdds], mini-more: string,
    carve-ranks: [string], carve-ids: [string], carve-rank: int, carves: [DropTable], carve-note: string,
}

// max: most of the item one slot holds (pouch: the item's carry limit)
// max: the game's limit for the item there (pouch: its carry limit); counts above it can
// still be written, with `warning`
export struct ItemSlot { slot: int, id: int, name: string, count: int, max: int, icon: image, has-icon: bool, changed: bool, was: string, warning: string }

export struct PickItem { id: int, name: string, icon: image, has-icon: bool, sub: string, max: int }

// A loadout, or a run of empty ones (index -1, loadouts first to last).
export struct LoadoutRow { index: int, first: int, last: int, name: string, summary: string, used: bool }

export struct EquipRow {
    slot: int, kind-code: int, title: string, sub: string,
    icon: image, has-icon: bool, changed: bool, status: string,
    warning: string,  // why the game cannot produce this entry ("" when it can)
}

// A decoration in a box entry: its field, name and the slots it takes.
export struct DecoRow { index: int, name: string, size: int }

export struct EquipDetail {
    slot: int, kind: string, kind-code: int, name: string, id: int, level: int, was-level: string,
    decos: [DecoRow], transmog: string, transmog-id: int,
    is-talisman: bool, skill1: int, points1: int, skill2: int, points2: int, slots: int, tier: string,
    raw: string, field: string,
    // worn / My Sets referring to this box slot (then it can't be replaced or removed)
    uses: string,
    category: int,  // index in Api.equip-categories, -1 for none
    was: string,    // piece in the file when the slot is staged
    warning: string,  // why the game cannot produce this entry ("" when it can)
    deco-slots: int,  // decoration slots of the piece, -1 unknown
    deco-used: int,   // slots its decorations take
    can-transmog: bool,
}

export struct PalicoRow { index: int, name: string, sub: string, changed: bool }

// A slot of a Palico's support move or skill list: innate ones cannot be changed, taught
// ones are the slots the Palico Dojo fills; `on` when equipped.
export struct PalicoEntry { slot: int, id: int, name: string, innate: bool, taught: bool, on: bool }

// A look: a choice (`index` into `choices`) or a colour (`index` into `swatches`, -1 when
// the colour is none of them).
export struct LookRow { key: string, label: string, is-colour: bool, index: int, choices: [string], swatches: [color], colour: color }

export struct PalicoDetail {
    warning: string,  // why the game cannot produce its level, forte or target ("" when it can)
    index: int, name: string, level: int, exp: int, bias: int, target: int, greeting: string, owner: string,
    move-rows: [PalicoEntry], skill-rows: [PalicoEntry], moves-used: string, skills-used: string, look-rows: [LookRow],
    was-name: string, was-level: string, was-exp: string, was-bias: string, was-greeting: string, was-owner: string,
    was-target: string, was-moves: string, was-skills: string, warn-moves: string, warn-skills: string,
    was-looks: string, warn-looks: string,
}

export struct QuestRow {
    index: int, id: int, name: string, sub: string, cleared: bool, seen: bool, failed: bool,
    locked: bool, prowler: bool, changed: bool, was: string,
    // group header: label and the "Mark 1★ cleared" action (rank or deviant)
    header: bool, group: string, action: string,
}

export struct RequestRow { index: int, name: string, sub: string, accepted: bool, completed: bool, has-flags: bool, changed: bool, was: string }

export struct CheckRow { key: int, name: string, on: bool, changed: bool, icon: image, has-icon: bool }

// Hunter Arts grouped by art: one row, one to three levels (I, II, III)
export struct ArtRow { name: string, ids: [int], on: [bool], changed: bool }

export struct DeviantRow {
    index: int, name: string, permits: int, levels: int, total: int, icon: image, has-icon: bool,
    was-permits: string, was-levels: string,
    // Special Permit points and those waiting at the Courier (100 make a permit)
    points: int, waiting: int, was-points: string, was-waiting: string,
    // why G-rank levels are not offered in game yet ("" none)
    gate: string,
}

// Unlocks page: a list (with a group heading on the first row of each group), then the
// entries of the list picked. Cell key = map * 1024 + bit; sub = what unlocks it in game.
export struct UnlockRow { index: int, group: string, name: string, count: string, changed: bool }
// check: false for the shops' read-only lists (on = on sale now)
export struct UnlockCell { key: int, name: string, sub: string, on: bool, new: bool, changed: bool, enabled: bool, check: bool }
// A village pet: name, costume worn (index in costumes), adopted
export struct PetRow { index: int, place: string, name: string, costume: int, costumes: [string], adopted: bool, was: string }

// A Guild Card of the list or the inbox, a blocked user, or a hunter for hire: the name,
// then one or two lines of what the game shows about it
export struct CardRow { slot: int, name: string, tag: string, line1: string, line2: string, greeting: string }

// An option: its choices in a picker, or a number up to `max`; `head` starts a section
export struct OptionRow { id: string, head: string, name: string, choices: [string], value: int, number: bool, max: int, was: string }

// A chat phrase of the group shown: a shoutout, or an auto-shoutout with its trigger and
// whether it is on; `head` starts a section
export struct PhraseRow { auto: bool, index: int, head: string, label: string, text: string, on: bool, was: string }

export struct FieldRow { index: int, offset: string, size: string, owner: string, label: string, confidence: Confidence, changed: bool }

export struct StatCard { title: string, value: string, sub: string, progress: float, done: bool, bar: bool, page: string, tab: int }

// state: 0 can change something, 1 staged (in Review), 2 already in the save
export struct Goal { id: string, title: string, detail: string, count: string, confidence: Confidence, state: int, op: int }

export struct PreviewLine { label: string, old: string, new: string }

export struct Preview {
    id: string, title: string, summary: string, confidence: Confidence,
    lines: [PreviewLine], more: int, note: string, tech: string, empty: bool, action: string,
}

// Guild Card weapon usage of one weapon: quests per venue (Village, Hub, Arena).
export struct WeaponUseRow { index: int, name: string, counts: [int], was: [string], total: int, main: bool }

export struct CharacterInfo {
    name: string, hr: int, hr-points: int, funds: int, wycademy: int, playtime-h: int, playtime-m: int,
    village-star: int, hub-star: int,
    points-lr: [int], points-g: [int],
    was-name: string, was-hr: string, was-hr-points: string, was-funds: string, was-wycademy: string,
    was-playtime: string, was-village-star: string, was-hub-star: string, was-lr: [string], was-g: [string],
    weapon-use: [WeaponUseRow],
    // quests per hunting style (Guild … Valor)
    style-use: [int], was-style: [string],
    // the Courier's counts; the place a load starts in and the Room Service's Housekeeper,
    // as indices into their lists (-1 for a value the game does not store)
    quest-counter: int, courier-points: int, start-village: int, start-places: [string],
    housekeeper: int, housekeepers: [string],
    was-quest-counter: string, was-courier-points: string, was-start-village: string, was-housekeeper: string,
}

// The own Guild Card's title (word, linking word, word), scene and pose: IDs, the title
// as shown, the file's value when staged and why the game cannot produce a value.
export struct CardInfo {
    word1: int, link: int, word2: int, scene: int, pose: int, title: string, greeting: string,
    was-title: string, was-scene: string, was-pose: string, was-greeting: string,
    warn-title: string, warn-scene: string, warn-pose: string,
}

// A colour of the hunter's creation choices, as a swatch and #RRGGBB.
export struct ColourRow { key: string, label: string, colour: color, hex: string }

// The hunter's creation choices (indices into the "Type n" lists; voice 1-based) and
// colours, with "was" and warnings for the appearance and the body type.
export struct AppearanceInfo {
    gender: int, face: int, hair: int, features: int, voice: int, clothing: int, colours: [ColourRow],
    was-appearance: string, was-gender: string, warn-appearance: string, warn-gender: string,
}

// Hunting style and Hunter Arts, as a My Set keeps them or as the hunter has them on:
// per art slot the pick (index into `choices`, 0 = none) and SP; `choices` are the arts
// the weapon takes, locked ones marked. Style 6 = an unused set.
export struct ArtsInfo {
    style: int, slots: int, picks: [int], sp: [bool], choices: [string], weapon: string, was: string, warning: string,
}

// One armor part's pigment: its colour, or the armor's own one.
export struct PigmentRow { part: string, colour: color, hex: string, own: bool }

// A row of the set list; runs of unused sets collapse into one (index -1).
export struct SetRow { index: int, first: int, last: int, name: string, sub: string, used: bool, changed: bool }

// A piece of a set: the box entry picked (index into `choices`, 0 = none).
export struct SetPiece { part: string, pick: int, choices: [string] }

// The set being edited (My Set, or Palico set with `palico`).
export struct SetDetail {
    index: int, used: bool, palico: bool, name: string, pieces: [SetPiece], pigment: [PigmentRow], arts: ArtsInfo,
    was-name: string, was-gear: string, was-pigment: string, warn-gear: string,
}

// The card's best time on one Arena quest of the counter's table: the time split for its
// fields, the equipment set (the choices name their weapon or Prowler support), the
// grade it earns and the quest's grade times.
export struct ArenaRow {
    index: int, quest: string, has: bool, minutes: int, seconds: int, hundredths: int,
    set: int, sets: [string], grade: string, grades: string, was: string, warning: string,
}

export global Api {
    // shell
    in-out property <string> page: "open";
    in property <bool> loaded;
    in property <string> file-path;
    in property <string> path-label;    // "Ryujinx"
    in property <string> path-tail;     // "…/save/0000000000000001/0/system"
    in property <string> build-info;
    in property <[SlotInfo]> slots;
    in-out property <int> slot;
    in property <[ChangeRow]> changes;
    in property <int> change-count;
    in property <int> value-count;      // values not written yet, every character
    in property <string> review-summary;
    // values staged per page, in nav order (overview … advanced)
    in property <[int]> page-counts;
    in-out property <bool> review-open;
    in property <string> toast;
    in property <string> toast-sub;
    in property <string> toast-action;  // button label, "" for none
    in property <bool> toast-error;
    in property <string> warning;
    in property <bool> assets-ok;
    callback toast-act();
    callback open-dialog();
    callback open-path(string);
    callback open-folder();
    callback copy-path();
    in property <[DetectedSave]> detected;
    callback select-slot(int);
    callback undo(int);
    callback undo-all();
    // the field staged under this key back to its value in the file
    callback undo-value(string);
    callback undo-last();               // Ctrl+Z: the latest change
    callback page-shown();              // Api.page changed: build the page's models
    in-out property <int> search-seq;   // Ctrl+F: the page's search field takes focus
    callback step-page(int);            // Ctrl+Up/Down: the previous/next page of the sidebar
    callback tab-shown();               // the page's TabBar switched tabs (nav.rs history)
    // Ctrl+Left/Right: the page's TabBar selects the tab tab-step away (bump tab-seq)
    in-out property <int> tab-step;
    in-out property <int> tab-seq;
    // a plain arrow (dx, dy) inside the page's area (x, y, width, height): the focus moves to
    // the nearest entry that way (arrows.rs); false leaves the key to the focused control
    callback arrow(int, int, length, length, length, length) -> bool;
    // open the page of a Review entry at its field
    callback goto(string);
    in property <string> highlight;     // key of the field to flash
    in property <int> jump-row: -1;     // list row to scroll to
    in property <int> jump-seq;         // bumped on every jump

    // write flow
    in-out property <bool> write-open;
    in property <string> write-title;
    in property <string> write-sub;
    in property <[WriteRow]> write-rows;
    in property <int> derived-count;
    // staged values the game cannot produce, and why that matters
    in property <int> warn-count;
    in property <string> warn-why;
    in property <bool> emulator-running;
    in property <string> emulator-name;
    in property <string> snapshot-dir;
    in property <[string]> write-targets;
    callback check-emulator();
    callback write(bool /* snapshot */) -> bool;
    callback open-snapshots();
    // snapshots
    in-out property <bool> snapshots-open;
    in property <[SnapRow]> snapshots;
    // snapshot waiting for the Restore confirmation ("" none) and its date
    in-out property <string> restore-ask;
    in-out property <string> restore-when;
    callback list-snapshots();
    callback restore(string /* dir */);
    // characters: whole slots copied, swapped, deleted, exported, imported
    in-out property <bool> characters-open;
    callback slot-copy(int /* from */, int /* to */);
    callback slot-swap(int, int);
    callback slot-delete(int);
    callback slot-export(int);
    callback slot-import(int);
    // quitting with staged changes
    in-out property <bool> quit-open;
    callback quit();
    // opening a save with staged changes: the file waiting for the confirmation ("" none)
    in-out property <string> open-ask;
    callback open-confirmed();

    // overview
    in property <[StatCard]> stats;
    in property <[Goal]> goals;
    in property <[Goal]> goals-done;
    // preview of a goal or a page-level bulk action
    in property <Preview> preview;
    callback open-preview(string) -> bool;
    callback apply-preview(string);

    // character
    in property <CharacterInfo> character;
    callback set-character(string /* field */, int);
    callback set-name(string);
    // Guild Card: the choices by ID (locked ones say so)
    in property <CardInfo> card;
    in property <[string]> gc-words;
    in property <[string]> gc-links;
    in property <[string]> gc-scenes;
    in property <[string]> gc-poses;
    callback set-card(string /* word1 link word2 scene pose */, int);
    callback set-greeting(string);
    in property <AppearanceInfo> appearance;
    in property <[string]> look-faces;
    in property <[string]> look-hairstyles;
    in property <[string]> look-voices;
    in property <[string]> look-features;
    in property <[string]> look-clothing;
    callback set-look(string /* gender face hair features voice clothing */, int);
    callback set-look-colour(string /* skin clothing */, string /* #RRGGBB */);
    in property <[ArenaRow]> arena;
    callback set-arena(int /* quest */, int /* set */, int /* time, 1/100 s */);
    callback clear-arena(int);

    // items
    in property <[ItemSlot]> item-slots;
    in-out property <int> item-store: 0;   // 0 box, 1 pouch, 2 loadouts
    in-out property <string> item-filter;
    in property <int> item-used;
    in property <int> item-total;
    in property <[PickItem]> pick-items;
    callback filter-items(string);
    callback search-picker(string);
    callback set-item(int /* slot */, int /* id */, int /* count */);
    callback item-bulk(string);
    // first empty slot of the box or pouch shown (-1: full)
    in property <int> item-free;
    in property <[LoadoutRow]> loadouts;
    // the loadout being edited (-1 none): its name, 32 pouch positions, staged value
    in property <int> loadout-sel: -1;
    in property <string> loadout-name;
    in property <[ItemSlot]> loadout-slots;
    in property <string> loadout-was;
    callback select-loadout(int);
    callback set-loadout-item(int /* position */, int /* id */, int /* count */);
    callback set-loadout-name(string);

    // equipment
    in property <[EquipRow]> equip-rows;
    in-out property <int> equip-owner: 0;  // 0 hunter box, 1 Palico box, 2 My Sets, 3 Palico sets
    // My Sets and Palico sets (equip-owner 2, 3)
    in property <[SetRow]> set-rows;
    in property <SetDetail> set-detail;
    callback select-set(int);
    callback set-set-name(string);
    callback set-set-piece(int /* part */, int /* pick */);
    callback set-from-current();
    callback clear-set();
    // style, arts and pigment of what the hunter has on (where -1) or of the selected My
    // Set (where 0): field "style" (value), "art" (slot, pick) or "sp" (slot, 0/1)
    in property <ArtsInfo> char-arts;
    in property <[PigmentRow]> char-pigment;
    in property <string> was-pigment;
    callback set-arts(int /* where */, string /* field */, int /* slot */, int /* value */);
    callback set-pigment(int /* where */, int /* part */, string /* hex */);
    callback own-pigment(int /* where */, int /* part */);
    in-out property <string> equip-filter: "all";
    in-out property <string> equip-search;
    in property <string> equip-summary;
    in property <EquipDetail> equip-detail;
    in property <[string]> skill-names;
    in-out property <bool> equip-advanced;  // raw bytes expanded (kept for the session)
    callback filter-equip(string);
    callback search-equip-list(string);
    callback select-equip(int);
    callback set-equip(string /* field */, int);
    callback show-in-map(string);
    // adding: categories are weapon classes, armor parts and talismans
    in property <[string]> equip-categories;
    in-out property <int> equip-category: 0;
    in property <[PickItem]> pick-equip;
    in property <int> equip-free;          // first free box slot, -1 when full
    callback search-equip(string);         // fills pick-equip for equip-category
    // "" pieces of equip-category, "transmog" the looks the selected armor can take
    in-out property <string> pick-mode;
    // decorations that fit the selected piece's free slots
    in property <[PickItem]> pick-decos;
    callback search-decos(string);
    callback put-equip(int /* slot, -1 = first free */, int /* id, 0 = empty the slot */);

    // screenshots (MHGU_SNAPSHOT): the popup to open ("equip-picker", "item-picker",
    // "goal", "about", "settings", …; the owner clears it)
    in-out property <string> snapshot-popup;
    // "light" / "dark" (Settings, or a screenshot step), "system" to follow the desktop
    in property <string> force-scheme;
    // colours from matugen (theme.rs), in place of the built-in ones while on
    in property <bool> colors-on;
    in property <Scheme> colors-dark;
    in property <Scheme> colors-light;
    callback save-matugen-template();

    // settings
    in-out property <bool> settings-open;
    in property <SettingsInfo> settings;
    in property <[DetectedSave]> recent;
    callback set-setting(string /* key */, int);
    callback pick-snapshot-dir();
    callback add-save-folder();
    callback remove-save-folder(int);
    callback add-emulator(string);
    callback remove-emulator(int);
    callback clear-recent();
    // updates
    in-out property <bool> update-open;
    in property <UpdateInfo> update;
    callback check-update();
    callback install-update();
    callback cancel-update();
    callback restart-update();
    callback update-page();       // the release page in the browser

    // palicoes
    in property <[PalicoRow]> palicoes;
    in property <PalicoDetail> palico;
    in property <[string]> biases;
    // target 1-5 by name (index + 1)
    in property <[string]> palico-targets;
    in property <string> palico-summary;
    in-out property <string> palico-search;
    callback filter-palicoes(string);
    callback select-palico(int);
    callback set-palico(string, int);
    callback set-palico-text(string, string);
    // support move and skill names by ID, for the list slots' pickers
    in property <[string]> palico-move-names;
    in property <[string]> palico-skill-names;
    // "moves" / "skills", slot, ID, equipped: a new ID replaces the slot's entry, the same
    // ID equips or unequips it
    callback set-palico-entry(string, int, int, bool);
    // look key, choice or palette index
    callback set-palico-look(string, int);
    // the selected Palico, with the equipment it wears: into another character's
    // Palicoes, or a file; a file's Palico into this character's
    in property <[SlotInfo]> other-characters;  // the other slots in use
    callback palico-copy(int /* slot */);
    callback palico-export();
    callback palico-import();

    // quests
    in property <[string]> quest-tabs;
    in-out property <int> quest-tab;
    in property <bool> quest-arena;  // the Arena records tab (after the categories) is shown
    in property <[QuestRow]> quests;
    in property <string> quest-summary;
    in-out property <string> quest-search;
    in-out property <bool> quest-missing;
    callback select-quest-tab(int);
    callback filter-quests();
    callback set-quest(int /* index */, string /* bit */, bool);
    callback quest-bulk(string /* group */);

    // requests
    in property <[RequestRow]> requests;
    in-out property <string> request-filter: "open";
    in-out property <string> request-search;
    in property <string> request-summary;
    callback filter-requests();
    callback set-request(int, string, bool);

    // collections
    in-out property <int> collection-tab;
    in property <[string]> collection-tabs;
    in property <[CheckRow]> checks;
    in property <[ArtRow]> arts;
    in property <string> checks-summary;
    in-out property <string> check-search;
    in-out property <bool> check-missing;
    callback select-collection(int);
    callback filter-checks();
    callback set-check(int, bool);
    in property <[DeviantRow]> deviants;
    callback set-deviant(int, string, int);

    // unlocks
    in property <[UnlockRow]> unlock-rows;
    in-out property <int> unlock-sel;
    in property <[UnlockCell]> unlock-cells;
    in property <string> unlock-title;
    in property <string> unlock-note;
    in property <string> unlock-summary;
    // entries can be edited (not the shops' lists); the pets' form instead of entries
    in property <bool> unlock-editable;
    in property <bool> unlock-pets;
    in property <[PetRow]> pets;
    in property <[int]> moofahs;
    in property <string> was-moofahs;
    // Moofah Fleeceballs the Bherna Moofahs gave (award 49 at 10)
    in property <int> moofah-gifts;
    in property <string> was-moofah-gifts;
    in-out property <string> unlock-search;
    in-out property <bool> unlock-missing;
    callback select-unlock(int);
    callback filter-unlocks();
    callback set-unlock(int, bool);
    callback set-pet(int, string /* name, costume, adopted */, string);
    callback set-moofah(int, int);
    callback set-moofah-gifts(int);

    // Guild Cards: 0 the list, 1 the inbox, 2 Hunters for Hire, 3 the blocked-user list
    in-out property <int> card-tab;
    in property <[string]> card-tabs;
    in property <[CardRow]> card-rows;
    in property <string> cards-summary;
    // the tab's list in the file, when an edit changed it
    in property <string> was-cards;
    in property <string> was-cards-key;
    callback select-card-tab(int);
    // the row's slot in the tab's list
    callback remove-card(int);
    callback move-card(int);

    // Options: 0 the character's options, 1 chat, 2 the title menu's (shared)
    in-out property <int> option-tab;
    in property <[string]> option-tabs;
    in property <[OptionRow]> option-rows;
    in property <string> options-summary;
    callback select-option-tab(int);
    callback set-option(string, int);
    // the chat group shown (0-2) and the one in use
    in-out property <int> chat-shown;
    in property <[string]> chat-groups;
    in property <int> chat-group;
    in property <string> was-chat-group;
    in property <string> was-auto-on;
    in property <[PhraseRow]> phrases;
    callback show-chat-group(int);
    callback set-chat-group(int);
    callback set-phrase(bool, int, string);
    callback set-auto-on(int, bool);

    // monsters
    in property <[MonsterRow]> monsters;
    in-out property <string> monster-filter;
    in-out property <bool> monster-large-only;
    in-out property <bool> monster-missing;
    in property <string> monster-summary;
    callback filter-monsters();
    callback set-monster(int /* index */, string /* field */, int);

    // database (read-only)
    in-out property <int> db-tab;
    in property <[DbRow]> db-monsters;
    in property <DbMonster> db-monster;
    in property <[DbRow]> db-quests;
    in property <int> db-row;  // row of the entry shown in its tab's list
    in property <DbQuest> db-quest;
    in property <[DbRow]> db-items;
    in property <DbItem> db-item;
    in property <[DbRow]> db-skills;
    in property <DbSkill> db-skill;
    in property <[string]> db-equip-kinds;  // weapon classes, armor parts, decorations
    in property <int> db-equip-kind;
    in property <[DbRow]> db-equips;
    in property <DbEquip> db-equip;
    callback select-db-kind(int);
    in-out property <string> db-search;
    in-out property <bool> db-missing;
    callback filter-db();
    callback select-db(int);  // an entry of the tab shown
    callback select-db-rank(string);
    callback open-db(string /* kind */, int);         // another page's entry in the Database
    callback show-in-editor(string /* kind */, int);  // a Database entry on its own page

    // advanced
    in property <[FieldRow]> fields;
    in property <string> hex;
    in property <string> field-info;
    in-out property <string> field-filter;
    in-out property <int> field-sel: -1;
    callback filter-fields(string);
    callback select-field(int);
}

// The window size, for popups that cover it (modal dialogs opened from a page).
export global Win {
    in-out property <length> width;
    in-out property <length> height;
}

// Numbers as the UI shows them.
export global Fmt {
    // the language's thousands separator (i18n.rs)
    in property <string> sep: ",";
    // 1234567 -> "1,234,567"
    public pure function num(v: int) -> string {
        return v < 0 ? "-" + Fmt.pos(-v) : Fmt.pos(v);
    }
    public pure function pos(v: int) -> string {
        return v >= 1000000 ? floor(v / 1000000) + sep + Fmt.pad(mod(floor(v / 1000), 1000)) + sep + Fmt.pad(mod(v, 1000))
            : v >= 1000 ? floor(v / 1000) + sep + Fmt.pad(mod(v, 1000))
            : "" + v;
    }
    public pure function pad(n: int) -> string {
        return n < 10 ? "00" + n : n < 100 ? "0" + n : "" + n;
    }
}

// Design tokens. Type scale and spacing from the UI review (C5, C6); in light the page
// sits below white cards and every divider is one 8 % hairline (L2–L4).
export global Tok {
    // from the style's own background, so "system" (scheme unknown) follows the desktop
    out property <bool> dark: Palette.background.to-hsv().value < 0.5;
    // text boxes (input…) as Fluent's
    property <Scheme> built-in-dark: {
        page: #1c1c1c, side: #262626, card: #2c2c2c, raised: #2f2f2f,
        muted: #ffffffb0, faint: #ffffff5e,
        line: #ffffff17, track: #ffffff1f, hover: #ffffff0d,
        accent-text: #60cdff, bad: #ff99a4,
        input: #ffffff0f, input-active: #1e1e1e, input-border: #ffffff14, input-edge: #ffffff8a,
    };
    property <Scheme> built-in-light: {
        page: #f3f3f3, side: #ebebeb, card: #fdfdfd, raised: #ffffff,
        muted: #0000009c, faint: #0000005e,
        line: #00000014, track: #0000001a, hover: #0000000a,
        accent-text: #005fb8, bad: #c42b1c,
        input: #ffffffb3, input-active: #ffffff, input-border: #0000000f, input-edge: #00000073,
    };
    property <Scheme> s: dark ? (Api.colors-on ? Api.colors-dark : built-in-dark) : (Api.colors-on ? Api.colors-light : built-in-light);
    out property <color> page: s.page;
    out property <color> side: s.side;
    out property <color> card: s.card;
    out property <color> raised: s.raised;
    out property <color> line: s.line;
    out property <color> track: s.track;
    out property <color> hover: s.hover;
    out property <color> muted: s.muted;
    out property <color> faint: s.faint;
    // matugen's accent reaches here through the widgets' (theme::set_accent)
    out property <color> accent: Palette.accent-background;
    out property <color> accent-soft: Palette.accent-background.transparentize(0.82);
    out property <color> accent-text: s.accent-text;
    out property <color> ok: dark ? #6ccb5f : #0f7b0f;
    out property <color> warn: dark ? #fce100 : #9d5d00;
    out property <color> bad: s.bad;
    // game icons were drawn for a dark UI: they always sit on this tile (L1)
    out property <color> icon-tile: #2b2b2b;
    out property <color> input: s.input;
    out property <color> input-active: s.input-active;
    out property <color> input-border: s.input-border;
    out property <color> input-edge: s.input-edge;
    out property <length> title: 24px;
    out property <length> stat: 20px;
    out property <length> section: 16px;
    out property <length> body: 14px;
    out property <length> small: 12px;
    out property <length> margin: 24px;
    out property <length> pad: 16px;
    out property <length> gap: 12px;
    out property <length> tight: 8px;
    out property <length> radius: 6px;
    // rows are capped so labels stay near their values (09)
    out property <length> row-max: 1600px;
    // a list beside a detail pane: 320 px, a little more on a wide page, never past 38 %
    public pure function list-w(w: length) -> length {
        return min(w * 0.38, clamp(w * 0.22, 320px, 400px));
    }
}

// Where two cards go: side by side when both fit at their minimum width, else one under
// the other. `p` eases from one placement to the other, so a switch slides instead of
// jumping; the width itself is never animated, so a resize follows the window's edge.
export component Pair {
    in property <length> w;
    in property <length> gap: Tok.gap;
    // between them when one is under the other
    in property <length> v-gap: gap;
    in property <length> a-min;
    in property <length> b-min;
    // the part of the spare width the second card takes beside the first
    in property <float> b-share;
    // each card's height at the width it is given
    in property <length> a-h;
    in property <length> b-h;
    out property <bool> side: w >= a-min + b-min + gap;
    out property <float> p: side ? 1 : 0;
    animate p { duration: 180ms; easing: ease-in-out; }
    property <length> b-beside: b-min + max(0px, w - a-min - b-min - gap) * b-share;
    property <length> row-h: max(a-h, b-h);
    out property <length> a-w: w - p * (b-beside + gap);
    out property <length> b-x: p * (w - b-beside);
    out property <length> b-y: (1 - p) * (a-h + v-gap);
    out property <length> b-w: w - p * (w - b-beside);
    // beside each other both are as tall as the taller one
    out property <length> a-height: a-h + p * (row-h - a-h);
    out property <length> b-height: b-h + p * (row-h - b-h);
    out property <length> h: (1 - p) * (a-h + v-gap + b-h) + p * row-h;
    out property <length> min-w: max(a-min, b-min);
}

// Opacity for a grid whose column count is `key`: when it changes, the grid's cells are
// rebuilt in their new places (too many to slide), so the grid fades back in instead.
export component Settle {
    in property <int> key;
    out property <float> o: 1;
    property <bool> low;
    changed key => { root.low = true; }
    Timer {
        interval: 30ms;
        running: root.low;
        triggered => { root.low = false; }
    }
    states [
        low when root.low: {
            o: 0.3;
            out {
                animate o { duration: 180ms; easing: ease-out; }
            }
        }
    ]
}

// --- small widgets -------------------------------------------------------------------

// A ComboBox that always shows `value`. The std ComboBox sets its own current-index when
// a choice is picked and when its model is set again, which cuts a `current-index: <data>`
// binding: it then kept showing an old choice (a Palico's forte after picking another
// Palico). A pick goes to `picked`; what the data says afterwards is shown.
export component Picker inherits ComboBox {
    in property <int> value;
    callback picked(int);
    current-index: root.value;
    // a new model of another length can clamp the index too
    property <string> sync: root.value + ":" + root.model.length;
    changed sync => { self.current-index = root.value; }
    selected => {
        root.picked(self.current-index);
        self.current-index = root.value;
    }
}

export component Hairline inherits Rectangle {
    height: 1px;
    background: Tok.line;
}

export component Dot inherits Rectangle {
    in property <Confidence> level;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: level == Confidence.confirmed ? Tok.ok : level == Confidence.derived ? Tok.warn : Tok.faint;
}

export component Muted inherits Text {
    color: Tok.muted;
    font-size: Tok.small;
    wrap: word-wrap;
}

export component SectionTitle inherits Text {
    font-size: Tok.section;
    font-weight: 600;
}

// Text button ("Undo", "Show paths", "Back to Review").
export component TextLink inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Tok.small;
    in property <int> font-weight: 600;
    in property <color> tint: Tok.accent-text;
    callback clicked;
    width: t.preferred-width;
    height: t.preferred-height;
    accessible-role: button;
    accessible-label: text;
    t := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: ta.has-hover ? root.tint.brighter(0.2) : root.tint;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ⓘ that opens a short explanation.
export component InfoTip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Tok.muted;
    in property <length> pop-width: 300px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? Tok.accent-text : tint;
    accessible-role: button;
    accessible-label: @tr("More information");
    accessible-description: text;
    Text {
        text: "i";
        font-size: 11px;
        font-weight: 700;
        color: ta.has-hover ? Tok.accent-text : root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.pop-width;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tok.raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Tok.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0005;
            VerticalLayout {
                padding: 12px;
                Text { text: root.text; wrap: word-wrap; font-size: Tok.small; color: Palette.foreground; }
            }
        }
    }
}

// Confidence as a dot, a text label and an ⓘ with the definition (06). Pages show it
// only on the exceptions; the page header states the rule once.
export component ConfidenceTag inherits HorizontalLayout {
    in property <Confidence> level;
    in property <bool> info: true;
    spacing: 5px;
    alignment: start;
    horizontal-stretch: 0;
    Dot { level: root.level; y: (parent.height - self.height) / 2; }
    Text {
        text: level == Confidence.confirmed ? @tr("Confirmed") : level == Confidence.derived ? @tr("Derived") : @tr("Unresolved");
        font-size: Tok.small;
        color: level == Confidence.derived ? Tok.warn : Tok.muted;
        vertical-alignment: center;
    }
    if info: InfoTip {
        y: (parent.height - self.height) / 2;
        tint: level == Confidence.derived ? Tok.warn : Tok.muted;
        text: level == Confidence.confirmed ? @tr("Confirmed: checked in game.")
            : level == Confidence.derived ? @tr("Derived: worked out from the game's code, not yet checked in game. A snapshot before writing lets you go back.")
            : @tr("Unresolved: what this value means in game is not known yet, so it is shown but not edited.");
    }
}

export component Card inherits Rectangle {
    background: Tok.card;
    border-radius: Tok.radius;
    border-width: 1px;
    border-color: Tok.line;
}

// Game asset on its dark tile; nothing when the pack has no icon (no placeholder boxes).
export component Asset inherits Rectangle {
    in property <image> source;
    in property <bool> available;
    in property <color> tint: transparent;
    border-radius: 4px;
    clip: true;
    background: available ? Tok.icon-tile : transparent;
    if available: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-rendering: smooth;
        colorize: root.tint;
    }
}

// Keyboard for a custom control: Tab reaches it, Space or Enter activates it. Fills
// its parent; put it before the control's TouchArea.
export component KeyActivate inherits FocusScope {
    callback activated();
    // focused by a click (click-focus): no focus ring, as in other toolkits
    out property <bool> by-mouse;
    // a click keeps the keyboard here, so the arrows go on from it
    public function click-focus() {
        self.by-mouse = true;
        self.focus();
    }
    focus-lost(reason) => { self.by-mouse = false; }
    key-pressed(e) => {
        if e.text == " " || e.text == Key.Return {
            root.activated();
            return accept;
        }
        return reject;
    }
}

// The outline of a custom control that has the keyboard focus.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    border-width: root.shown ? 2px : 0px;
    border-color: Tok.accent;
}

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    // Up/Down (-1/1), Home/End (-100/100) while it has the focus (with or without Ctrl):
    // a click gives it the focus, so the arrows go on from the page picked with the mouse
    callback arrow(int);
    // takes the focus when focus-seq changes with focus-me set
    in property <int> focus-seq;
    in property <bool> focus-me;
    changed focus-seq => {
        if root.focus-me {
            fk.focus();
        }
    }
    // focused by a click: no focus ring, as in other toolkits
    property <bool> by-mouse;
    height: 34px;
    border-radius: 5px;
    background: active ? Tok.accent-soft : ta.has-hover && enabled ? Tok.hover : transparent;
    accessible-role: button;
    accessible-label: count > 0 ? @tr("{}, {n} value not written" | "{}, {n} values not written" % count, text) : text;
    Rectangle {
        x: 0;
        width: 3px;
        height: active ? 16px : 0px;
        border-radius: 2px;
        background: Tok.accent;
        animate height { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: enabled ? Palette.foreground : Tok.faint;
            font-weight: active ? 600 : 400;
        }
        if count > 0: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 20px;
            width: max(20px, c.preferred-width + 12px);
            border-radius: 10px;
            background: Tok.accent-soft;
            c := Text { text: root.count; font-size: Tok.small; font-weight: 600; color: Tok.accent-text; }
        }
    }
    accessible-action-default => { root.clicked(); }
    fk := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.clicked();
                return accept;
            }
            if e.modifiers.alt || e.modifiers.shift {
                return reject;
            }
            if e.text == Key.UpArrow { root.arrow(-1); return accept; }
            if e.text == Key.DownArrow { root.arrow(1); return accept; }
            if e.text == Key.Home { root.arrow(-100); return accept; }
            if e.text == Key.End { root.arrow(100); return accept; }
            return reject;
        }
        focus-lost(reason) => { root.by-mouse = false; }
    }
    FocusRing { shown: fk.has-focus && !root.by-mouse; border-radius: 5px; }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.by-mouse = true;
            fk.focus();
            root.clicked();
        }
    }
}

// Filter chip (chips are only for filters, next to the search field).
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 28px;
    min-width: t.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: active ? Tok.accent : Tok.line;
    background: active ? Tok.accent-soft : ta.has-hover ? Tok.hover : transparent;
    accessible-role: checkbox;
    accessible-checked: active;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    t := Text {
        text: (root.active ? "✓ " : "") + root.text;
        font-size: Tok.small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    fk := KeyActivate { activated => { root.clicked(); } }
    FocusRing { shown: fk.has-focus; border-radius: 14px; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// The tabs of the pages that have them, picked the same way from a TabBar and from the
// mouse's Back/Forward (nav.rs).
export global Tabs {
    // the tab `page` shows, -1 when it has none
    public pure function current(page: string) -> int {
        return page == "items" ? Api.item-store
            : page == "equipment" ? Api.equip-owner
            : page == "quests" ? Api.quest-tab
            : page == "collections" ? Api.collection-tab
            : page == "database" ? Api.db-tab
            : page == "cards" ? Api.card-tab
            : page == "options" ? Api.option-tab
            : -1;
    }
    public function select(page: string, i: int) {
        if page == "items" {
            Api.item-store = i;
            Api.filter-items(Api.item-filter);
        } else if page == "equipment" {
            Api.equip-owner = i;
            if i == 1 && Api.equip-filter == "talisman" {
                Api.equip-filter = "all";
            }
            Api.filter-equip(Api.equip-filter);
        } else if page == "quests" {
            Api.select-quest-tab(i);
        } else if page == "collections" {
            Api.select-collection(i);
        } else if page == "database" {
            // each tab starts unfiltered
            Api.db-tab = i;
            Api.db-search = "";
            Api.db-missing = false;
            Api.filter-db();
        } else if page == "cards" {
            Api.select-card-tab(i);
        } else if page == "options" {
            Api.select-option-tab(i);
        }
    }
}

// Sub-pages as a tab bar under the title (C3).
export component TabBar inherits Rectangle {
    in property <[string]> tabs;
    in property <int> current;
    callback select(int);
    height: 40px;
    // a tab shown, however it was picked: the mouse's Back/Forward come back to it
    changed current => { Api.tab-shown(); }
    // Ctrl+Left/Right (a page shows one TabBar at a time)
    property <int> seq: Api.tab-seq;
    changed seq => {
        let i = clamp(root.current + Api.tab-step, 0, root.tabs.length - 1);
        if i != root.current {
            root.select(i);
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: 4px;
        for t[i] in root.tabs: Rectangle {
            width: label.preferred-width + 24px;
            accessible-role: tab;
            accessible-label: t;
            accessible-item-selected: i == root.current;
            background: ta.has-hover && i != root.current ? Tok.hover : transparent;
            border-radius: 4px;
            label := Text {
                text: t;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Palette.foreground : Tok.muted;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - 3px;
                x: 12px;
                width: parent.width - 24px;
                height: 3px;
                border-radius: 1.5px;
                background: i == root.current ? Tok.accent : transparent;
            }
            accessible-action-default => { root.select(i); }
            fk := KeyActivate { activated => { root.select(i); } }
            FocusRing { shown: fk.has-focus; border-radius: 4px; }
            ta := TouchArea { clicked => { root.select(i); } }
        }
    }
    Hairline { y: parent.height - 1px; width: parent.width; }
}

// Title (same as the nav label), one subtitle line, page actions at the right (C1).
export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    // values staged on this page ("· 5 values changed on this page")
    in property <int> staged;
    // page-wide confidence when it is not "Confirmed in game except where marked"
    in property <bool> derived;
    spacing: 2px;
    HorizontalLayout {
        height: 40px;
        spacing: Tok.tight;
        Text { text: root.title; font-size: Tok.title; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        // page actions at the standard button height (C2)
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: Tok.tight;
            horizontal-stretch: 0;
            @children
        }
    }
    HorizontalLayout {
        height: 20px;
        spacing: 6px;
        alignment: start;
        if root.derived: ConfidenceTag { level: Confidence.derived; }
        Text {
            text: root.subtitle;
            color: Tok.muted;
            font-size: Tok.small;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.staged > 0: Text {
            text: "· " + @tr("{n} value changed on this page" | "{n} values changed on this page" % root.staged);
            color: Tok.accent-text;
            font-size: Tok.small;
            vertical-alignment: center;
        }
    }
}

// Column header text of a table.
export component ColHead inherits Text {
    color: Tok.muted;
    font-size: Tok.small;
    vertical-alignment: center;
    overflow: elide;
}

// 3 px accent bar beside a staged control or row (B1).
export component StagedBar inherits Rectangle {
    width: 3px;
    border-radius: 1.5px;
    background: Tok.accent;
}

// One list row (C4, 09.1): two densities, hover fill so the eye keeps the row across
// its columns, the staged bar, a hairline below. Controls placed in it get their own
// clicks; a click elsewhere on the row is `clicked`.
export component ListRow inherits Rectangle {
    in property <bool> two-line: true;
    in property <bool> staged;
    in property <bool> selected;
    in property <bool> flash;
    // the arrows that bring the keyboard here pick the row, as a click does (arrows.rs)
    in property <bool> select-on-focus: true;
    callback clicked;
    height: root.two-line ? 52px : 40px;
    background: root.flash || root.selected ? Tok.accent-soft : ta.has-hover ? Tok.hover : transparent;
    accessible-role: list-item;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    fk := KeyActivate {
        activated => { root.clicked(); }
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation && root.select-on-focus && !root.selected {
                root.clicked();
            }
        }
    }
    FocusRing { shown: fk.has-focus && !fk.by-mouse; }
    ta := TouchArea {
        clicked => {
            fk.click-focus();
            root.clicked();
        }
    }
    if root.staged: StagedBar { x: 2px; y: 8px; height: parent.height - 16px; }
    @children
    Hairline { y: parent.height - 1px; width: parent.width; }
}

// "was 830  Undo" under a staged control (B1).
export component WasLine inherits HorizontalLayout {
    in property <string> was;
    in property <string> key;
    spacing: 10px;
    alignment: start;
    height: 18px;
    Text {
        text: @tr("was {}", root.was);
        font-size: Tok.small;
        color: Tok.accent-text;
        vertical-alignment: center;
        overflow: elide;
    }
    TextLink {
        y: (parent.height - self.height) / 2;
        text: @tr("Undo");
        clicked => { Api.undo-value(root.key); }
    }
}

// Small arrow drawn as a path: "up", "down" or "right".
export component Chevron inherits Path {
    in property <string> dir: "down";
    width: dir == "right" ? 6px : 10px;
    height: dir == "right" ? 10px : 6px;
    stroke: Tok.muted;
    stroke-width: 1.4px;
    viewbox-width: dir == "right" ? 6 : 10;
    viewbox-height: dir == "right" ? 10 : 6;
    commands: dir == "up" ? "M 1 5.5 L 5 1.5 L 9 5.5" : dir == "right" ? "M 0.5 1 L 4.5 5 L 0.5 9" : "M 1 0.5 L 5 4.5 L 9 0.5";
}

// A number field with thousands separators: shows "9,999,999", edits as plain digits.
// Enter or leaving the field stages the value. The arrows step by one; unlike the
// standard SpinBox the mouse wheel never changes it, so lists scroll safely.
export component NumberBox inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 2147483647;
    in property <bool> spin: true;
    // flat: no frame until hovered or focused (table cells)
    in property <bool> flat;
    in property <string> suffix;
    in property <bool> enabled: true;
    in property <string> label;
    in property <TextHorizontalAlignment> align: left;
    in property <int> font-weight: 400;
    callback edited(int);
    out property <bool> has-focus: input.has-focus;
    min-width: 56px;
    height: 32px;
    border-radius: 4px;
    background: !root.enabled ? transparent : input.has-focus ? Tok.input-active : root.flat && !area.has-hover ? transparent : Tok.input;
    border-width: 1px;
    border-color: root.flat && !area.has-hover && !input.has-focus ? transparent : Tok.input-border;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    forward-focus: input;

    function show() {
        input.text = input.has-focus ? root.value : Fmt.num(root.value) + root.suffix;
    }
    // the digits typed, else the value (only called while they are plain digits)
    function typed() -> int {
        return input.text.is-float() ? clamp(round(input.text.to-float()), root.minimum, root.maximum) : root.value;
    }
    function set(v: int) {
        if v != root.value {
            root.edited(v);
        }
        root.show();
    }
    function commit() { root.set(root.typed()); }
    // from the digits being typed, not the value before them; unfocused, the text is
    // formatted ("1,234 %") and not read
    function step(d: int) {
        root.set(clamp((input.has-focus ? root.typed() : root.value) + d, root.minimum, root.maximum));
    }
    changed value => { root.show(); }

    // the box without editing it (after Escape): Enter or Space edits it again
    keep := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                input.focus();
                return accept;
            }
            return reject;
        }
    }
    FocusRing { shown: keep.has-focus; border-radius: 4px; }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: root.spin ? 2px : 10px;
        input := TextInput {
            text: Fmt.num(root.value) + root.suffix;
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            horizontal-alignment: root.align;
            horizontal-stretch: 1;
            color: root.enabled ? Palette.foreground : Tok.faint;
            font-size: Tok.body;
            font-weight: root.font-weight;
            accessible-role: none;
            changed has-focus => {
                if self.has-focus {
                    root.show();
                    self.select-all();
                } else {
                    root.commit();
                }
            }
            accepted => { root.commit(); }
            key-pressed(e) => {
                // with Ctrl the arrows switch pages
                if e.text == Key.UpArrow && !e.modifiers.control { root.step(1); return accept; }
                if e.text == Key.DownArrow && !e.modifiers.control { root.step(-1); return accept; }
                // stop editing, keeping the keyboard on the box: the arrows go on from it
                if e.text == Key.Escape { root.show(); keep.focus(); return accept; }
                reject
            }
        }
        if root.spin && root.enabled: HorizontalLayout {
            spacing: 0px;
            for d in [1, -1]: Rectangle {
                width: 26px;
                border-radius: 3px;
                background: t.pressed ? Tok.hover : transparent;
                Chevron { dir: d > 0 ? "up" : "down"; }
                t := TouchArea { clicked => { root.step(d); } }
            }
        }
    }
    // Fluent text box: darker bottom edge, accent when focused
    if !root.flat || area.has-hover || input.has-focus: Rectangle {
        x: 4px;
        y: parent.height - self.height;
        width: parent.width - 8px;
        height: input.has-focus ? 2px : 1px;
        border-radius: 1px;
        background: input.has-focus ? Tok.accent : Tok.input-edge;
    }
}

// A centred sentence plus the next action (C8).
export component EmptyState inherits VerticalLayout {
    in property <string> text;
    in property <string> action;
    callback act();
    alignment: center;
    spacing: 12px;
    padding: 24px;
    Text { text: root.text; color: Tok.muted; horizontal-alignment: center; wrap: word-wrap; }
    if root.action != "": HorizontalLayout {
        alignment: center;
        Button { text: root.action; clicked => { root.act(); } }
    }
}

// Rounded status label ("New · in Review").
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Tok.accent-text;
    height: 22px;
    width: t.preferred-width + 16px;
    border-radius: 11px;
    border-width: 1px;
    border-color: tint.transparentize(0.4);
    background: tint.transparentize(0.88);
    t := Text { text: root.text; font-size: Tok.small; color: root.tint; }
}

export component StatTile inherits Card {
    in property <StatCard> card;
    callback open();
    height: 108px;
    accessible-role: button;
    accessible-label: card.done ? @tr("{}: {}, complete", card.title, card.value) : card.title + ": " + card.value;
    Rectangle { border-radius: Tok.radius; background: ta.has-hover ? Tok.hover : transparent; }
    ta := TouchArea { clicked => { root.open(); } }
    VerticalLayout {
        padding: Tok.pad;
        spacing: 6px;
        Text { text: card.title; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        Text { text: card.value; font-size: Tok.stat; font-weight: 600; overflow: elide; }
        if card.bar: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Tok.track;
            Rectangle {
                x: 0;
                width: parent.width * clamp(card.progress, 0, 1);
                border-radius: 2px;
                background: Tok.accent;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            if card.done: Text { text: @tr("Complete"); color: Tok.ok; font-size: Tok.small; }
            if card.done && card.sub != "": Text { text: "·"; color: Tok.muted; font-size: Tok.small; }
            Text { text: card.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; horizontal-stretch: 1; }
        }
    }
}

// A modal dialog: scrim over everything, the card centred (C11: anything that confirms
// or commits). Fills its parent: the window, or a PopupWindow the size of the window.
// A page's search field: Ctrl+F puts the cursor in it.
export component SearchField inherits LineEdit {
    property <int> seq: Api.search-seq;
    changed seq => { self.focus(); }
}

export component Modal inherits Rectangle {
    in property <length> card-width: 520px;
    callback dismiss();  // click on the scrim, or Escape
    background: #00000080;
    // takes the keyboard while open: Escape closes it, keys of its fields bubble here
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            return reject;
        }
        TouchArea { clicked => { root.dismiss(); } }
        Rectangle {
            width: min(root.card-width, root.width - 32px);
            height: min(lay.preferred-height, root.height - 48px);
            x: (root.width - self.width) / 2;
            y: max(24px, (root.height - self.height) / 3);
            background: Tok.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tok.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: #0008;
            TouchArea { }
            lay := VerticalLayout {
                padding: 20px;
                spacing: Tok.gap;
                @children
            }
        }
    }
    init => { fs.focus(); }
}

// Shown or collapsed to nothing, for blocks with wrapped text in a layout that sizes a
// card, dialog or popup. Slint (1.18) gives an `if` block's wrapped text a stale one-line
// height in its parent's size, so the buttons below spill out of the card; a Reveal is
// always there and measured like any other child. `gap` is the space above it when shown:
// put it in a layout without spacing, or hidden it still costs that layout's spacing.
export component Reveal inherits Rectangle {
    in property <bool> shown;
    in property <length> gap;
    in property <length> spacing;
    visible: shown;
    height: shown ? lay.preferred-height : 0px;
    lay := VerticalLayout {
        padding-top: root.gap;
        spacing: root.spacing;
        @children
    }
}

// Before → after list of a goal or bulk action (03, mockup C).
export component PreviewBody inherits VerticalLayout {
    in property <Preview> p;
    in-out property <bool> tech-open;
    // no spacing: each block brings the 10px above it, so a collapsed Reveal costs nothing
    HorizontalLayout {
        spacing: Tok.tight;
        Text { text: p.title; font-size: Tok.section; font-weight: 600; horizontal-stretch: 1; wrap: word-wrap; }
        if p.confidence != Confidence.confirmed: ConfidenceTag { level: p.confidence; }
    }
    VerticalLayout {
        padding-top: 10px;
        Muted { text: p.summary; }
    }
    Reveal {
        shown: !p.empty;
        gap: 10px;
        Rectangle {
            border-radius: Tok.radius;
            border-width: 1px;
            border-color: Tok.line;
            height: min(lines.preferred-height, 300px);
            Flickable {
                content-height: lines.preferred-height;
                lines := VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    for l[i] in p.lines: Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            spacing: Tok.tight;
                            Text { text: l.label; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: l.old; color: Tok.muted; vertical-alignment: center; }
                            Text { text: "→"; color: Tok.muted; vertical-alignment: center; }
                            Text { text: l.new; font-weight: 600; vertical-alignment: center; }
                        }
                        if i > 0: Hairline { y: 0; width: parent.width; }
                    }
                    if p.more > 0: Text { height: 32px; text: @tr("and {} more", Fmt.num(p.more)); color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                    Reveal {
                        shown: p.note != "";
                        gap: 8px;
                        VerticalLayout {
                            padding-bottom: 10px;
                            Muted { text: p.note; }
                        }
                    }
                }
            }
        }
    }
    Reveal {
        shown: p.tech != "";
        gap: 10px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Chevron { dir: root.tech-open ? "down" : "right"; y: (parent.height - self.height) / 2; }
            TextLink {
                text: @tr("Technical details");
                tint: Tok.muted;
                font-weight: 400;
                clicked => { root.tech-open = !root.tech-open; }
            }
        }
        Reveal {
            shown: root.tech-open;
            gap: 6px;
            Muted { text: p.tech; font-family: "monospace"; }
        }
    }
}

// The preview popup of a goal or page-level bulk action, anchored to what opened it
// (C11). Place it at the page's top-left; open() takes page coordinates.
export component PreviewPopup inherits Rectangle {
    in property <length> page-width;
    property <length> px;
    property <length> py;
    property <bool> tech;
    property <length> pw: min(520px, root.page-width - 16px);
    width: 0px;
    height: 0px;
    // x: right edge of the anchor, y: its bottom
    public function open(id: string, right: length, bottom: length) {
        if Api.open-preview(id) {
            root.tech = false;
            root.px = clamp(right - root.pw, 8px, root.page-width - root.pw - 8px);
            root.py = bottom + 8px;
            pop.show();
        }
    }
    pop := PopupWindow {
        x: root.px;
        y: root.py;
        width: root.pw;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tok.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tok.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0007;
            VerticalLayout {
                padding: 18px;
                spacing: Tok.gap;
                PreviewBody { p: Api.preview; tech-open <=> root.tech; }
                HorizontalLayout {
                    alignment: end;
                    spacing: Tok.tight;
                    Button { text: Api.preview.empty ? @tr("Close") : @tr("Cancel"); clicked => { pop.close(); } }
                    if !Api.preview.empty: Button {
                        text: Api.preview.action;
                        primary: true;
                        clicked => {
                            Api.apply-preview(Api.preview.id);
                            pop.close();
                        }
                    }
                }
            }
        }
    }
}

// "More…" button with a menu of less common or destructive page actions (04.4).
export component MoreButton inherits Rectangle {
    in property <[string]> items;
    callback activated(int);
    width: b.preferred-width;
    height: 32px;
    b := Button { text: @tr("More…"); height: 32px; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: root.width - 220px;
        y: root.height + 4px;
        width: 220px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tok.raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Tok.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0006;
            VerticalLayout {
                padding: 4px;
                for it[i] in root.items: Rectangle {
                    height: 34px;
                    border-radius: 4px;
                    background: ta.has-hover ? Tok.hover : transparent;
                    accessible-role: button;
                    accessible-label: it;
                    accessible-action-default => {
                        menu.close();
                        root.activated(i);
                    }
                    Text { text: it; x: 12px; vertical-alignment: center; }
                    fk := KeyActivate {
                        activated => {
                            menu.close();
                            root.activated(i);
                        }
                    }
                    FocusRing { shown: fk.has-focus; border-radius: 4px; }
                    ta := TouchArea {
                        clicked => {
                            menu.close();
                            root.activated(i);
                        }
                    }
                }
            }
        }
    }
}
