import { ListView, LineEdit, ScrollView, Palette, CheckBox, Button } from "std-widgets.slint";
import {
    Api, Tabs, Tok, Card, Muted, SectionTitle, PageHeader, TabBar, NumberBox, StagedBar, WasLine, Hairline, EmptyState, ListRow, ConfidenceTag,
    Confidence, SearchField, PalicoEntry, LookRow, Pair, Picker, OptionRow, InfoRow,
} from "../common.slint";
import { Row as MailRow } from "cards.slint";

// A role, counter or scouting field: name, its choices or a number, "was … Undo" under it.
component FieldLine inherits VerticalLayout {
    in property <OptionRow> r;
    padding-left: 14px;
    padding-right: 12px;
    spacing: 2px;
    if r.head != "": SectionTitle { text: r.head; height: 34px; vertical-alignment: bottom; }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        height: 38px;
        Text { text: r.name; width: 240px; vertical-alignment: center; overflow: elide; }
        if !r.number: Picker { y: 3px; width: 220px; height: 32px; model: r.choices; value: r.value; picked(i) => { Api.set-palico-field(r.id, i); } }
        if r.number: NumberBox { y: 3px; width: 120px; height: 32px; minimum: 0; maximum: r.max; value: r.value; label: r.name; edited(v) => { Api.set-palico-field(r.id, v); } }
    }
    if r.was != "": HorizontalLayout {
        padding-left: 250px;
        WasLine { was: r.was; key: r.id; }
    }
}

// A read-only line under its section title.
component InfoLine inherits VerticalLayout {
    in property <InfoRow> r;
    padding-left: 14px;
    padding-right: 12px;
    spacing: 2px;
    if r.head != "": SectionTitle { text: r.head; height: 34px; vertical-alignment: bottom; }
    HorizontalLayout {
        spacing: 10px;
        min-height: 30px;
        Text { text: r.name; width: 240px; vertical-alignment: center; overflow: elide; color: Tok.muted; }
        Text { text: r.value; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
    }
}

// Label, control, "was … Undo" under it when staged.
component Row inherits Rectangle {
    in property <string> label;
    in property <string> was;
    in property <string> key;
    // under the control line, which is one line high: a long note wraps there instead
    in property <string> note;
    lay := HorizontalLayout {
        spacing: Tok.gap;
        Text { text: root.label; width: 130px; height: 32px; vertical-alignment: center; }
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                height: 32px;
                spacing: Tok.gap;
                @children
            }
            if root.note != "": Muted { text: root.note; }
            if root.was != "": WasLine { was: root.was; key: root.key; }
        }
    }
    if root.was != "": StagedBar { x: 132px; y: 0; height: 32px; }
}

// Text field staged when it loses focus or on Enter (05.3).
component TextRow inherits Row {
    in property <string> value;
    in property <string> field;
    in property <length> field-width: 320px;
    property <string> v: root.value;
    changed v => { ed.text = self.v; }
    ed := LineEdit {
        width: root.field-width;
        text: root.value;
        accessible-label: root.label;
        accepted(t) => { Api.set-palico-text(root.field, t); }
        changed has-focus => {
            if !self.has-focus && self.text != root.value {
                Api.set-palico-text(root.field, self.text);
            }
        }
    }
}

// A Palico's looks: a picker per choice, a row of swatches per colour (the game's palette;
// a colour outside it shows on its own at the end).
component LookList inherits VerticalLayout {
    in property <[LookRow]> rows;
    in property <string> was;
    in property <string> key;
    in property <string> warning;
    spacing: 6px;
    HorizontalLayout {
        spacing: Tok.gap;
        SectionTitle { text: @tr("Looks"); vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.was != "": WasLine { was: root.was; key: root.key; }
    if root.warning != "": Text { text: @tr("The game cannot make this: {}.", root.warning); color: Tok.bad; font-size: Tok.small; wrap: word-wrap; }
    for r in root.rows: HorizontalLayout {
        spacing: Tok.gap;
        height: 34px;
        Text { text: r.label; width: 130px; vertical-alignment: center; color: Tok.muted; }
        if !r.is-colour: Picker {
            width: 200px;
            model: r.choices;
            value: r.index;
            picked(i) => { Api.set-palico-look(r.key, i); }
        }
        if r.is-colour: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for c[k] in r.swatches: Rectangle {
                width: 26px;
                height: 26px;
                y: 4px;
                border-radius: 4px;
                background: c;
                border-width: k == r.index ? 2px : 1px;
                border-color: k == r.index ? Tok.accent-text : Tok.input-border;
                accessible-role: button;
                accessible-label: @tr("{}, colour {}", r.label, k + 1);
                TouchArea { clicked => { Api.set-palico-look(r.key, k); } }
            }
            if r.index < 0: Rectangle {
                width: 26px;
                height: 26px;
                y: 4px;
                border-radius: 13px;
                background: r.colour;
                border-width: 2px;
                border-color: Tok.bad;
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// A Palico's support move or skill list: a picker per slot (innate ones fixed) and a
// tick to equip it; the equip limit and "was … Undo" above.
component EntryList inherits VerticalLayout {
    in property <string> title;
    in property <string> kind;
    in property <string> used;
    in property <[PalicoEntry]> rows;
    in property <[string]> names;
    in property <string> was;
    in property <string> key;
    in property <string> warning;
    spacing: 6px;
    HorizontalLayout {
        spacing: Tok.gap;
        SectionTitle { text: root.title; vertical-alignment: center; }
        Text { text: root.used; color: Tok.muted; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.was != "": WasLine { was: root.was; key: root.key; }
    if root.warning != "": Text { text: @tr("The game cannot make this: {}.", root.warning); color: Tok.bad; font-size: Tok.small; wrap: word-wrap; }
    for r in root.rows: HorizontalLayout {
        spacing: Tok.gap;
        height: 34px;
        CheckBox {
            width: 36px;
            checked: r.on;
            enabled: r.id != 0;
            accessible-label: @tr("Equip {}", r.name);
            toggled => { Api.set-palico-entry(root.kind, r.slot, r.id, self.checked); }
        }
        if r.innate: Text { text: r.name; width: 260px; vertical-alignment: center; }
        if !r.innate: Picker {
            width: 260px;
            model: root.names;
            value: r.id;
            picked(i) => { Api.set-palico-entry(root.kind, r.slot, i, r.on); }
        }
        Text {
            text: r.innate ? @tr("Innate") : r.taught ? @tr("Taught slot") : "";
            color: Tok.muted;
            font-size: Tok.small;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component PalicoesPage inherits Rectangle {
    property <string> key: "palico:" + Api.palico.index + ":";
    // the detail card's inside: page margins, list, gap, card padding and scroll bar off
    property <length> detail-w: root.width - 2 * Tok.margin - Tok.list-w(root.width) - Tok.pad - 38px - 12px;
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Palicoes");
            subtitle: Api.palico-summary;
            staged: Api.page-counts[4];
        }
        TabBar { tabs: Api.palico-tabs; current: Api.palico-tab; select(i) => { Tabs.select("palicoes", i); } }
        if Api.palico-tab >= 1: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            ConfidenceTag { level: Confidence.derived; y: 2px; }
            Muted { text: Api.palico-note; wrap: word-wrap; horizontal-stretch: 1; }
        }
        // the other tabs: roles, counters and scouting fields, read-only lines, StreetPass
        if Api.palico-tab >= 2: HorizontalLayout {
            vertical-stretch: 1;
            alignment: start;
            Card {
                width: min(root.width - 2 * Tok.margin, Tok.row-max);
                // two lists one after the other: an inline layout sizes the scroll area
                if Api.palico-tab != 3: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding-bottom: 12px;
                        for r in Api.palico-fields: FieldLine { r: r; }
                        for r in Api.palico-info: InfoLine { r: r; }
                    }
                }
                if Api.palico-tab == 3 && Api.palico-mail.length == 0: EmptyState { text: @tr("No StreetPass Palicoes."); }
                if Api.palico-tab == 3: ListView {
                    for r in Api.palico-mail: MailRow {
                        name: r.name;
                        tag: r.tag;
                        line1: r.line1;
                        line2: r.line2;
                        greeting: r.greeting;
                        can-remove: r.slot >= 0;
                        remove-text: @tr("Remove");
                        remove => { Api.remove-palico-mail(r.slot); }
                    }
                }
            }
        }
        if Api.palico-tab <= 1: HorizontalLayout {
            spacing: Tok.pad;
            vertical-stretch: 1;
            VerticalLayout {
                width: Tok.list-w(root.width);
                spacing: Tok.tight;
                SearchField {
                    placeholder-text: @tr("Search Palicoes");
                    text <=> Api.palico-search;
                    edited(t) => { Api.filter-palicoes(t); }
                }
            Card {
                vertical-stretch: 1;
                if Api.palicoes.length == 0: EmptyState { text: Api.palico-search == "" ? @tr("No Palicoes in this save.") : @tr("No Palico matches the search."); }
                ListView {
                    for p in Api.palicoes: ListRow {
                        height: 50px;
                        selected: p.index == Api.palico.index;
                        staged: p.changed;
                        accessible-role: list-item;
                        accessible-label: p.name;
                        clicked => { Api.select-palico(p.index); }
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            alignment: center;
                            Text { text: p.name; overflow: elide; }
                            Text { text: p.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
                        }
                    }
                }
            }
                if Api.palico-tab == 0: Button { text: @tr("Import Palico…"); clicked => { Api.palico-import(); } }
            }
            Card {
                horizontal-stretch: 1;
                if Api.palico.index < 0: EmptyState { text: @tr("Pick a Palico to edit it."); }
                if Api.palico.index >= 0: ScrollView {
                    VerticalLayout {
                        padding: Tok.pad;
                        padding-left: 22px;
                        spacing: 14px;
                        alignment: start;
                        Text { text: Api.palico.name; font-size: 18px; font-weight: 600; }
                        // the Palico with its equipment into another character, or a file
                        HorizontalLayout {
                            spacing: Tok.tight;
                            alignment: start;
                            for s in Api.other-characters: Button { text: @tr("Copy to {}", s.name); clicked => { Api.palico-copy(s.slot); } }
                            Button { text: @tr("Export…"); clicked => { Api.palico-export(); } }
                            ConfidenceTag { level: Confidence.derived; y: 5px; }
                        }
                        if Api.palico.warning != "": Text {
                            text: @tr("The game cannot make this: {}.", Api.palico.warning);
                            color: Tok.bad;
                            font-size: Tok.small;
                            wrap: word-wrap;
                        }
                        // looks beside moves and skills when both fit at their minimum width
                        Rectangle {
                          min-width: pair.min-w;
                          height: pair.h;
                          // the moves beside the fields only as wide as their pickers need
                          pair := Pair {
                            w: root.detail-w;
                            gap: 32px;
                            v-gap: 14px;
                            a-min: fields.min-width;
                            b-min: entries.min-width;
                            b-share: 0;
                            a-h: fields.preferred-height;
                            b-h: entries.preferred-height;
                          }
                          fields := VerticalLayout {
                            x: 0;
                            y: 0;
                            width: pair.a-w;
                            height: pair.a-height;
                            spacing: 14px;
                            alignment: start;
                        TextRow { label: @tr("Name"); field: "name"; value: Api.palico.name; was: Api.palico.was-name; key: root.key + "name"; field-width: 260px; }
                        Row {
                            label: @tr("Level");
                            was: Api.palico.was-level;
                            key: root.key + "level";
                            NumberBox { width: 110px; minimum: 1; maximum: 99; value: Api.palico.level; label: @tr("Level"); edited(v) => { Api.set-palico("level", v); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Row {
                            label: @tr("Experience");
                            was: Api.palico.was-exp;
                            key: root.key + "exp";
                            NumberBox { width: 160px; maximum: 9999999; value: Api.palico.exp; label: @tr("Experience"); edited(v) => { Api.set-palico("exp", v); } }
                            Muted { text: @tr("Separate from the level: the game does not recompute one from the other."); vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        Row {
                            label: @tr("Forte");
                            was: Api.palico.was-bias;
                            key: root.key + "bias";
                            Picker { width: 200px; model: Api.biases; value: Api.palico.bias; picked(i) => { Api.set-palico("bias", i); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Row {
                            label: @tr("Target");
                            was: Api.palico.was-target;
                            key: root.key + "target";
                            note: @tr("Large First is checked in game; the others follow the game's menu order.");
                            Picker { width: 200px; model: Api.palico-targets; value: Api.palico.target - 1; picked(i) => { Api.set-palico("target", i + 1); } }
                            ConfidenceTag { level: Confidence.derived; y: 5px; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        TextRow { label: @tr("Greeting"); field: "greeting"; value: Api.palico.greeting; was: Api.palico.was-greeting; key: root.key + "greeting"; }
                        TextRow { label: @tr("Original owner"); field: "owner"; value: Api.palico.owner; was: Api.palico.was-owner; key: root.key + "owner"; field-width: 260px; }
                        Hairline { }
                        LookList {
                            rows: Api.palico.look-rows;
                            was: Api.palico.was-looks;
                            key: root.key + "looks";
                            warning: Api.palico.warn-looks;
                        }
                        // above the moves when they come below; hidden, not removed, so
                        // the column's width does not depend on the placement it decides
                        Hairline { visible: !pair.side; }
                          }
                          entries := VerticalLayout {
                            x: pair.b-x;
                            y: pair.b-y;
                            width: pair.b-w;
                            height: pair.b-height;
                            spacing: 14px;
                            alignment: start;
                        EntryList {
                            title: @tr("Support moves");
                            kind: "moves";
                            used: Api.palico.moves-used;
                            rows: Api.palico.move-rows;
                            names: Api.palico-move-names;
                            was: Api.palico.was-moves;
                            key: root.key + "moves";
                            warning: Api.palico.warn-moves;
                        }
                        Hairline { }
                        EntryList {
                            title: @tr("Skills");
                            kind: "skills";
                            used: Api.palico.skills-used;
                            rows: Api.palico.skill-rows;
                            names: Api.palico-skill-names;
                            was: Api.palico.was-skills;
                            key: root.key + "skills";
                            warning: Api.palico.warn-skills;
                        }
                          }
                        }
                        Muted { text: @tr("Innate entries come with the forte; taught slots are the ones the Palico Dojo fills. The game draws the rest when the Palico is born."); wrap: word-wrap; }
                    }
                }
            }
        }
    }
}
