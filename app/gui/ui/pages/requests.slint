import { ListView, CheckBox, Palette, LineEdit } from "std-widgets.slint";
import { Api, Tok, Card, Muted, Chip, PageHeader, ColHead, InfoTip, Hairline, EmptyState, ListRow, SearchField } from "../common.slint";

export component RequestsPage inherits Rectangle {
    // the first tick of Reported in this session shows what it costs (05.2)
    property <bool> warned;
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        // title identical to the nav label (C1)
        PageHeader {
            title: @tr("Requests");
            subtitle: Api.request-summary;
            staged: Api.page-counts[6];
        }
        HorizontalLayout {
            spacing: Tok.tight;
            SearchField {
                placeholder-text: @tr("Search requests or villages");
                text <=> Api.request-search;
                edited => { Api.filter-requests(); }
            }
            for f in [{k: "open", t: @tr("Open")}, {k: "done", t: @tr("Reported")}, {k: "all", t: @tr("All")}]: Chip {
                y: 2px;
                text: f.t;
                active: Api.request-filter == f.k;
                clicked => {
                    Api.request-filter = f.k;
                    Api.filter-requests();
                }
            }
        }
        // said before the first tick, and outlined once Reported was ticked; wraps in a
        // narrow window rather than cutting the sentence (not an `if`: see Reveal)
        Rectangle {
            height: banner.preferred-height;
            border-radius: Tok.radius;
            background: Tok.warn.transparentize(root.warned ? 0.82 : 0.92);
            border-width: 1px;
            border-color: Tok.warn.transparentize(root.warned ? 0.3 : 0.7);
            banner := HorizontalLayout {
                padding: 10px;
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: @tr("Reported skips the talk with the villager, so the game never hands over that reward. Leave it unticked and report in game to get the reward.");
                    color: Tok.warn;
                    font-size: Tok.small;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            alignment: start;
            Card {
                width: min(root.width - 2 * Tok.margin, Tok.row-max);
                VerticalLayout {
                    Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 10px;
                            ColHead { text: @tr("Request"); horizontal-stretch: 1; }
                            HorizontalLayout {
                                width: 110px;
                                spacing: 6px;
                                alignment: start;
                                ColHead { text: @tr("Accepted"); }
                                InfoTip { y: 9px; text: @tr("Accepted posts the request's quest on the board, as talking to the villager does."); }
                            }
                            // the consequence at the control, not in a footnote (05.1)
                            HorizontalLayout {
                                width: 120px;
                                spacing: 6px;
                                alignment: start;
                                ColHead { text: @tr("Reported"); }
                                InfoTip {
                                    y: 9px;
                                    tint: Tok.warn;
                                    text: @tr("Reported: the cleared quest was reported back to the villager. Unticked, the game asks you to report it. The game hands out the reward only when you report yourself, so ticking it here loses that reward.");
                                }
                            }
                        }
                        Hairline { y: parent.height - 1px; width: parent.width; }
                    }
                    if Api.requests.length == 0: EmptyState {
                        text: Api.request-search != "" ? @tr("No request matches the search.") : Api.request-filter == "open" ? @tr("Every request is reported.") : Api.request-filter == "done" ? @tr("No request is reported yet.") : @tr("No requests.");
                    }
                    ListView {
                        for r in Api.requests: ListRow {
                            staged: r.changed;
                            flash: Api.highlight != "" && Api.highlight == "request:" + r.index;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: r.name; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if r.was != "": Text { text: @tr("was {}", r.was); color: Tok.accent-text; font-size: Tok.small; }
                                        Text { text: r.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; horizontal-stretch: 1; }
                                    }
                                }
                                Rectangle {
                                    width: 110px;
                                    if r.has-flags: CheckBox { x: 0; checked: r.accepted; accessible-label: @tr("Accepted: {}", r.name); toggled => { Api.set-request(r.index, "accepted", self.checked); } }
                                }
                                Rectangle {
                                    width: 120px;
                                    if r.has-flags: CheckBox {
                                        x: 0;
                                        checked: r.completed;
                                        accessible-label: @tr("Reported: {}", r.name);
                                        toggled => {
                                            if self.checked {
                                                root.warned = true;
                                            }
                                            Api.set-request(r.index, "completed", self.checked);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
