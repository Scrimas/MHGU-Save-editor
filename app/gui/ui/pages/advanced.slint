import { ListView, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { Api, Tok, Card, Muted, ConfidenceTag, PageHeader, ColHead, Hairline, EmptyState, ListRow, SearchField } from "../common.slint";

export component AdvancedPage inherits Rectangle {
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Save map");
            subtitle: @tr("Every byte range of the save, named from the game's own loader · read-only, character {}", Api.slot + 1);
        }
        SearchField {
            placeholder-text: @tr("Filter by name, manager or offset");
            text <=> Api.field-filter;
            edited(t) => { Api.filter-fields(t); }
        }
        HorizontalLayout {
            spacing: Tok.pad;
            vertical-stretch: 1;
            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            ColHead { text: @tr("Offset"); width: 84px; }
                            ColHead { text: @tr("Size"); width: 64px; }
                            ColHead { text: @tr("Manager"); width: 110px; }
                            ColHead { text: @tr("Name"); horizontal-stretch: 1; }
                            ColHead { text: @tr("Confidence"); width: 100px; }
                        }
                        Hairline { y: parent.height - 1px; width: parent.width; }
                    }
                    ListView {
                        property <int> seq: Api.jump-seq;
                        function go() {
                            if Api.page == "advanced" && Api.jump-row >= 0 {
                                self.content-y = -max(0px, Api.jump-row * 40px - self.visible-height / 3);
                            }
                        }
                        init => { self.go(); }
                        changed seq => { self.go(); }
                        for f in Api.fields: ListRow {
                            two-line: false;
                            selected: f.index == Api.field-sel;
                            staged: f.changed;
                            clicked => { Api.select-field(f.index); }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text { text: f.offset; width: 84px; vertical-alignment: center; font-family: "monospace"; font-size: Tok.small; }
                                Text { text: f.size; width: 64px; vertical-alignment: center; color: Tok.muted; font-size: Tok.small; }
                                Text { text: f.owner; width: 110px; vertical-alignment: center; color: Tok.muted; font-size: Tok.small; overflow: elide; }
                                Text { text: f.label; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; font-size: Tok.small; }
                                // the same tag as everywhere else, not "DERIVED" (06.4)
                                Rectangle {
                                    width: 100px;
                                    ConfidenceTag { level: f.confidence; info: false; }
                                }
                            }
                        }
                    }
                }
            }
            Card {
                horizontal-stretch: 2;
                if Api.field-sel < 0: EmptyState { text: @tr("Pick a row to see its bytes. A * marks bytes changed by edits that are not written yet."); }
                if Api.field-sel >= 0: VerticalLayout {
                    padding: Tok.pad;
                    spacing: 10px;
                    Text { text: Api.field-info; wrap: word-wrap; font-size: Tok.small; }
                    ScrollView {
                        TextInput {
                            text: Api.hex;
                            read-only: true;
                            single-line: false;
                            font-family: "monospace";
                            font-size: Tok.small;
                            color: Palette.foreground;
                        }
                    }
                }
            }
        }
    }
}
