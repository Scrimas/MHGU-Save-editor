import { ListView, CheckBox, Button, Palette, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import {
    Api, Tok, Card, Muted, Chip, QuestRow, PageHeader, TabBar, ColHead, InfoTip, Hairline, EmptyState, ListRow, SearchField, TextLink,
    ConfidenceTag, Confidence, NumberBox, StagedBar, WasLine,
} from "../common.slint";

component QuestLine inherits ListRow {
    in property <QuestRow> q;
    height: q.header ? 46px : 48px;
    staged: !q.header && q.changed;
    flash: !q.header && Api.highlight != "" && Api.highlight == "quest:" + q.index;
    if q.header: HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: Tok.tight;
        Text { text: q.name; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        // a group action, in the group header (C2); "Mark 1★ cleared", not "Clear" (04.2)
        if q.action != "": Button { y: 7px; height: 32px; text: q.action; clicked => { Api.quest-bulk(q.group); } }
    }
    if !q.header: HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            // as wide as the header's longest translation ("Abgeschlossen")
            width: 100px;
            CheckBox {
                x: 0;
                checked: q.cleared;
                accessible-label: @tr("Cleared: {}", q.name);
                toggled => { Api.set-quest(q.index, "cleared", self.checked); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: q.prowler ? @tr("{}  (Prowler)", q.name) : q.name; overflow: elide; }
            HorizontalLayout {
                spacing: 6px;
                if q.was != "": Text { text: @tr("was {}", q.was); color: Tok.accent-text; font-size: Tok.small; }
                Text { text: q.sub; color: q.locked ? Tok.bad : Tok.muted; font-size: Tok.small; overflow: elide; horizontal-stretch: 1; }
            }
        }
        Rectangle {
            width: 80px;
            CheckBox { x: 0; checked: q.seen; accessible-label: @tr("Seen: {}", q.name); toggled => { Api.set-quest(q.index, "seen", self.checked); } }
        }
        Rectangle {
            // as wide as the header's longest translation ("Fehlgeschlagen")
            width: 110px;
            CheckBox { x: 0; checked: q.failed; accessible-label: @tr("Failed: {}", q.name); toggled => { Api.set-quest(q.index, "failed", self.checked); } }
        }
        Rectangle {
            width: 64px;
            TextLink {
                x: 0;
                y: (parent.height - self.height) / 2;
                text: @tr("Database");
                clicked => { Api.open-db("quest", q.index); }
            }
        }
    }
}

// The Arena records tab: the best time and set per Arena quest.
component ArenaRecords inherits Card {
    VerticalLayout {
        padding: Tok.pad;
        padding-left: 22px;
        spacing: 8px;
        HorizontalLayout {
            spacing: Tok.gap;
            alignment: start;
            ConfidenceTag { level: Confidence.derived; }
            Text { text: @tr("Your best time per Arena quest, as a solo clear with the set picked. The rank follows the time; the Arena Counter's best time follows yours.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
        }
        HorizontalLayout {
            height: 28px;
            alignment: start;
            ColHead { text: @tr("Quest"); width: 280px; }
            ColHead { text: @tr("Best time"); width: 320px; }
            ColHead { text: @tr("Set"); width: 220px; }
            ColHead { text: @tr("Rank"); width: 70px; }
        }
        for r in Api.arena: VerticalLayout {
            Hairline { }
            Rectangle {
                if r.was != "": StagedBar { x: -10px; y: 6px; height: 32px; }
                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: start;
                        height: 32px;
                        VerticalLayout {
                            width: 280px;
                            alignment: center;
                            Text { text: r.quest; overflow: elide; }
                            Muted { text: r.grades; font-size: Tok.small; }
                        }
                        HorizontalLayout {
                            width: 320px;
                            spacing: 4px;
                            NumberBox { width: 80px; value: r.minutes; maximum: 30; label: @tr("{}, minutes", r.quest); edited(v) => { Api.set-arena(r.index, r.set, v * 6000 + r.seconds * 100 + r.hundredths); } }
                            Text { text: ":"; vertical-alignment: center; }
                            NumberBox { width: 80px; value: r.seconds; maximum: 59; label: @tr("{}, seconds", r.quest); edited(v) => { Api.set-arena(r.index, r.set, r.minutes * 6000 + v * 100 + r.hundredths); } }
                            Text { text: "."; vertical-alignment: center; }
                            NumberBox { width: 80px; value: r.hundredths; maximum: 99; label: @tr("{}, hundredths", r.quest); edited(v) => { Api.set-arena(r.index, r.set, r.minutes * 6000 + r.seconds * 100 + v); } }
                            Rectangle { }
                        }
                        ComboBox {
                            width: 200px;
                            model: r.sets;
                            current-index: r.set;
                            selected => { Api.set-arena(r.index, self.current-index, max(1, r.minutes * 6000 + r.seconds * 100 + r.hundredths)); }
                        }
                        Rectangle { width: 20px; }
                        Text { text: r.has ? r.grade : "—"; width: 70px; vertical-alignment: center; font-weight: 600; color: r.has ? Palette.foreground : Tok.faint; }
                        if r.has: TextLink { y: (parent.height - self.height) / 2; text: @tr("Clear"); clicked => { Api.clear-arena(r.index); } }
                    }
                    if r.was != "": WasLine { was: r.was; key: "arena:" + r.index; }
                    if r.warning != "": Text { text: @tr("The game cannot make this: {}.", r.warning); color: Tok.bad; font-size: Tok.small; wrap: word-wrap; }
                }
            }
        }
    }
}

export component QuestsPage inherits Rectangle {
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Quests");
            subtitle: Api.quest-summary;
            staged: Api.page-counts[5];
        }
        TabBar { tabs: Api.quest-tabs; current: Api.quest-tab; select(i) => { Api.select-quest-tab(i); } }
        if Api.quest-arena: ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: start;
                ArenaRecords { width: min(root.width - 2 * Tok.margin, Tok.row-max); }
            }
        }
        if !Api.quest-arena: HorizontalLayout {
            spacing: Tok.tight;
            SearchField {
                placeholder-text: @tr("Search quests by name or number");
                text <=> Api.quest-search;
                edited => { Api.filter-quests(); }
            }
            Chip {
                y: 2px;
                text: @tr("Missing only");
                active: Api.quest-missing;
                clicked => {
                    Api.quest-missing = !Api.quest-missing;
                    Api.filter-quests();
                }
            }
        }
        if !Api.quest-arena: HorizontalLayout {
            vertical-stretch: 1;
            alignment: start;
            Card {
                width: min(root.width - 2 * Tok.margin, Tok.row-max);
                VerticalLayout {
                    // one table pattern: column headers, value columns next to the name (09)
                    Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 10px;
                            ColHead { text: @tr("Cleared"); width: 100px; }
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                alignment: start;
                                ColHead { text: @tr("Quest"); }
                                InfoTip {
                                    y: 9px;
                                    text: @tr("A red line means the quest is not on the board yet and says what unlocks it. Clearing a quest also marks it seen and completes its quest sets, as the game does.");
                                }
                            }
                            ColHead { text: @tr("Seen"); width: 80px; }
                            ColHead { text: @tr("Failed"); width: 110px; }
                            Rectangle { width: 64px; }
                        }
                        Hairline { y: parent.height - 1px; width: parent.width; }
                    }
                    if Api.quests.length == 0: EmptyState { text: Api.quest-missing ? @tr("Every quest here is cleared.") : @tr("No quest matches the search."); }
                    ListView {
                        property <int> seq: Api.jump-seq;
                        function go() {
                            if Api.page == "quests" && Api.jump-row >= 0 {
                                self.content-y = -max(0px, Api.jump-row * 48px - self.visible-height / 3);
                            }
                        }
                        init => { self.go(); }
                        changed seq => { self.go(); }
                        for q in Api.quests: QuestLine { q: q; }
                    }
                }
            }
        }
    }
}
