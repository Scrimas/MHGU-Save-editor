import { ListView, CheckBox, Button, Palette, LineEdit } from "std-widgets.slint";
import { Api, Tok, Card, Muted, Chip, QuestRow, ConfidenceTag, Confidence } from "../common.slint";

component QuestLine inherits Rectangle {
    in property <QuestRow> q;
    height: q.header ? 40px : 44px;
    background: q.changed ? Palette.accent-background.transparentize(0.9) : transparent;
    if q.header: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text { text: q.name; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        Button { text: "Clear all of " + q.rank; clicked => { Api.quest-bulk(q.rank, "clear"); } }
    }
    if !q.header: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        CheckBox {
            width: 30px;
            checked: q.cleared;
            accessible-label: "Cleared: " + q.name;
            toggled => { Api.set-quest(q.index, "cleared", self.checked); }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: q.name + (q.prowler ? "  (Prowler)" : ""); overflow: elide; font-weight: q.changed ? 600 : 400; }
            Text {
                text: "#" + q.id + (q.lock != "" ? " · " + q.lock : "");
                color: q.locked ? Tok.bad : Tok.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
        CheckBox { width: 70px; text: "Seen"; checked: q.seen; toggled => { Api.set-quest(q.index, "seen", self.checked); } }
        CheckBox { width: 80px; text: "Failed"; checked: q.failed; toggled => { Api.set-quest(q.index, "failed", self.checked); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Tok.line; }
}

export component QuestsPage inherits Rectangle {
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                Text { text: "Quests"; font-size: 22px; font-weight: 600; }
                Muted { text: Api.quest-summary; }
            }
            Rectangle { horizontal-stretch: 1; }
            ConfidenceTag { level: Confidence.confirmed; }
        }
        HorizontalLayout {
            spacing: 6px;
            for t[i] in Api.quest-tabs: Chip { text: t; active: Api.quest-tab == i; clicked => { Api.select-quest-tab(i); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Card {
            vertical-stretch: 1;
            ListView {
                for q in Api.quests: QuestLine { q: q; }
            }
        }
        Muted {
            text: "Clearing a quest also marks it seen and sets the bit of every quest set it completes. The lock line is the board's own unlock rule (script check_quest_unlocked); event flags are set by NPC talk in the game.";
            font-size: 11px;
        }
    }
}
