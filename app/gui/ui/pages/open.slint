import { Button, ListView, Palette } from "std-widgets.slint";
import { Api, Tok, Card, Muted, Hairline } from "../common.slint";

export component OpenPage inherits Rectangle {
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(620px, root.width - 32px);
                spacing: Tok.pad;
                Text { text: "Open a save"; font-size: Tok.title; font-weight: 600; }
                Muted {
                    text: "Pick the system file of Monster Hunter Generations Ultimate (Switch). In Ryujinx it is in bis/user/save/<id>/0/. Close the emulator before writing: it overwrites the save on exit.";
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Open save…";
                        primary: true;
                        clicked => { Api.open-dialog(); }
                    }
                }
                // each detected save with its characters, not a bare path (R12)
                if Api.detected.length > 0: VerticalLayout {
                    spacing: Tok.tight;
                    Text { text: "Found on this computer"; font-weight: 600; }
                    Card {
                        height: min(Api.detected.length, 5) * 72px + 2px;
                        ListView {
                            for p[i] in Api.detected: Rectangle {
                                height: 72px;
                                background: ta.has-hover ? Tok.hover : transparent;
                                accessible-role: button;
                                accessible-label: p.title;
                                if i > 0: Hairline { y: 0; width: parent.width; }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: Tok.gap;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: p.title; font-weight: 600; overflow: elide; }
                                        Text { text: p.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
                                        Text { text: p.short; color: Tok.muted; font-size: Tok.small; font-family: "monospace"; overflow: elide; }
                                    }
                                    Text { text: p.when; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                                }
                                ta := TouchArea { clicked => { Api.open-path(p.path); } }
                            }
                        }
                    }
                }
                if Api.warning != "": Text { text: Api.warning; color: Tok.bad; wrap: word-wrap; }
                Muted { text: Api.build-info; }
            }
        }
    }
}
