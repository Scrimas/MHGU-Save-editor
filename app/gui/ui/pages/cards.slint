import { ListView, Palette } from "std-widgets.slint";
import { Api, Tabs, Tok, Card, Muted, PageHeader, TabBar, WasLine, EmptyState, Hairline, ConfidenceTag, Confidence, KeyActivate, FocusRing } from "../common.slint";

// A quiet row action: icon and label in the muted colour, outlined, taking its tint
// (red to remove, the accent to move) only under the pointer or the keyboard.
component RowAction inherits Rectangle {
    in property <string> text;
    // "remove", "unblock" or "move"
    in property <string> icon;
    in property <color> tint: Tok.bad;
    callback clicked;
    property <bool> hot: ta.has-hover || fk.has-focus;
    width: row.preferred-width;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.hot ? root.tint.transparentize(0.55) : Tok.line;
    background: ta.pressed ? root.tint.transparentize(0.78) : root.hot ? root.tint.transparentize(0.9) : transparent;
    animate background, border-color { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        Path {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 16;
            viewbox-height: 16;
            fill: transparent;
            stroke: root.hot ? root.tint : Tok.muted;
            stroke-width: 1.4px;
            commands: root.icon == "move" ? "M 2 8 L 13 8 M 9 4 L 13 8 L 9 12"
                : root.icon == "unblock" ? "M 8 1.8 A 6.2 6.2 0 1 1 7.99 1.8 M 5 8 L 7.2 10.2 L 11 6"
                : "M 2.5 4.5 L 13.5 4.5 M 6 4.5 L 6 2.5 L 10 2.5 L 10 4.5 M 4 4.5 L 4.8 13.5 L 11.2 13.5 L 12 4.5 M 6.8 7 L 6.8 11 M 9.2 7 L 9.2 11";
        }
        Text { text: root.text; font-size: Tok.small; font-weight: 600; vertical-alignment: center; color: root.hot ? root.tint : Tok.muted; }
    }
    fk := KeyActivate { activated => { root.clicked(); } }
    FocusRing { shown: fk.has-focus; border-radius: 6px; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// One card, blocked user or hunter for hire: name, what the game shows about it, then the
// tab's actions. Also the StreetPass Palicoes' rows (palicoes.slint).
export component Row inherits Rectangle {
    in property <string> name;
    in property <string> tag;
    in property <string> line1;
    in property <string> line2;
    in property <string> greeting;
    in property <bool> can-move;
    in property <bool> can-remove;
    in property <string> remove-text;
    // the blocked-user list: the action unblocks rather than deletes
    in property <bool> unblock;
    callback move();
    callback remove();
    height: lines.preferred-height + 16px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        lines := VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.name; font-weight: 600; overflow: elide; }
                if root.tag != "": Text { text: root.tag; color: Tok.accent-text; font-size: Tok.small; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.line1 != "": Text { text: root.line1; color: Tok.muted; font-size: Tok.small; overflow: elide; }
            if root.line2 != "": Text { text: root.line2; color: Tok.muted; font-size: Tok.small; overflow: elide; }
            if root.greeting != "": Text { text: "“" + root.greeting + "”"; color: Tok.muted; font-size: Tok.small; font-italic: true; overflow: elide; }
        }
        if root.can-move: VerticalLayout {
            alignment: center;
            RowAction { text: @tr("Move to Card List"); icon: "move"; tint: Tok.accent-text; clicked => { root.move(); } }
        }
        if root.can-remove: VerticalLayout {
            alignment: center;
            RowAction { text: root.remove-text; icon: root.unblock ? "unblock" : "remove"; tint: root.unblock ? Tok.accent-text : Tok.bad; clicked => { root.remove(); } }
        }
    }
    Hairline { y: parent.height - 1px; width: parent.width; }
}

export component CardsPage inherits Rectangle {
    // the list, the inbox and the blocked users take edits; Hunters for Hire is read-only
    property <bool> editable: Api.card-tab != 2;
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Guild Cards");
            subtitle: Api.cards-summary;
            staged: Api.page-counts[10];
        }
        TabBar { tabs: Api.card-tabs; current: Api.card-tab; select(i) => { Tabs.select("cards", i); } }
        if root.editable: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            height: 20px;
            // removing a kept card is Confirmed; the inbox and the blocked list not yet
            if Api.card-tab != 0: ConfidenceTag { level: Confidence.derived; }
            if Api.was-cards != "": WasLine { was: Api.was-cards; key: Api.was-cards-key; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            alignment: start;
            Card {
                width: min(root.width - 2 * Tok.margin, Tok.row-max);
                VerticalLayout {
                    if Api.card-rows.length == 0: EmptyState {
                        text: Api.card-tab == 0 ? @tr("No Guild Cards stored.") : Api.card-tab == 1 ? @tr("The inbox is empty.") : Api.card-tab == 2 ? @tr("No hunters for hire.") : @tr("No one is blocked.");
                    }
                    ListView {
                        for r in Api.card-rows: Row {
                            name: r.name;
                            tag: r.tag;
                            line1: r.line1;
                            line2: r.line2;
                            greeting: r.greeting;
                            can-move: Api.card-tab == 1;
                            can-remove: root.editable;
                            remove-text: Api.card-tab == 3 ? @tr("Unblock") : @tr("Remove");
                            unblock: Api.card-tab == 3;
                            move => { Api.move-card(r.slot); }
                            remove => { Api.remove-card(r.slot); }
                        }
                    }
                }
            }
        }
    }
}
