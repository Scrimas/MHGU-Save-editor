import { ListView, ComboBox, Button, ScrollView, Palette, LineEdit } from "std-widgets.slint";
import {
    Api, Tok, Fmt, Card, Asset, Muted, Chip, EquipRow, ConfidenceTag, Confidence, SectionTitle, PageHeader, TabBar,
    NumberBox, StagedBar, WasLine, EmptyState, Pill, Hairline, TextLink, Chevron, ListRow, SearchField, KeyActivate,
    FocusRing,
} from "../common.slint";

component EquipLine inherits ListRow {
    in property <EquipRow> e;
    height: 50px;
    staged: e.changed;
    flash: Api.highlight != "" && Api.highlight == (Api.equip-owner == 0 ? "equip:hunter:" : "equip:palico:") + e.slot;
    accessible-role: list-item;
    accessible-label: @tr("Box slot {}: {}", e.slot + 1, e.title);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        Text { text: e.slot + 1; width: 40px; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; horizontal-alignment: right; }
        Rectangle {
            width: Api.assets-ok ? 30px : 0px;
            if e.kind-code != 0: Asset { y: 10px; width: 30px; height: 30px; source: e.icon; available: e.has-icon; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: e.title; overflow: elide; color: e.kind-code == 0 ? Tok.faint : Palette.foreground; }
            if e.sub != "": Text { text: e.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
        if e.status != "": Pill { y: (parent.height - self.height) / 2; text: e.status; }
    }
}

export component EquipmentPage inherits Rectangle {
    property <bool> wide: root.width > 900px;
    property <length> detail-w: root.width > 1100px ? 480px : root.width * 0.44;
    property <bool> hunter: Api.equip-owner == 0;
    // narrow window: the selected piece's detail is shown instead of the list
    property <bool> show-detail;
    changed wide => { root.show-detail = false; }
    // picker target: box slot (-1 = first free) and the piece it holds (0 = none)
    property <int> target-slot: -1;
    property <int> target-id: 0;
    property <length> pick-x;
    property <length> pick-y;
    property <length> pick-w: min(560px, root.width - 16px);
    property <length> pick-h: min(600px, root.height - 16px);
    property <string> pick-search;
    function open-picker(slot: int, id: int, category: int, x: length, y: length) {
        root.target-slot = slot;
        root.target-id = id;
        if category >= 0 {
            Api.equip-category = category;
        }
        Api.pick-mode = "";
        root.show-picker(x, y);
    }
    // the looks the selected armor piece can take
    function open-transmog(x: length, y: length) {
        root.target-slot = Api.equip-detail.slot;
        root.target-id = Api.equip-detail.transmog-id;
        Api.pick-mode = "transmog";
        root.show-picker(x, y);
    }
    function show-picker(x: length, y: length) {
        root.pick-search = "";
        Api.search-equip("");
        root.pick-x = clamp(x - root.pick-w, 8px, root.width - root.pick-w - 8px);
        root.pick-y = clamp(y, 8px, root.height - root.pick-h - 8px);
        picker.show();
    }
    function pick(id: int) {
        if Api.pick-mode == "transmog" {
            Api.set-equip("transmog", id);
        } else {
            Api.put-equip(root.target-slot, id);
        }
        picker.close();
    }
    property <string> deco-search;
    function open-decos(x: length, y: length) {
        root.deco-search = "";
        Api.search-decos("");
        root.pick-x = clamp(x - root.pick-w, 8px, root.width - root.pick-w - 8px);
        root.pick-y = clamp(y, 8px, root.height - root.pick-h - 8px);
        decos.show();
    }
    property <string> popup-request: Api.snapshot-popup;
    changed popup-request => {
        if popup-request == "equip-picker" {
            Api.snapshot-popup = "";
            root.open-picker(-1, 0, -1, root.width - Tok.margin, 64px);
        } else if popup-request == "transmog-picker" {
            Api.snapshot-popup = "";
            root.open-transmog(root.width - Tok.margin, 64px);
        } else if popup-request == "deco-picker" {
            Api.snapshot-popup = "";
            root.open-decos(root.width - Tok.margin, 64px);
        }
    }
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Equipment");
            subtitle: Api.equip-summary;
            staged: Api.page-counts[3];
            Button {
                text: @tr("Add equipment");
                enabled: Api.equip-free >= 0;
                clicked => { root.open-picker(-1, 0, -1, self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
            }
        }
        // Hunter / Palico as two tabs (C3)
        TabBar {
            tabs: [@tr("Hunter"), @tr("Palico")];
            current: Api.equip-owner;
            select(i) => {
                Api.equip-owner = i;
                if i == 1 && Api.equip-filter == "talisman" {
                    Api.equip-filter = "all";
                }
                Api.filter-equip(Api.equip-filter);
            }
        }
        HorizontalLayout {
            spacing: Tok.tight;
            SearchField {
                placeholder-text: root.hunter ? @tr("Search name, weapon type or skill") : @tr("Search name or type");
                text <=> Api.equip-search;
                edited(t) => { Api.search-equip-list(t); }
            }
            // no Talismans filter on the Palico box (10.4)
            for f in root.hunter
                ? [{k: "all", t: @tr("All")}, {k: "weapon", t: @tr("Weapons")}, {k: "armor", t: @tr("Armor")}, {k: "talisman", t: @tr("Talismans")}, {k: "empty", t: @tr("Empty")}]
                : [{k: "all", t: @tr("All")}, {k: "weapon", t: @tr("Weapons")}, {k: "armor", t: @tr("Armor")}, {k: "empty", t: @tr("Empty")}]: Chip {
                y: 2px;
                text: f.t;
                active: Api.equip-filter == f.k;
                clicked => { Api.equip-filter = f.k; Api.filter-equip(f.k); }
            }
        }
        HorizontalLayout {
            spacing: Tok.pad;
            vertical-stretch: 1;
            // narrow: the detail of a picked piece takes the list's place, with Back
            if root.wide || !root.show-detail: Card {
                horizontal-stretch: 1;
                if Api.equip-rows.length == 0: EmptyState { text: @tr("Nothing in the box matches."); }
                ListView {
                    property <int> seq: Api.jump-seq;
                    // keep the selected or new row in view (10.1)
                    function go() {
                        if Api.page == "equipment" && Api.jump-row >= 0 {
                            if Api.jump-row * 50px < -self.content-y || (Api.jump-row + 1) * 50px > -self.content-y + self.visible-height {
                                self.content-y = -max(0px, Api.jump-row * 50px - self.visible-height / 3);
                            }
                        }
                    }
                    init => { self.go(); }
                    changed seq => { self.go(); }
                    for e in Api.equip-rows: EquipLine {
                        e: e;
                        selected: e.slot == Api.equip-detail.slot;
                        clicked => {
                            Api.select-equip(e.slot);
                            // no detail panel: an empty slot opens the picker, like the
                            // item box; a piece shows its detail in the list's place
                            if !root.wide && e.kind-code == 0 {
                                root.open-picker(e.slot, 0, -1, root.width - Tok.margin, 64px);
                            } else if !root.wide {
                                root.show-detail = true;
                            }
                        }
                    }
                }
            }
            if root.wide || root.show-detail: Card {
                width: root.wide ? root.detail-w : root.width - 2 * Tok.margin;
                if Api.equip-detail.slot < 0: EmptyState {
                    text: @tr("Pick a piece, or add one to the first free slot.");
                    action: Api.equip-free >= 0 ? @tr("Add equipment") : "";
                    act => { root.open-picker(-1, 0, -1, root.width - Tok.margin, 64px); }
                }
                if Api.equip-detail.slot >= 0: ScrollView {
                    VerticalLayout {
                        padding: Tok.pad;
                        spacing: 14px;
                        alignment: start;
                        if !root.wide: HorizontalLayout {
                            alignment: start;
                            Button { text: @tr("‹ Back to the box");clicked => { root.show-detail = false; } }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: Api.equip-detail.name; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                            Muted { text: Api.equip-detail.id > 0 ? @tr("{} · box slot {} · ID {}", Api.equip-detail.kind, Api.equip-detail.slot + 1, Api.equip-detail.id) : @tr("{} · box slot {}", Api.equip-detail.kind, Api.equip-detail.slot + 1); }
                            if Api.equip-detail.was != "": WasLine { was: Api.equip-detail.was; key: (root.hunter ? "equip:hunter:" : "equip:palico:") + Api.equip-detail.slot; }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: Tok.tight;
                            if Api.equip-detail.kind-code == 0: Button {
                                text: @tr("Add equipment here");
                                enabled: Api.equip-detail.uses == "";
                                clicked => { root.open-picker(Api.equip-detail.slot, 0, -1, self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
                            }
                            if Api.equip-detail.kind-code != 0: Button {
                                text: @tr("Replace…");
                                enabled: Api.equip-detail.uses == "";
                                clicked => { root.open-picker(Api.equip-detail.slot, Api.equip-detail.id, Api.equip-detail.category, self.absolute-position.x - root.absolute-position.x + root.pick-w, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
                            }
                            if Api.equip-detail.kind-code != 0: Button {
                                text: @tr("Remove");
                                enabled: Api.equip-detail.uses == "";
                                clicked => { Api.put-equip(Api.equip-detail.slot, 0); }
                            }
                        }
                        // why the buttons are disabled, next to them (H3.2)
                        if root.hunter && Api.equip-detail.uses != "": Text {
                            text: @tr("Used by {}. Change that in game before replacing or removing this piece.", Api.equip-detail.uses);
                            color: Tok.warn;
                            font-size: Tok.small;
                            wrap: word-wrap;
                        }
                        // Palico gear has neither levels nor decoration slots
                        if root.hunter && Api.equip-detail.kind-code != 0 && !Api.equip-detail.is-talisman: HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: @tr("Level"); vertical-alignment: center; width: 90px; }
                            Rectangle {
                                width: 110px;
                                height: 32px;
                                if Api.equip-detail.was-level != "": StagedBar { x: -8px; height: 32px; }
                                NumberBox { minimum: 1; maximum: 32; value: Api.equip-detail.level; label: @tr("Level"); edited(v) => { Api.set-equip("level", v); } }
                            }
                            if Api.equip-detail.was-level != "": WasLine { y: 7px; was: Api.equip-detail.was-level; key: (root.hunter ? "equip:hunter:" : "equip:palico:") + Api.equip-detail.slot; }
                        }
                        // the decorations and the slots they take of the piece's (10.3)
                        if root.hunter && Api.equip-detail.kind-code != 0 && (Api.equip-detail.decos.length > 0 || Api.equip-detail.deco-slots != 0): VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: Tok.tight;
                                alignment: start;
                                SectionTitle { text: @tr("Decorations"); }
                                if Api.equip-detail.deco-slots >= 0: Muted { text: @tr("{} of {n} slot used" | "{} of {n} slots used" % Api.equip-detail.deco-slots, Api.equip-detail.deco-used); vertical-alignment: center; }
                            }
                            if Api.equip-detail.decos.length == 0: Muted { text: @tr("None"); }
                            for d in Api.equip-detail.decos: HorizontalLayout {
                                spacing: Tok.tight;
                                height: 32px;
                                Text { text: d.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Muted { text: @tr("{n} slot" | "{n} slots" % d.size); vertical-alignment: center; }
                                Button { text: @tr("Remove");clicked => { Api.set-equip("deco-remove", d.index); } }
                            }
                            if Api.equip-detail.deco-slots > Api.equip-detail.deco-used && Api.equip-detail.decos.length < 3: HorizontalLayout {
                                spacing: Tok.tight;
                                alignment: start;
                                Button {
                                    text: @tr("Add decoration…");
                                    clicked => { root.open-decos(self.absolute-position.x - root.absolute-position.x + root.pick-w, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
                                }
                                ConfidenceTag { level: Confidence.derived; y: 5px; }
                            }
                            if Api.equip-detail.deco-slots < 0: Muted { text: @tr("This build's game data has no slot counts: decorations can only be removed."); }
                        }
                        if Api.equip-detail.kind-code >= 1 && Api.equip-detail.kind-code <= 5: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: @tr("Transmog"); }
                            HorizontalLayout {
                                spacing: Tok.tight;
                                Text { text: Api.equip-detail.transmog == "" ? @tr("Own look") : Api.equip-detail.transmog; vertical-alignment: center; horizontal-stretch: 1; }
                                if Api.equip-detail.can-transmog: Button {
                                    text: @tr("Change look…");
                                    clicked => { root.open-transmog(self.absolute-position.x - root.absolute-position.x + root.pick-w, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
                                }
                                if Api.equip-detail.transmog-id != 0: Button { text: @tr("Restore own look");clicked => { Api.set-equip("transmog", 0); } }
                            }
                            if Api.equip-detail.can-transmog: Muted { text: @tr("Looks of the same part that this piece's class and your body type can wear. Skills, slots and defense stay."); }
                        }
                        if Api.equip-detail.is-talisman: VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: @tr("Talisman"); }
                            Muted { text: Api.equip-detail.tier; }
                            for k in 2: HorizontalLayout {
                                spacing: Tok.tight;
                                Text { text: @tr("Skill {}", k + 1); width: 60px; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: Api.skill-names;
                                    current-index: k == 0 ? Api.equip-detail.skill1 : Api.equip-detail.skill2;
                                    selected => { Api.set-equip("skill" + k, self.current-index); }
                                }
                                NumberBox {
                                    width: 100px;
                                    minimum: -10;
                                    maximum: 20;
                                    value: k == 0 ? Api.equip-detail.points1 : Api.equip-detail.points2;
                                    label: @tr("Points of skill {}", k + 1);
                                    edited(v) => { Api.set-equip("points" + k, v); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Tok.tight;
                                alignment: start;
                                Text { text: @tr("Slots"); width: 60px; vertical-alignment: center; }
                                NumberBox { width: 100px; minimum: 0; maximum: 3; value: Api.equip-detail.slots; label: @tr("Decoration slots"); edited(v) => { Api.set-equip("slots", v); } }
                            }
                        }
                        // raw bytes recede into a collapsed section (K4)
                        Hairline { }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Chevron { dir: Api.equip-advanced ? "down" : "right"; y: (parent.height - self.height) / 2; }
                            TextLink {
                                text: @tr("Advanced");
                                tint: Tok.muted;
                                font-weight: 400;
                                clicked => { Api.equip-advanced = !Api.equip-advanced; }
                            }
                        }
                        if Api.equip-advanced: VerticalLayout {
                            spacing: 6px;
                            Muted { text: @tr("The 36 bytes of this box entry. Select to copy."); }
                            TextInput {
                                text: Api.equip-detail.raw;
                                read-only: true;
                                wrap: word-wrap;
                                font-family: "monospace";
                                font-size: Tok.small;
                                color: Palette.foreground;
                            }
                            TextLink {
                                text: @tr("Show in Save map");
                                font-weight: 400;
                                clicked => { Api.show-in-map(Api.equip-detail.field); }
                            }
                        }
                    }
                }
            }
        }
    }
    picker := PopupWindow {
        x: root.pick-x;
        y: root.pick-y;
        width: root.pick-w;
        height: root.pick-h;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tok.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tok.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0007;
            VerticalLayout {
                padding: Tok.pad;
                spacing: 10px;
                Text {
                    text: Api.pick-mode == "transmog" ? @tr("Look for {}", Api.equip-detail.name) : root.target-id != 0 ? @tr("Replace box slot {}", (root.target-slot >= 0 ? root.target-slot : Api.equip-free) + 1) : @tr("Add to box slot {}", (root.target-slot >= 0 ? root.target-slot : Api.equip-free) + 1);
                    font-size: Tok.section;
                    font-weight: 600;
                }
                Muted { text: Api.pick-mode == "transmog" ? @tr("The piece keeps its skills, slots and defense; only its look changes.") : @tr("New pieces start at level 1 with no decorations; edit them afterwards."); }
                HorizontalLayout {
                    spacing: Tok.tight;
                    if Api.pick-mode != "transmog": ComboBox {
                        width: 190px;
                        model: Api.equip-categories;
                        current-index: Api.equip-category;
                        selected => {
                            Api.equip-category = self.current-index;
                            Api.search-equip(root.pick-search);
                        }
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: @tr("Search");
                        text <=> root.pick-search;
                        edited(t) => { Api.search-equip(t); }
                        // Enter takes the first match
                        accepted => {
                            if Api.pick-equip.length > 0 {
                                root.pick(Api.pick-equip[0].id);
                            }
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for p in Api.pick-equip: Rectangle {
                        height: 46px;
                        border-radius: 4px;
                        background: p.id == root.target-id ? Tok.accent-soft : pa.has-hover ? Tok.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: p.name;
                        accessible-action-default => { root.pick(p.id); }
                        fk := KeyActivate { activated => { root.pick(p.id); } }
                        FocusRing { shown: fk.has-focus; border-radius: 4px; }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Asset { width: 28px; height: 28px; y: 9px; source: p.icon; available: p.has-icon; }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: p.name; overflow: elide; }
                                Text { text: p.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
                            }
                        }
                        pa := TouchArea { clicked => { root.pick(p.id); } }
                    }
                }
                HorizontalLayout {
                    spacing: Tok.tight;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { picker.close(); } }
                }
            }
        }
    }
    // decorations that fit the free slots of the selected piece
    decos := PopupWindow {
        x: root.pick-x;
        y: root.pick-y;
        width: root.pick-w;
        height: root.pick-h;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tok.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tok.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0007;
            VerticalLayout {
                padding: Tok.pad;
                spacing: 10px;
                Text { text: @tr("Decoration for {}", Api.equip-detail.name);font-size: Tok.section; font-weight: 600; overflow: elide; }
                property <int> free: Api.equip-detail.deco-slots - Api.equip-detail.deco-used;
                Muted { text: @tr("{n} slot free: only decorations that fit are listed." | "{n} slots free: only decorations that fit are listed." % free); }
                LineEdit {
                    placeholder-text: @tr("Search decorations");
                    text <=> root.deco-search;
                    edited(t) => { Api.search-decos(t); }
                    accepted => {
                        if Api.pick-decos.length > 0 {
                            Api.set-equip("deco-add", Api.pick-decos[0].id);
                            decos.close();
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for p in Api.pick-decos: Rectangle {
                        height: 40px;
                        border-radius: 4px;
                        background: da.has-hover ? Tok.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: p.name + ", " + p.sub;
                        accessible-action-default => {
                            Api.set-equip("deco-add", p.id);
                            decos.close();
                        }
                        dk := KeyActivate {
                            activated => {
                                Api.set-equip("deco-add", p.id);
                                decos.close();
                            }
                        }
                        FocusRing { shown: dk.has-focus; border-radius: 4px; }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Asset { width: 24px; height: 24px; y: 8px; source: p.icon; available: p.has-icon; }
                            Text { text: p.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Muted { text: p.sub; vertical-alignment: center; }
                        }
                        da := TouchArea {
                            clicked => {
                                Api.set-equip("deco-add", p.id);
                                decos.close();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { decos.close(); } }
                }
            }
        }
    }
}
