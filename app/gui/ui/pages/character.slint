import { LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { Api, Tok, Card, Muted, ConfidenceTag, Confidence, SectionTitle, PageHeader, NumberBox, StagedBar, WasLine, ColHead, Hairline, TextLink, Pair, Picker } from "../common.slint";
import { ArtsEditor, PigmentEditor } from "sets.slint";

// Label, control, then "was … Undo" when staged (or the hint). Only the exceptions carry
// a confidence tag (06); the page header states the rule.
component Field inherits Rectangle {
    in property <string> label;
    in property <Confidence> level: Confidence.confirmed;
    in property <string> hint;
    in property <string> was;
    in property <string> key;
    // why the game cannot produce the value, shown in red
    in property <string> warning;
    in property <bool> flash: Api.highlight != "" && Api.highlight == key;
    lay := VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: Tok.tight;
            alignment: start;
            height: 20px;
            Text { text: root.label; vertical-alignment: center; color: root.flash ? Tok.accent-text : Palette.foreground; }
            if root.level != Confidence.confirmed: ConfidenceTag { level: root.level; }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 32px;
            @children
        }
        if root.was != "": WasLine { was: root.was; key: root.key; }
        if root.hint != "" && root.was == "": Muted { text: root.hint; }
        if root.warning != "": Text { text: @tr("The game cannot make this: {}.", root.warning); color: Tok.bad; font-size: Tok.small; wrap: word-wrap; }
    }
    if root.was != "": StagedBar { x: -10px; y: 26px; height: 32px; }
}

// A card of a pair that sits side by side on a wide window (placed by a Pair), its content
// at the top when the other card of the row is taller.
component PairCard inherits Card {
    VerticalLayout {
        alignment: start;
        @children
    }
}

// A table cell of Village points: field, then "was … Undo" beside it.
component PointsCell inherits Rectangle {
    in property <int> value;
    in property <string> was;
    in property <string> key;
    in property <string> label;
    width: 380px;
    height: 44px;
    HorizontalLayout {
        spacing: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        NumberBox {
            width: 220px;
            value: root.value;
            maximum: 20000;
            label: root.label;
            edited(v) => { Api.set-character(root.key, v); }
        }
        if root.was != "": VerticalLayout {
            alignment: center;
            WasLine { was: root.was; key: "points:" + root.key; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.was != "": StagedBar { x: -10px; y: 6px; height: 32px; }
}

// A count with its label and "was … Undo" beside it (quests completed, style use).
component CountCell inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <string> was;
    in property <string> key;
    width: 300px;
    height: 44px;
    HorizontalLayout {
        spacing: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        Text { text: root.label; width: 150px; vertical-alignment: center; }
        NumberBox { width: 110px; value: root.value; maximum: 9999; label: root.label; edited(v) => { Api.set-character(root.key, v); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.was != "": StagedBar { x: -10px; y: 6px; height: 32px; }
}

export component CharacterPage inherits Rectangle {
    property <string> cur-name: Api.character.name;
    changed cur-name => { name-edit.text = self.cur-name; }
    property <string> cur-greeting: Api.card.greeting;
    changed cur-greeting => { greeting-edit.text = self.cur-greeting; }
    // the width inside the page margins, less the scroll bar
    property <length> cw: root.width - 2 * Tok.margin - 12px;
    ScrollView {
        VerticalLayout {
            padding: Tok.margin;
            padding-top: 16px;
            spacing: Tok.gap;
            alignment: start;
            PageHeader {
                title: @tr("Character");
                subtitle: @tr("Confirmed in game except where marked");
                staged: Api.page-counts[1];
            }
            // cards in pairs, side by side when both fit at their minimum width
            Rectangle {
              min-width: pair1.min-w;
              height: pair1.h;
              // Progress beside the Hunter card only as wide as its own content
              pair1 := Pair {
                w: root.cw;
                a-min: hunter.min-width;
                b-min: progress.min-width;
                b-share: 0;
                a-h: hunter.preferred-height;
                b-h: progress.preferred-height;
              }
              hunter := PairCard {
                x: 0;
                y: 0;
                width: pair1.a-w;
                height: pair1.a-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    SectionTitle { text: @tr("Hunter"); }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 360px;
                            label: @tr("Name");
                            hint: @tr("Written to the save, the player record and the Guild Card.");
                            was: Api.character.was-name;
                            key: "name";
                            // staged when the field loses focus or on Enter (05)
                            name-edit := LineEdit {
                                text: Api.character.name;
                                accessible-label: @tr("Hunter name");
                                accepted(t) => { Api.set-name(t); }
                                changed has-focus => {
                                    if !self.has-focus && self.text != Api.character.name {
                                        Api.set-name(self.text);
                                    }
                                }
                            }
                        }
                        // HR and HR points are both editable; HR follows the points (H2.5)
                        Field {
                            width: 170px;
                            label: @tr("Hunter Rank");
                            hint: @tr("Follows HR points");
                            was: Api.character.was-hr;
                            key: "hr";
                            NumberBox { value: Api.character.hr; minimum: 1; maximum: 999; label: @tr("Hunter Rank"); edited(v) => { Api.set-character("hr", v); } }
                        }
                        Field {
                            width: 220px;
                            label: @tr("HR points");
                            was: Api.character.was-hr-points;
                            key: "hr-points";
                            NumberBox { value: Api.character.hr-points; maximum: 9999999; label: @tr("HR points"); edited(v) => { Api.set-character("hr-points", v); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 220px;
                            label: @tr("Zenny");
                            was: Api.character.was-funds;
                            key: "funds";
                            NumberBox { value: Api.character.funds; maximum: 9999999; label: @tr("Zenny"); edited(v) => { Api.set-character("funds", v); } }
                        }
                        Field {
                            width: 220px;
                            label: @tr("Wycademy points");
                            was: Api.character.was-wycademy;
                            key: "wycademy";
                            NumberBox { value: Api.character.wycademy; maximum: 9999999; label: @tr("Wycademy points"); edited(v) => { Api.set-character("wycademy", v); } }
                        }
                        Field {
                            width: 300px;
                            label: @tr("Play time");
                            was: Api.character.was-playtime;
                            key: "playtime";
                            NumberBox { width: 110px; value: Api.character.playtime-h; maximum: 9999; label: @tr("Hours played"); edited(v) => { Api.set-character("play-h", v); } }
                            Text { text: "h"; vertical-alignment: center; }
                            NumberBox { width: 100px; value: Api.character.playtime-m; maximum: 59; label: @tr("Minutes played"); edited(v) => { Api.set-character("play-m", v); } }
                            Text { text: "min"; vertical-alignment: center; }
                        }
                    }
                }
              }
              progress := PairCard {
                x: pair1.b-x;
                y: pair1.b-y;
                width: pair1.b-w;
                height: pair1.b-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    SectionTitle { text: @tr("Progress"); }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 140px;
                            label: @tr("Village ★");
                            was: Api.character.was-village-star;
                            key: "village-star";
                            NumberBox { value: Api.character.village-star; minimum: 1; maximum: 10; label: @tr("Village star level"); edited(v) => { Api.set-character("village-star", v); } }
                        }
                        Field {
                            width: 140px;
                            label: @tr("Hub ★");
                            was: Api.character.was-hub-star;
                            key: "hub-star";
                            NumberBox { value: Api.character.hub-star; maximum: 13; label: @tr("Hub star level"); edited(v) => { Api.set-character("hub-star", v); } }
                        }
                    }
                    Muted { text: @tr("The game raises star levels when every urgent quest of a level is cleared."); }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 170px;
                            label: @tr("Quest counter");
                            level: Confidence.derived;
                            was: Api.character.was-quest-counter;
                            key: "quest-counter";
                            NumberBox { value: Api.character.quest-counter; maximum: 9999999; label: @tr("Quest counter"); edited(v) => { Api.set-character("quest-counter", v); } }
                        }
                        Field {
                            width: 170px;
                            label: @tr("Courier points");
                            level: Confidence.derived;
                            was: Api.character.was-courier-points;
                            key: "courier-points";
                            NumberBox { value: Api.character.courier-points; maximum: 10000; label: @tr("Courier points"); edited(v) => { Api.set-character("courier-points", v); } }
                        }
                    }
                    Muted {
                        text: @tr("Quests completed as the Courier counts them, not shown in game; past 210 the count stays between 210 and 419. Each 1,000 Courier points become 10 Special Permits for a deviant, up to 10,000 points.");
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 240px;
                            label: @tr("Start in");
                            level: Confidence.derived;
                            hint: @tr("Where the next load starts");
                            was: Api.character.was-start-village;
                            key: "start-village";
                            Picker { width: 240px; model: Api.character.start-places; value: Api.character.start-village; picked(i) => { Api.set-character("start-village", i); } }
                        }
                        Field {
                            width: 240px;
                            label: @tr("Housekeeper");
                            level: Confidence.derived;
                            hint: @tr("Room Service, Change Housekeeper");
                            was: Api.character.was-housekeeper;
                            key: "housekeeper";
                            Picker { width: 240px; model: Api.character.housekeepers; value: Api.character.housekeeper; picked(i) => { Api.set-character("housekeeper", i); } }
                        }
                    }
                }
              }
            }
            Rectangle {
              min-width: pair2.min-w;
              height: pair2.h;
              // beside each other they share the spare width
              pair2 := Pair {
                w: root.cw;
                a-min: appearance.min-width;
                b-min: guild-card.min-width;
                b-share: 0.5;
                a-h: appearance.preferred-height;
                b-h: guild-card.preferred-height;
              }
              appearance := PairCard {
                x: 0;
                y: 0;
                width: pair2.a-w;
                height: pair2.a-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Appearance"); vertical-alignment: center; }
                        Text { text: @tr("As character creation sets it, numbered as the game shows it.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    Field {
                        label: @tr("Body");
                        hint: @tr("Some armour is made for one body type only: check what you wear after changing it.");
                        warning: Api.appearance.warn-gender;
                        was: Api.appearance.was-gender;
                        key: "gender";
                        Picker { width: 200px; model: [@tr("Type 1 (male)"), @tr("Type 2 (female)")]; value: Api.appearance.gender; picked(i) => { Api.set-look("gender", i); } }
                    }
                    Field {
                        label: @tr("Face, hairstyle, voice");
                        warning: Api.appearance.warn-appearance;
                        was: Api.appearance.was-appearance;
                        key: "appearance";
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: @tr("Face"); vertical-alignment: center; color: Tok.muted; }
                            Picker { width: 120px; model: Api.look-faces; value: Api.appearance.face; picked(i) => { Api.set-look("face", i); } }
                            Rectangle { width: 14px; }
                            Text { text: @tr("Hairstyle"); vertical-alignment: center; color: Tok.muted; }
                            Picker { width: 120px; model: Api.look-hairstyles; value: Api.appearance.hair; picked(i) => { Api.set-look("hair", i); } }
                            Rectangle { width: 14px; }
                            Text { text: @tr("Voice"); vertical-alignment: center; color: Tok.muted; }
                            Picker { width: 120px; model: Api.look-voices; value: Api.appearance.voice - 1; picked(i) => { Api.set-look("voice", i + 1); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 170px;
                            label: @tr("Features");
                            Picker { width: 120px; model: Api.look-features; value: Api.appearance.features; picked(i) => { Api.set-look("features", i); } }
                        }
                        Field {
                            width: 170px;
                            label: @tr("Clothing");
                            Picker { width: 120px; model: Api.look-clothing; value: Api.appearance.clothing; picked(i) => { Api.set-look("clothing", i); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        for c in Api.appearance.colours: Field {
                            width: 190px;
                            label: c.label;
                            Rectangle { width: 32px; height: 32px; border-radius: 4px; background: c.colour; border-width: 1px; border-color: Tok.input-border; }
                            LineEdit {
                                width: 110px;
                                text: c.hex;
                                accessible-label: c.label;
                                accepted(t) => { Api.set-look-colour(c.key, t); }
                            }
                        }
                    }
                }
              }
              guild-card := PairCard {
                x: pair2.b-x;
                y: pair2.b-y;
                width: pair2.b-w;
                height: pair2.b-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Guild Card"); vertical-alignment: center; }
                        Text { text: @tr("As the card editor in game sets them. Locked entries can be picked too: the card then says so.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    Field {
                        label: @tr("Title");
                        hint: Api.card.title;
                        warning: Api.card.warn-title;
                        was: Api.card.was-title;
                        key: "card-title";
                        Picker { width: 220px; model: Api.gc-words; value: Api.card.word1; picked(i) => { Api.set-card("word1", i); } }
                        Picker { width: 160px; model: Api.gc-links; value: Api.card.link; picked(i) => { Api.set-card("link", i); } }
                        Picker { width: 220px; model: Api.gc-words; value: Api.card.word2; picked(i) => { Api.set-card("word2", i); } }
                    }
                    Field {
                        width: 420px;
                        label: @tr("Greeting");
                        was: Api.card.was-greeting;
                        key: "card-greeting";
                        // staged when the field loses focus or on Enter, like the name
                        greeting-edit := LineEdit {
                            text: Api.card.greeting;
                            accessible-label: @tr("Guild Card greeting");
                            accepted(t) => { Api.set-greeting(t); }
                            changed has-focus => {
                                if !self.has-focus && self.text != Api.card.greeting {
                                    Api.set-greeting(self.text);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            label: @tr("Scene");
                            warning: Api.card.warn-scene;
                            was: Api.card.was-scene;
                            key: "card-scene";
                            Picker { width: 260px; model: Api.gc-scenes; value: Api.card.scene; picked(i) => { Api.set-card("scene", i); } }
                        }
                        Field {
                            label: @tr("Pose");
                            warning: Api.card.warn-pose;
                            was: Api.card.was-pose;
                            key: "card-pose";
                            Picker { width: 220px; model: Api.gc-poses; value: Api.card.pose; picked(i) => { Api.set-card("pose", i); } }
                        }
                    }
                }
              }
            }
            Rectangle {
              min-width: pair4.min-w;
              height: pair4.h;
              pair4 := Pair {
                w: root.cw;
                a-min: arts.min-width;
                b-min: pigment.min-width;
                b-share: 0.5;
                a-h: arts.preferred-height;
                b-h: pigment.preferred-height;
              }
              arts := PairCard {
                x: 0;
                y: 0;
                width: pair4.a-w;
                height: pair4.a-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Style and Hunter Arts"); vertical-alignment: center; }
                        ConfidenceTag { level: Confidence.derived; }
                    }
                    Muted { text: @tr("What you have on now. Loading a My Set in game replaces them with the set's."); wrap: word-wrap; }
                    ArtsEditor { info: Api.char-arts; where: -1; key: "arts"; }
                }
              }
              pigment := PairCard {
                x: pair4.b-x;
                y: pair4.b-y;
                width: pair4.b-w;
                height: pair4.b-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Armor pigment"); vertical-alignment: center; }
                        ConfidenceTag { level: Confidence.derived; }
                    }
                    Muted { text: @tr("The colours of the armor you have on now. Each My Set keeps its own (Equipment, My Sets)."); wrap: word-wrap; }
                    PigmentEditor { rows: Api.char-pigment; where: -1; was: Api.was-pigment; key: "pigment"; }
                }
              }
            }
            Rectangle {
              min-width: pair3.min-w;
              height: pair3.h;
              pair3 := Pair {
                w: root.cw;
                a-min: village-points.min-width;
                b-min: styles.min-width;
                b-share: 0.5;
                a-h: village-points.preferred-height;
                b-h: styles.preferred-height;
              }
              village-points := PairCard {
                x: 0;
                y: 0;
                width: pair3.a-w;
                height: pair3.a-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Village points"); vertical-alignment: center; }
                        Text { text: @tr("The game adds Low rank and G rank and caps the sum at 20,000.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                    }
                    // the eight values as a 4 × 2 table (H2.2, B5)
                    HorizontalLayout {
                        height: 28px;
                        alignment: start;
                        ColHead { text: @tr("Village"); width: 160px; }
                        ColHead { text: @tr("Low rank"); width: 380px; }
                        ColHead { text: @tr("G rank"); width: 380px; }
                    }
                    for v[i] in [@tr("Bherna"), @tr("Kokoto"), @tr("Pokke"), @tr("Yukumo")]: VerticalLayout {
                        Hairline { }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: v; width: 160px; vertical-alignment: center; }
                            PointsCell { value: Api.character.points-lr[i]; was: Api.character.was-lr[i]; key: "lr" + i; label: @tr("{} low rank points", v); }
                            PointsCell { value: Api.character.points-g[i]; was: Api.character.was-g[i]; key: "g" + i; label: @tr("{} G rank points", v); }
                        }
                    }
                }
              }
              styles := PairCard {
                x: pair3.b-x;
                y: pair3.b-y;
                width: pair3.b-w;
                height: pair3.b-height;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Hunting styles"); vertical-alignment: center; }
                        Text { text: @tr("Quests done with each style. Your Palico's lines name the most and least used.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    for name[k] in [@tr("Guild Style"), @tr("Striker Style"), @tr("Aerial Style"), @tr("Adept Style"), @tr("Alchemy Style"), @tr("Valor Style")]: VerticalLayout {
                        Hairline { }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 14px;
                            CountCell { label: name; value: Api.character.style-use[k]; was: Api.character.was-style[k]; key: "style:" + k; }
                            if Api.character.was-style[k] != "": VerticalLayout {
                                alignment: center;
                                WasLine { was: Api.character.was-style[k]; key: "style:" + k; }
                            }
                        }
                    }
                }
              }
            }
            Card {
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Weapon usage"); vertical-alignment: center; }
                        Text { text: @tr("Quests completed with each weapon, as the Guild Card counts them. The largest total is the main weapon.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        height: 28px;
                        alignment: start;
                        ColHead { text: @tr("Weapon"); width: 180px; }
                        for v in [@tr("Village"), @tr("Hub"), @tr("Arena")]: ColHead { text: v; width: 200px; }
                        ColHead { text: @tr("All"); width: 80px; }
                    }
                    for w in Api.character.weapon-use: VerticalLayout {
                        Hairline { }
                        HorizontalLayout {
                            alignment: start;
                            height: 44px;
                            Text { text: w.name + (w.main ? "  ★" : ""); width: 180px; vertical-alignment: center; font-weight: w.main ? 600 : 400; }
                            for c[v] in w.counts: Rectangle {
                                width: 200px;
                                if w.was[v] != "": StagedBar { x: -10px; y: 6px; height: 32px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    NumberBox {
                                        width: 110px;
                                        value: c;
                                        maximum: 9999;
                                        label: @tr("{} quests, {}", w.name, [@tr("Village"), @tr("Hub"), @tr("Arena")][v]);
                                        edited(x) => { Api.set-character("use:" + v + ":" + w.index, x); }
                                    }
                                    if w.was[v] != "": VerticalLayout {
                                        alignment: center;
                                        WasLine { was: w.was[v]; key: "use:" + v + ":" + w.index; }
                                    }
                                }
                            }
                            Text { text: w.total; width: 80px; vertical-alignment: center; color: Tok.muted; }
                        }
                    }
                }
            }
        }
    }
}
