import { LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { Api, Tok, Card, Muted, ConfidenceTag, Confidence, SectionTitle, PageHeader, NumberBox, StagedBar, WasLine, ColHead, Hairline } from "../common.slint";

// Label, control, then "was … Undo" when staged (or the hint). Only the exceptions carry
// a confidence tag (06); the page header states the rule.
component Field inherits Rectangle {
    in property <string> label;
    in property <Confidence> level: Confidence.confirmed;
    in property <string> hint;
    in property <string> was;
    in property <string> key;
    in property <bool> flash: Api.highlight != "" && Api.highlight == key;
    lay := VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: Tok.tight;
            alignment: start;
            height: 20px;
            Text { text: root.label; vertical-alignment: center; color: root.flash ? Tok.accent-text : Palette.foreground; }
            if root.level != Confidence.confirmed: ConfidenceTag { level: root.level; }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 32px;
            @children
        }
        if root.was != "": WasLine { was: root.was; key: root.key; }
        if root.hint != "" && root.was == "": Muted { text: root.hint; }
    }
    if root.was != "": StagedBar { x: -10px; y: 26px; height: 32px; }
}

// A table cell of Village points: field, then "was … Undo" beside it.
component PointsCell inherits Rectangle {
    in property <int> value;
    in property <string> was;
    in property <string> key;
    in property <string> label;
    width: 380px;
    height: 44px;
    HorizontalLayout {
        spacing: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        NumberBox {
            width: 220px;
            value: root.value;
            maximum: 20000;
            label: root.label;
            edited(v) => { Api.set-character(root.key, v); }
        }
        if root.was != "": VerticalLayout {
            alignment: center;
            WasLine { was: root.was; key: "points:" + root.key; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.was != "": StagedBar { x: -10px; y: 6px; height: 32px; }
}

export component CharacterPage inherits Rectangle {
    property <string> cur-name: Api.character.name;
    changed cur-name => { name-edit.text = self.cur-name; }
    ScrollView {
        VerticalLayout {
            padding: Tok.margin;
            padding-top: 16px;
            spacing: Tok.gap;
            alignment: start;
            PageHeader {
                title: "Character";
                subtitle: "Confirmed in game except where marked";
                staged: Api.page-counts[1];
            }
            Card {
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    SectionTitle { text: "Hunter"; }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 360px;
                            label: "Name";
                            hint: "Written to the save, the player record and the Guild Card.";
                            was: Api.character.was-name;
                            key: "name";
                            // staged when the field loses focus or on Enter (05)
                            name-edit := LineEdit {
                                text: Api.character.name;
                                accessible-label: "Hunter name";
                                accepted(t) => { Api.set-name(t); }
                                changed has-focus => {
                                    if !self.has-focus && self.text != Api.character.name {
                                        Api.set-name(self.text);
                                    }
                                }
                            }
                        }
                        // HR and HR points are both editable; HR follows the points (H2.5)
                        Field {
                            width: 170px;
                            label: "Hunter Rank";
                            hint: "Follows HR points";
                            was: Api.character.was-hr;
                            key: "hr";
                            NumberBox { value: Api.character.hr; minimum: 1; maximum: 999; label: "Hunter Rank"; edited(v) => { Api.set-character("hr", v); } }
                        }
                        Field {
                            width: 220px;
                            label: "HR points";
                            was: Api.character.was-hr-points;
                            key: "hr-points";
                            NumberBox { value: Api.character.hr-points; maximum: 9999999; label: "HR points"; edited(v) => { Api.set-character("hr-points", v); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 220px;
                            label: "Zenny";
                            was: Api.character.was-funds;
                            key: "funds";
                            NumberBox { value: Api.character.funds; maximum: 9999999; label: "Zenny"; edited(v) => { Api.set-character("funds", v); } }
                        }
                        Field {
                            width: 220px;
                            label: "Wycademy points";
                            was: Api.character.was-wycademy;
                            key: "wycademy";
                            NumberBox { value: Api.character.wycademy; maximum: 9999999; label: "Wycademy points"; edited(v) => { Api.set-character("wycademy", v); } }
                        }
                        Field {
                            width: 300px;
                            label: "Play time";
                            was: Api.character.was-playtime;
                            key: "playtime";
                            NumberBox { width: 110px; value: Api.character.playtime-h; maximum: 9999; label: "Hours played"; edited(v) => { Api.set-character("play-h", v); } }
                            Text { text: "h"; vertical-alignment: center; }
                            NumberBox { width: 100px; value: Api.character.playtime-m; maximum: 59; label: "Minutes played"; edited(v) => { Api.set-character("play-m", v); } }
                            Text { text: "min"; vertical-alignment: center; }
                        }
                    }
                }
            }
            Card {
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    SectionTitle { text: "Progress"; }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 140px;
                            label: "Village ★";
                            was: Api.character.was-village-star;
                            key: "village-star";
                            NumberBox { value: Api.character.village-star; minimum: 1; maximum: 10; label: "Village star level"; edited(v) => { Api.set-character("village-star", v); } }
                        }
                        Field {
                            width: 140px;
                            label: "Hub ★";
                            was: Api.character.was-hub-star;
                            key: "hub-star";
                            NumberBox { value: Api.character.hub-star; maximum: 13; label: "Hub star level"; edited(v) => { Api.set-character("hub-star", v); } }
                        }
                        Field {
                            width: 170px;
                            label: "Body";
                            Text { text: Api.character.gender; vertical-alignment: center; }
                        }
                        // not mapped yet: a disabled row rather than a footnote (H2.4)
                        Field {
                            width: 170px;
                            label: "Appearance";
                            Text { text: "Not mapped yet"; vertical-alignment: center; color: Tok.faint; }
                        }
                    }
                    Muted { text: "The game raises star levels when every urgent quest of a level is cleared."; }
                }
            }
            Card {
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: "Village points"; vertical-alignment: center; }
                        Text { text: "The game adds Low rank and G rank and caps the sum at 20,000."; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                    }
                    // the eight values as a 4 × 2 table (H2.2, B5)
                    HorizontalLayout {
                        height: 28px;
                        alignment: start;
                        ColHead { text: "Village"; width: 160px; }
                        ColHead { text: "Low rank"; width: 380px; }
                        ColHead { text: "G rank"; width: 380px; }
                    }
                    for v[i] in ["Bherna", "Kokoto", "Pokke", "Yukumo"]: VerticalLayout {
                        Hairline { }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: v; width: 160px; vertical-alignment: center; }
                            PointsCell { value: Api.character.points-lr[i]; was: Api.character.was-lr[i]; key: "lr" + i; label: v + " low rank points"; }
                            PointsCell { value: Api.character.points-g[i]; was: Api.character.was-g[i]; key: "g" + i; label: v + " G rank points"; }
                        }
                    }
                }
            }
        }
    }
}
