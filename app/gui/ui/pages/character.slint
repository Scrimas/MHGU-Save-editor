import { LineEdit, ScrollView, Palette, ComboBox } from "std-widgets.slint";
import { Api, Tok, Card, Muted, ConfidenceTag, Confidence, SectionTitle, PageHeader, NumberBox, StagedBar, WasLine, ColHead, Hairline, TextLink } from "../common.slint";

// Label, control, then "was … Undo" when staged (or the hint). Only the exceptions carry
// a confidence tag (06); the page header states the rule.
component Field inherits Rectangle {
    in property <string> label;
    in property <Confidence> level: Confidence.confirmed;
    in property <string> hint;
    in property <string> was;
    in property <string> key;
    // why the game cannot produce the value, shown in red
    in property <string> warning;
    in property <bool> flash: Api.highlight != "" && Api.highlight == key;
    lay := VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: Tok.tight;
            alignment: start;
            height: 20px;
            Text { text: root.label; vertical-alignment: center; color: root.flash ? Tok.accent-text : Palette.foreground; }
            if root.level != Confidence.confirmed: ConfidenceTag { level: root.level; }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 32px;
            @children
        }
        if root.was != "": WasLine { was: root.was; key: root.key; }
        if root.hint != "" && root.was == "": Muted { text: root.hint; }
        if root.warning != "": Text { text: @tr("The game cannot make this: {}.", root.warning); color: Tok.bad; font-size: Tok.small; wrap: word-wrap; }
    }
    if root.was != "": StagedBar { x: -10px; y: 26px; height: 32px; }
}

// A card of a pair that sits side by side on a wide window: as wide as its grid cell
// (its fixed-width controls would cap it short of the edge), its content at the top when
// the other card of the row is taller.
component PairCard inherits Card {
    max-width: 100000px;
    VerticalLayout {
        alignment: start;
        @children
    }
}

// A table cell of Village points: field, then "was … Undo" beside it.
component PointsCell inherits Rectangle {
    in property <int> value;
    in property <string> was;
    in property <string> key;
    in property <string> label;
    width: 380px;
    height: 44px;
    HorizontalLayout {
        spacing: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        NumberBox {
            width: 220px;
            value: root.value;
            maximum: 20000;
            label: root.label;
            edited(v) => { Api.set-character(root.key, v); }
        }
        if root.was != "": VerticalLayout {
            alignment: center;
            WasLine { was: root.was; key: "points:" + root.key; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.was != "": StagedBar { x: -10px; y: 6px; height: 32px; }
}

// A count with its label and "was … Undo" beside it (quests completed, style use).
component CountCell inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <string> was;
    in property <string> key;
    width: 300px;
    height: 44px;
    HorizontalLayout {
        spacing: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        Text { text: root.label; width: 150px; vertical-alignment: center; }
        NumberBox { width: 110px; value: root.value; maximum: 9999; label: root.label; edited(v) => { Api.set-character(root.key, v); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.was != "": StagedBar { x: -10px; y: 6px; height: 32px; }
}

export component CharacterPage inherits Rectangle {
    property <string> cur-name: Api.character.name;
    changed cur-name => { name-edit.text = self.cur-name; }
    property <string> cur-greeting: Api.card.greeting;
    changed cur-greeting => { greeting-edit.text = self.cur-greeting; }
    // the width inside the page margins, less the scroll bar
    property <length> cw: root.width - 2 * Tok.margin - 12px;
    property <bool> pair1: cw >= hunter.min-width + progress.min-width + Tok.gap;
    property <bool> pair2: cw >= appearance.min-width + guild-card.min-width + Tok.gap;
    property <bool> pair3: cw >= village-points.min-width + styles.min-width + Tok.gap;
    ScrollView {
        VerticalLayout {
            padding: Tok.margin;
            padding-top: 16px;
            spacing: Tok.gap;
            alignment: start;
            PageHeader {
                title: @tr("Character");
                subtitle: @tr("Confirmed in game except where marked");
                staged: Api.page-counts[1];
            }
            // cards in pairs, side by side when both fit at their minimum width
            GridLayout {
              spacing: Tok.gap;
              hunter := PairCard {
                row: 0;
                col: 0;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    SectionTitle { text: @tr("Hunter"); }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 360px;
                            label: @tr("Name");
                            hint: @tr("Written to the save, the player record and the Guild Card.");
                            was: Api.character.was-name;
                            key: "name";
                            // staged when the field loses focus or on Enter (05)
                            name-edit := LineEdit {
                                text: Api.character.name;
                                accessible-label: @tr("Hunter name");
                                accepted(t) => { Api.set-name(t); }
                                changed has-focus => {
                                    if !self.has-focus && self.text != Api.character.name {
                                        Api.set-name(self.text);
                                    }
                                }
                            }
                        }
                        // HR and HR points are both editable; HR follows the points (H2.5)
                        Field {
                            width: 170px;
                            label: @tr("Hunter Rank");
                            hint: @tr("Follows HR points");
                            was: Api.character.was-hr;
                            key: "hr";
                            NumberBox { value: Api.character.hr; minimum: 1; maximum: 999; label: @tr("Hunter Rank"); edited(v) => { Api.set-character("hr", v); } }
                        }
                        Field {
                            width: 220px;
                            label: @tr("HR points");
                            was: Api.character.was-hr-points;
                            key: "hr-points";
                            NumberBox { value: Api.character.hr-points; maximum: 9999999; label: @tr("HR points"); edited(v) => { Api.set-character("hr-points", v); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 220px;
                            label: @tr("Zenny");
                            was: Api.character.was-funds;
                            key: "funds";
                            NumberBox { value: Api.character.funds; maximum: 9999999; label: @tr("Zenny"); edited(v) => { Api.set-character("funds", v); } }
                        }
                        Field {
                            width: 220px;
                            label: @tr("Wycademy points");
                            was: Api.character.was-wycademy;
                            key: "wycademy";
                            NumberBox { value: Api.character.wycademy; maximum: 9999999; label: @tr("Wycademy points"); edited(v) => { Api.set-character("wycademy", v); } }
                        }
                        Field {
                            width: 300px;
                            label: @tr("Play time");
                            was: Api.character.was-playtime;
                            key: "playtime";
                            NumberBox { width: 110px; value: Api.character.playtime-h; maximum: 9999; label: @tr("Hours played"); edited(v) => { Api.set-character("play-h", v); } }
                            Text { text: "h"; vertical-alignment: center; }
                            NumberBox { width: 100px; value: Api.character.playtime-m; maximum: 59; label: @tr("Minutes played"); edited(v) => { Api.set-character("play-m", v); } }
                            Text { text: "min"; vertical-alignment: center; }
                        }
                    }
                }
              }
              progress := PairCard {
                row: root.pair1 ? 0 : 1;
                col: root.pair1 ? 1 : 0;
                // beside the Hunter card, only as wide as its own content
                horizontal-stretch: root.pair1 ? 0 : 1;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    SectionTitle { text: @tr("Progress"); }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 140px;
                            label: @tr("Village ★");
                            was: Api.character.was-village-star;
                            key: "village-star";
                            NumberBox { value: Api.character.village-star; minimum: 1; maximum: 10; label: @tr("Village star level"); edited(v) => { Api.set-character("village-star", v); } }
                        }
                        Field {
                            width: 140px;
                            label: @tr("Hub ★");
                            was: Api.character.was-hub-star;
                            key: "hub-star";
                            NumberBox { value: Api.character.hub-star; maximum: 13; label: @tr("Hub star level"); edited(v) => { Api.set-character("hub-star", v); } }
                        }
                    }
                    Muted { text: @tr("The game raises star levels when every urgent quest of a level is cleared."); }
                }
              }
            }
            GridLayout {
              spacing: Tok.gap;
              appearance := PairCard {
                row: 0;
                col: 0;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Appearance"); vertical-alignment: center; }
                        ConfidenceTag { level: Confidence.derived; }
                        Text { text: @tr("As character creation sets it. Features and clothing are numbered as the game stores them.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    Field {
                        label: @tr("Body");
                        level: Confidence.derived;
                        hint: @tr("Some armour is made for one body type only: check what you wear after changing it.");
                        warning: Api.appearance.warn-gender;
                        was: Api.appearance.was-gender;
                        key: "gender";
                        ComboBox { width: 200px; model: [@tr("Type 1 (male)"), @tr("Type 2 (female)")]; current-index: Api.appearance.gender; selected => { Api.set-look("gender", self.current-index); } }
                    }
                    Field {
                        label: @tr("Face, hairstyle, voice");
                        level: Confidence.derived;
                        warning: Api.appearance.warn-appearance;
                        was: Api.appearance.was-appearance;
                        key: "appearance";
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: @tr("Face"); vertical-alignment: center; color: Tok.muted; }
                            ComboBox { width: 120px; model: Api.look-faces; current-index: Api.appearance.face; selected => { Api.set-look("face", self.current-index); } }
                            Rectangle { width: 14px; }
                            Text { text: @tr("Hairstyle"); vertical-alignment: center; color: Tok.muted; }
                            ComboBox { width: 120px; model: Api.look-hairstyles; current-index: Api.appearance.hair; selected => { Api.set-look("hair", self.current-index); } }
                            Rectangle { width: 14px; }
                            Text { text: @tr("Voice"); vertical-alignment: center; color: Tok.muted; }
                            ComboBox { width: 120px; model: Api.look-voices; current-index: Api.appearance.voice - 1; selected => { Api.set-look("voice", self.current-index + 1); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            width: 170px;
                            label: @tr("Features");
                            NumberBox { width: 110px; value: Api.appearance.features; maximum: 255; label: @tr("Features"); edited(v) => { Api.set-look("features", v); } }
                        }
                        Field {
                            width: 170px;
                            label: @tr("Clothing");
                            NumberBox { width: 110px; value: Api.appearance.clothing; maximum: 255; label: @tr("Clothing"); edited(v) => { Api.set-look("clothing", v); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        for c in Api.appearance.colours: Field {
                            width: 190px;
                            label: c.label;
                            Rectangle { width: 32px; height: 32px; border-radius: 4px; background: c.colour; border-width: 1px; border-color: Tok.input-border; }
                            LineEdit {
                                width: 110px;
                                text: c.hex;
                                accessible-label: c.label;
                                accepted(t) => { Api.set-look-colour(c.key, t); }
                            }
                        }
                    }
                }
              }
              guild-card := PairCard {
                row: root.pair2 ? 0 : 1;
                col: root.pair2 ? 1 : 0;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Guild Card"); vertical-alignment: center; }
                        Text { text: @tr("As the card editor in game sets them. Locked entries can be picked too: the card then says so.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    Field {
                        label: @tr("Title");
                        level: Confidence.derived;
                        hint: Api.card.title;
                        warning: Api.card.warn-title;
                        was: Api.card.was-title;
                        key: "card-title";
                        ComboBox { width: 220px; model: Api.gc-words; current-index: Api.card.word1; selected => { Api.set-card("word1", self.current-index); } }
                        ComboBox { width: 160px; model: Api.gc-links; current-index: Api.card.link; selected => { Api.set-card("link", self.current-index); } }
                        ComboBox { width: 220px; model: Api.gc-words; current-index: Api.card.word2; selected => { Api.set-card("word2", self.current-index); } }
                    }
                    Field {
                        width: 420px;
                        label: @tr("Greeting");
                        level: Confidence.derived;
                        was: Api.card.was-greeting;
                        key: "card-greeting";
                        // staged when the field loses focus or on Enter, like the name
                        greeting-edit := LineEdit {
                            text: Api.card.greeting;
                            accessible-label: @tr("Guild Card greeting");
                            accepted(t) => { Api.set-greeting(t); }
                            changed has-focus => {
                                if !self.has-focus && self.text != Api.card.greeting {
                                    Api.set-greeting(self.text);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Field {
                            label: @tr("Scene");
                            level: Confidence.derived;
                            warning: Api.card.warn-scene;
                            was: Api.card.was-scene;
                            key: "card-scene";
                            ComboBox { width: 260px; model: Api.gc-scenes; current-index: Api.card.scene; selected => { Api.set-card("scene", self.current-index); } }
                        }
                        Field {
                            label: @tr("Pose");
                            level: Confidence.derived;
                            warning: Api.card.warn-pose;
                            was: Api.card.was-pose;
                            key: "card-pose";
                            ComboBox { width: 220px; model: Api.gc-poses; current-index: Api.card.pose; selected => { Api.set-card("pose", self.current-index); } }
                        }
                    }
                }
              }
            }
            GridLayout {
              spacing: Tok.gap;
              village-points := PairCard {
                row: 0;
                col: 0;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Village points"); vertical-alignment: center; }
                        Text { text: @tr("The game adds Low rank and G rank and caps the sum at 20,000.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                    }
                    // the eight values as a 4 × 2 table (H2.2, B5)
                    HorizontalLayout {
                        height: 28px;
                        alignment: start;
                        ColHead { text: @tr("Village"); width: 160px; }
                        ColHead { text: @tr("Low rank"); width: 380px; }
                        ColHead { text: @tr("G rank"); width: 380px; }
                    }
                    for v[i] in [@tr("Bherna"), @tr("Kokoto"), @tr("Pokke"), @tr("Yukumo")]: VerticalLayout {
                        Hairline { }
                        HorizontalLayout {
                            alignment: start;
                            Text { text: v; width: 160px; vertical-alignment: center; }
                            PointsCell { value: Api.character.points-lr[i]; was: Api.character.was-lr[i]; key: "lr" + i; label: @tr("{} low rank points", v); }
                            PointsCell { value: Api.character.points-g[i]; was: Api.character.was-g[i]; key: "g" + i; label: @tr("{} G rank points", v); }
                        }
                    }
                }
              }
              styles := PairCard {
                row: root.pair3 ? 0 : 1;
                col: root.pair3 ? 1 : 0;
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Hunting styles"); vertical-alignment: center; }
                        Text { text: @tr("Quests done with each style. Your Palico's lines name the most and least used.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    for name[k] in [@tr("Guild Style"), @tr("Striker Style"), @tr("Aerial Style"), @tr("Adept Style"), @tr("Alchemy Style"), @tr("Valor Style")]: VerticalLayout {
                        Hairline { }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 14px;
                            CountCell { label: name; value: Api.character.style-use[k]; was: Api.character.was-style[k]; key: "style:" + k; }
                            if Api.character.was-style[k] != "": VerticalLayout {
                                alignment: center;
                                WasLine { was: Api.character.was-style[k]; key: "style:" + k; }
                            }
                        }
                    }
                }
              }
            }
            Card {
                VerticalLayout {
                    padding: Tok.pad;
                    padding-left: 22px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: Tok.gap;
                        alignment: start;
                        SectionTitle { text: @tr("Weapon usage"); vertical-alignment: center; }
                        Text { text: @tr("Quests completed with each weapon, as the Guild Card counts them. The largest total is the main weapon.");color: Tok.muted; font-size: Tok.small; vertical-alignment: center; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        height: 28px;
                        alignment: start;
                        ColHead { text: @tr("Weapon"); width: 180px; }
                        for v in [@tr("Village"), @tr("Hub"), @tr("Arena")]: ColHead { text: v; width: 200px; }
                        ColHead { text: @tr("All"); width: 80px; }
                    }
                    for w in Api.character.weapon-use: VerticalLayout {
                        Hairline { }
                        HorizontalLayout {
                            alignment: start;
                            height: 44px;
                            Text { text: w.name + (w.main ? "  ★" : ""); width: 180px; vertical-alignment: center; font-weight: w.main ? 600 : 400; }
                            for c[v] in w.counts: Rectangle {
                                width: 200px;
                                if w.was[v] != "": StagedBar { x: -10px; y: 6px; height: 32px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    NumberBox {
                                        width: 110px;
                                        value: c;
                                        maximum: 9999;
                                        label: @tr("{} quests, {}", w.name, [@tr("Village"), @tr("Hub"), @tr("Arena")][v]);
                                        edited(x) => { Api.set-character("use:" + v + ":" + w.index, x); }
                                    }
                                    if w.was[v] != "": VerticalLayout {
                                        alignment: center;
                                        WasLine { was: w.was[v]; key: "use:" + v + ":" + w.index; }
                                    }
                                }
                            }
                            Text { text: w.total; width: 80px; vertical-alignment: center; color: Tok.muted; }
                        }
                    }
                }
            }
        }
    }
}
