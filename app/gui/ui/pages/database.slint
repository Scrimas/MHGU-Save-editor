export component DatabasePage inherits Rectangle {
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Database");
            subtitle: @tr("The game's own data, next to this save. Nothing on this page is edited.");
        }
        TabBar {
            tabs: [@tr("Monsters"), @tr("Quests"), @tr("Items"), @tr("Skills"), @tr("Equipment")];
            current: Api.db-tab;
            // each tab starts unfiltered
            select(i) => {
                Api.db-tab = i;
                Api.db-search = "";
                Api.db-missing = false;
                Api.filter-db();
            }
        }
        if Api.db-tab == 0: MonsterTab { vertical-stretch: 1; }
        if Api.db-tab == 1: QuestTab { vertical-stretch: 1; }
        if Api.db-tab == 2: ItemTab { vertical-stretch: 1; }
        if Api.db-tab == 3: SkillTab { vertical-stretch: 1; }
        if Api.db-tab == 4: EquipTab { vertical-stretch: 1; }
    }
}
