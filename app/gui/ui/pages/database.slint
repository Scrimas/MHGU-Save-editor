import { ListView, ScrollView, ComboBox } from "std-widgets.slint";
import {
    Api, Tok, Card, Asset, Muted, SectionTitle, PageHeader, Chip, TabBar, ListRow, SearchField, EmptyState,
    Pill, TextLink, Hairline, ConfidenceTag, Confidence, DbMonster, CrownOdds, DropTable, DbRow, DbQuest, DbItem, DbSkill, DbLine, DbEquip,
} from "../common.slint";

// Crown tints as on the Monsters page.
global Crown {
    out property <color> gold: Tok.dark ? #e2b93b : #8a6100;
    out property <color> silver: Tok.dark ? #c3ccd4 : #4f5b66;
}

// The size % line: the save's record as a band, the crown thresholds as marks.
component SizeScale inherits VerticalLayout {
    in property <DbMonster> m;
    property <float> span: max(1, m.hi - m.lo);
    pure function at(v: int, w: length) -> length {
        return w * clamp((v - m.lo) / span, 0, 1);
    }
    spacing: 4px;
    Rectangle {
        height: 16px;
        for t in [{ v: m.mini-le, c: Tok.accent-text }, { v: m.silver-ge, c: Crown.silver }, { v: m.gold-ge, c: Crown.gold }]: Text {
            x: root.at(t.v, parent.width) - self.width / 2;
            text: t.v;
            color: t.c;
            font-size: Tok.small;
        }
    }
    Rectangle {
        height: 24px;
        border-radius: 4px;
        background: Tok.track;
        accessible-role: text;
        accessible-label: m.max > 0 ? @tr("Your record: {}–{} %", m.min, m.max) : @tr("No record yet");
        if m.max > 0: Rectangle {
            x: root.at(m.min, parent.width);
            width: max(3px, root.at(m.max, parent.width) - self.x);
            border-radius: 4px;
            border-width: 1px;
            border-color: Tok.accent;
            background: Tok.accent-soft;
        }
        for t in [{ v: m.mini-le, c: Tok.accent-text }, { v: m.silver-ge, c: Crown.silver }, { v: m.gold-ge, c: Crown.gold }]: Rectangle {
            x: root.at(t.v, parent.width) - 1px;
            y: -3px;
            width: 2px;
            height: parent.height + 6px;
            background: t.c;
        }
    }
    HorizontalLayout {
        Text { text: m.lo + " %"; color: Tok.muted; font-size: Tok.small; horizontal-stretch: 1; }
        Text { text: @tr("mini ≤ {} %", m.mini-le); color: Tok.accent-text; font-size: Tok.small; horizontal-stretch: 1; horizontal-alignment: center; }
        Text { text: @tr("silver ≥ {} %", m.silver-ge); color: Crown.silver; font-size: Tok.small; horizontal-stretch: 1; horizontal-alignment: center; }
        Text { text: @tr("gold ≥ {} %", m.gold-ge); color: Crown.gold; font-size: Tok.small; horizontal-stretch: 1; horizontal-alignment: center; }
        Text { text: m.hi + " %"; color: Tok.muted; font-size: Tok.small; horizontal-stretch: 1; horizontal-alignment: right; }
    }
}

// One crown's chance per quest, best first.
component OddsList inherits VerticalLayout {
    in property <string> title;
    in property <bool> earned;
    in property <color> tint;
    in property <string> note;
    in property <[CrownOdds]> rows;
    in property <string> more;
    spacing: 4px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text { text: root.title; font-weight: 600; vertical-alignment: center; }
        Pill { text: root.earned ? @tr("Earned") : @tr("Missing"); tint: root.earned ? Tok.ok : Tok.bad; }
    }
    Muted { text: root.note; }
    // the bar stays next to its quest on a wide page
    for o in root.rows: HorizontalLayout {
        height: 40px;
        spacing: 12px;
        alignment: start;
        accessible-role: text;
        accessible-label: o.quest + ", " + o.label;
        VerticalLayout {
            width: clamp(root.width - 236px, 160px, 420px);
            alignment: center;
            Text { text: o.quest; overflow: elide; }
            Text { text: o.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
        Rectangle {
            width: 160px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                border-radius: 3px;
                background: Tok.track;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(o.chance, 0, 1);
                    border-radius: 3px;
                    background: root.tint;
                }
            }
        }
        Text { width: 52px; text: o.label; horizontal-alignment: right; vertical-alignment: center; }
    }
    if root.more != "": Muted { text: root.more; }
}

// Carve or reward tables side by side (at most 5); each item with its chance and what
// the item box holds.
component DropGrid inherits HorizontalLayout {
    in property <[DropTable]> tables;
    spacing: 24px;
    alignment: start;
    for t in root.tables: VerticalLayout {
        width: clamp((root.width - 24px * max(3, tables.length - 1)) / max(4, tables.length), 160px, 300px);
        spacing: 2px;
        alignment: start;
        Text { text: t.title; color: Tok.muted; font-size: Tok.small; height: 22px; overflow: elide; }
        for c in t.items: HorizontalLayout {
            height: 36px;
            spacing: 8px;
            accessible-role: text;
            accessible-label: c.name + ", " + c.chance + ", " + c.have;
            if Api.assets-ok: Asset { y: 6px; width: 24px; height: 24px; source: c.icon; available: c.has-icon; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: c.name; overflow: elide; }
                Text { text: c.have; color: Tok.muted; font-size: Tok.small; overflow: elide; }
            }
            Text { text: c.chance; horizontal-alignment: right; vertical-alignment: center; width: 44px; }
        }
    }
}

// A monster's carve tables of one rank, side by side.
component Carves inherits VerticalLayout {
    in property <DbMonster> m;
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SectionTitle { text: @tr("Carves"); }
        for r[i] in m.carve-ranks: Chip {
            text: r;
            active: i == m.carve-rank;
            clicked => { Api.select-db-rank(m.carve-ids[i]); }
        }
    }
    if m.carve-note != "": Muted { text: m.carve-note; }
    DropGrid { tables: m.carves; }
}

component MonsterDetail inherits VerticalLayout {
    property <DbMonster> m: Api.db-monster;
    padding: Tok.pad;
    padding-left: 22px;
    spacing: 14px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        if Api.assets-ok: Asset { width: 56px; height: 56px; source: m.icon; available: m.has-icon; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: m.name; font-size: 18px; font-weight: 600; overflow: elide; }
            Text { text: m.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            TextLink { text: @tr("Edit on the Monsters page"); clicked => { Api.show-in-editor("monster", m.index); } }
        }
    }
    Hairline { }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SectionTitle { text: @tr("Size"); }
        if m.mini: Pill { text: @tr("Mini"); tint: Tok.accent-text; }
        if m.crown == 1: Pill { text: @tr("Silver"); tint: Crown.silver; }
        if m.crown == 2: Pill { text: @tr("Gold"); tint: Crown.gold; }
    }
    if m.has-size && !m.fixed: SizeScale { m: root.m; }
    Muted { text: m.size-note; }
    if m.has-size && !m.fixed: Hairline { }
    if m.has-size && !m.fixed: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SectionTitle { text: @tr("Crown chances"); }
        ConfidenceTag { level: Confidence.derived; }
    }
    if m.has-size && !m.fixed: Muted {
        text: @tr("Chance that a quest's {} is crown size, from the size the quest gives it and the game's size variation tables. The size rolled is assumed to be rounded down.", m.name);
    }
    if m.has-size && !m.fixed: OddsList {
        title: @tr("Gold crown");
        earned: m.crown == 2;
        tint: Crown.gold;
        note: @tr("Size {} % or larger, best quests first.", m.gold-ge);
        rows: m.gold-odds;
        more: m.gold-more;
    }
    if m.has-size && !m.fixed: OddsList {
        title: @tr("Mini crown");
        earned: m.mini;
        tint: Tok.accent-text;
        note: @tr("Size {} % or smaller, best quests first.", m.mini-le);
        rows: m.mini-odds;
        more: m.mini-more;
    }
    Hairline { }
    if m.carve-ranks.length == 0: VerticalLayout {
        spacing: 8px;
        SectionTitle { text: @tr("Carves"); }
        Muted { text: @tr("The game has no carve table for it."); }
    }
    if m.carve-ranks.length > 0: Carves { m: root.m; }
}

component QuestDetail inherits VerticalLayout {
    property <DbQuest> q: Api.db-quest;
    padding: Tok.pad;
    padding-left: 22px;
    spacing: 14px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: q.name; font-size: 18px; font-weight: 600; overflow: elide; }
            Text { text: q.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            TextLink { text: @tr("Edit on the Quests page"); clicked => { Api.show-in-editor("quest", q.index); } }
        }
    }
    Hairline { }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SectionTitle { text: @tr("Monsters"); }
        if q.monsters.length > 0: ConfidenceTag { level: Confidence.derived; }
    }
    if q.monsters.length == 0: Muted { text: @tr("No large monster with a size in this quest."); }
    if q.monsters.length > 0: VerticalLayout {
        HorizontalLayout {
            height: 24px;
            spacing: 12px;
            Rectangle { width: Api.assets-ok ? 32px : 0px; }
            Text { text: @tr("Monster"); color: Tok.muted; font-size: Tok.small; horizontal-stretch: 1; }
            Text { text: @tr("Size"); color: Tok.muted; font-size: Tok.small; width: 70px; horizontal-alignment: right; }
            Text { text: @tr("Can be"); color: Tok.muted; font-size: Tok.small; width: 110px; horizontal-alignment: right; }
            Text { text: @tr("Gold crown"); color: Tok.muted; font-size: Tok.small; width: 100px; horizontal-alignment: right; }
            Text { text: @tr("Mini crown"); color: Tok.muted; font-size: Tok.small; width: 100px; horizontal-alignment: right; }
            Rectangle { width: 70px; }
        }
        for e in q.monsters: HorizontalLayout {
            height: 40px;
            spacing: 12px;
            accessible-role: text;
            accessible-label: e.name + ", " + e.size + ", " + e.range;
            if Api.assets-ok: Asset { y: 4px; width: 32px; height: 32px; source: e.icon; available: e.has-icon; }
            Text { text: e.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: e.size; vertical-alignment: center; width: 70px; horizontal-alignment: right; }
            Text { text: e.range; vertical-alignment: center; width: 110px; horizontal-alignment: right; color: Tok.muted; }
            Text { text: e.gold; vertical-alignment: center; width: 100px; horizontal-alignment: right; color: Crown.gold; }
            Text { text: e.mini; vertical-alignment: center; width: 100px; horizontal-alignment: right; color: Tok.accent-text; }
            Rectangle {
                width: 70px;
                TextLink {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    text: @tr("Details");
                    clicked => { Api.open-db("monster", e.index); }
                }
            }
        }
    }
    Hairline { }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SectionTitle { text: @tr("Rewards"); }
        if q.rewards.length > 0: ConfidenceTag { level: Confidence.derived; }
    }
    Muted { text: q.note; }
    DropGrid { tables: q.rewards; }
}

component ItemDetail inherits VerticalLayout {
    property <DbItem> it: Api.db-item;
    padding: Tok.pad;
    padding-left: 22px;
    spacing: 14px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        if Api.assets-ok: Asset { width: 48px; height: 48px; source: it.icon; available: it.has-icon; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: it.name; font-size: 18px; font-weight: 600; overflow: elide; }
            Text { text: it.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
    }
    Hairline { }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SectionTitle { text: @tr("Where to get it"); }
    }
    if it.sources.length == 0: Muted { text: @tr("No carve or quest reward gives it. It may come from gathering, the shops or crafting, which are not in the Database yet."); }
    if it.sources.length > 0: VerticalLayout {
        HorizontalLayout {
            height: 24px;
            spacing: 12px;
            Rectangle { width: Api.assets-ok ? 32px : 0px; }
            Text { text: @tr("From"); color: Tok.muted; font-size: Tok.small; horizontal-stretch: 1; }
            Text { text: @tr("How"); color: Tok.muted; font-size: Tok.small; width: 260px; }
            Text { text: @tr("Chance"); color: Tok.muted; font-size: Tok.small; width: 70px; horizontal-alignment: right; }
            Rectangle { width: 70px; }
        }
        for s in it.sources: HorizontalLayout {
            height: 40px;
            spacing: 12px;
            accessible-role: text;
            accessible-label: s.where + ", " + s.how + ", " + s.chance;
            Rectangle {
                width: Api.assets-ok ? 32px : 0px;
                if Api.assets-ok: Asset { y: 4px; width: 32px; height: 32px; source: s.icon; available: s.has-icon; }
            }
            Text { text: s.where; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: s.how; vertical-alignment: center; width: 260px; color: Tok.muted; overflow: elide; }
            Text { text: s.chance; vertical-alignment: center; width: 70px; horizontal-alignment: right; }
            Rectangle {
                width: 70px;
                TextLink {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    text: @tr("Details");
                    clicked => { Api.open-db(s.kind, s.index); }
                }
            }
        }
        if it.more != "": Muted { text: it.more; }
    }
}

// A titled list of lines: icon, name and second line, value at the right. A line with a
// link opens that `link-kind` entry.
component LineList inherits VerticalLayout {
    in property <string> title;
    in property <string> empty;
    in property <[DbLine]> lines;
    in property <string> more;
    in property <string> link-kind;
    spacing: 2px;
    SectionTitle { text: root.title; height: 30px; }
    if root.lines.length == 0: Muted { text: root.empty; }
    for l in root.lines: HorizontalLayout {
        height: l.sub == "" ? 32px : 40px;
        spacing: 10px;
        accessible-role: text;
        accessible-label: l.name + ", " + l.value;
        if Api.assets-ok && l.has-icon: Asset { y: (parent.height - 28px) / 2; width: 28px; height: 28px; source: l.icon; available: true; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            if l.link <= 0: Text { text: l.name; overflow: elide; }
            // in a layout of its own, so its fixed width does not narrow the column
            if l.link > 0: HorizontalLayout {
                alignment: start;
                TextLink { text: l.name; font-size: Tok.body; clicked => { Api.open-db(root.link-kind, l.link); } }
            }
            if l.sub != "": Text { text: l.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
        Text { text: l.value; vertical-alignment: center; horizontal-alignment: right; width: 90px; }
    }
    if root.more != "": Muted { text: root.more; }
}

component EquipDetail inherits VerticalLayout {
    property <DbEquip> e: Api.db-equip;
    padding: Tok.pad;
    padding-left: 22px;
    spacing: 14px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        if Api.assets-ok: Asset { width: 48px; height: 48px; source: e.icon; available: e.has-icon; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: e.name; font-size: 18px; font-weight: 600; overflow: elide; }
            Text { text: e.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
    }
    Hairline { }
    SectionTitle { text: @tr("Making it"); }
    if e.make.length == 0: Muted { text: @tr("The Smithy neither forges it nor upgrades anything into it."); }
    DropGrid { tables: e.make; }
    if e.note != "": Muted { text: e.note; }
    if e.tree.length > 0: Hairline { }
    if e.tree.length > 0: LineList {
        width: min(root.width - 44px, 520px);
        title: @tr("Upgrade tree");
        lines: e.tree;
        link-kind: "equip";
    }
    if e.levels.length > 0: Hairline { }
    if e.levels.length > 0: SectionTitle { text: @tr("Levels"); }
    for row in e.levels: DropGrid { tables: row.tables; }
}

component SkillDetail inherits VerticalLayout {
    property <DbSkill> k: Api.db-skill;
    padding: Tok.pad;
    padding-left: 22px;
    spacing: 14px;
    alignment: start;
    VerticalLayout {
        Text { text: k.name; font-size: 18px; font-weight: 600; overflow: elide; }
        Text { text: k.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
    }
    Hairline { }
    HorizontalLayout {
        spacing: 32px;
        alignment: start;
        LineList {
            width: clamp((root.width - 76px) / 2, 260px, 460px);
            title: @tr("Skills");
            empty: @tr("No skill.");
            lines: k.tiers;
        }
        LineList {
            width: clamp((root.width - 76px) / 2, 260px, 460px);
            title: @tr("Talismans");
            empty: @tr("No talisman rolls it.");
            lines: k.charms;
        }
    }
    Hairline { }
    HorizontalLayout {
        spacing: 32px;
        alignment: start;
        LineList {
            width: clamp((root.width - 76px) / 2, 260px, 460px);
            title: @tr("Decorations");
            empty: @tr("No decoration gives it.");
            lines: k.decos;
            more: k.decos-more;
        }
        LineList {
            width: clamp((root.width - 76px) / 2, 260px, 460px);
            title: @tr("Armor");
            empty: @tr("No armor piece gives it.");
            lines: k.armor;
            more: k.armor-more;
        }
    }
}

// A tab's list: search, one filter chip, the entries (index = what select-db takes).
component EntryColumn inherits VerticalLayout {
    in property <[DbRow]> rows;
    in property <int> selected;
    in property <string> search;
    in property <string> filter;
    in property <string> empty;
    in property <bool> icons;
    // a list of kinds to pick from first (Equipment tab)
    in property <[string]> kinds;
    spacing: Tok.tight;
    if root.kinds.length > 0: ComboBox {
        model: root.kinds;
        current-index: Api.db-equip-kind;
        selected => { Api.select-db-kind(self.current-index); }
    }
    SearchField {
        placeholder-text: root.search;
        text <=> Api.db-search;
        edited => { Api.filter-db(); }
    }
    HorizontalLayout {
        alignment: start;
        Chip {
            text: root.filter;
            active: Api.db-missing;
            clicked => {
                Api.db-missing = !Api.db-missing;
                Api.filter-db();
            }
        }
    }
    Card {
        vertical-stretch: 1;
        if root.rows.length == 0: EmptyState { text: root.empty; }
        ListView {
            // an entry opened from another page is scrolled into view; the row can arrive
            // after the list is made
            property <int> shown: Api.db-row;
            function go() {
                if self.content-y > -(shown * 52px) || self.content-y < -(shown * 52px) + 52px - self.visible-height {
                    self.content-y = -max(0px, shown * 52px - self.visible-height / 3);
                }
            }
            init => { self.go(); }
            changed shown => { self.go(); }
            for r in root.rows: ListRow {
                height: 52px;
                selected: r.index == root.selected;
                accessible-label: r.name;
                clicked => { Api.select-db(r.index); }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    if root.icons && Api.assets-ok: Asset { y: 8px; width: 36px; height: 36px; source: r.icon; available: r.has-icon; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: r.name; overflow: elide; }
                        Text { text: r.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
                    }
                }
            }
        }
    }
}

component MonsterTab inherits HorizontalLayout {
    spacing: Tok.pad;
    EntryColumn {
        width: min(320px, root.width * 0.36);
        rows: Api.db-monsters;
        selected: Api.db-monster.index;
        search: @tr("Search monsters");
        filter: @tr("Missing a crown");
        empty: @tr("No monster matches.");
        icons: true;
    }
    Card {
        horizontal-stretch: 1;
        if Api.db-monster.index <= 0: EmptyState { text: @tr("Pick a monster."); }
        if Api.db-monster.index > 0: ScrollView {
            MonsterDetail { }
        }
    }
}

