import { ListView, CheckBox, Button, Palette, LineEdit } from "std-widgets.slint";
import {
    Api, Tabs, Tok, Card, Muted, Chip, Asset, PageHeader, TabBar, ColHead, NumberBox, StagedBar, WasLine, Hairline,
    EmptyState, PreviewPopup, MoreButton, CheckRow, SearchField, Settle, ConfidenceTag, Confidence,
} from "../common.slint";

// A deviant's permit point count with "was … Undo" under it.
component PointsCell inherits VerticalLayout {
    in property <int> value;
    in property <string> was;
    in property <string> key;
    in property <string> label;
    callback edited(int);
    width: 150px;
    alignment: center;
    spacing: 2px;
    NumberBox { width: 100px; minimum: 0; maximum: 9999; value: root.value; label: root.label; edited(v) => { root.edited(v); } }
    if root.was != "": WasLine { was: root.was; key: root.key; }
}

// Checkbox, icon, name: the order of the in-game lists (H5.4); long names elide (H5.2).
component CheckCell inherits Rectangle {
    in property <CheckRow> r;
    in property <bool> flash;
    height: 40px;
    border-radius: 4px;
    background: root.flash ? Tok.accent-soft : ta.has-hover ? Tok.hover : transparent;
    ta := TouchArea { clicked => { Api.set-check(r.key, !r.on); } }
    if r.changed: StagedBar { x: 0; y: 6px; height: parent.height - 12px; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 8px;
        Rectangle {
            width: 28px;
            CheckBox { x: 0; checked: r.on; accessible-label: r.name; toggled => { Api.set-check(r.key, self.checked); } }
        }
        if r.has-icon: Asset { y: 6px; width: 28px; height: 28px; source: r.icon; available: true; opacity: r.on ? 1 : 0.45; }
        Text { text: r.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: r.on ? Palette.foreground : Tok.muted; }
    }
}

export component CollectionsPage inherits Rectangle {
    property <length> cw: root.width - 2 * Tok.margin;
    // grid columns as the width gives (cells of at least 270 px); Hunter Arts in side by
    // side groups of at least 400 px, so the checks stay near the art's name
    property <int> cols: max(1, floor((cw - 12px) / 270px));
    property <int> art-cols: max(1, floor(cw / 400px));
    settle := Settle { key: root.cols; }
    art-settle := Settle { key: root.art-cols; }
    property <bool> checks: Api.collection-tab < 4;
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Collections");
            subtitle: Api.checks-summary;
            staged: Api.page-counts[7];
            if root.checks: Button {
                text: @tr("Check all…");
                clicked => { pv.open("checks:all", self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height); }
            }
            if root.checks: MoreButton {
                items: [@tr("Uncheck all…")];
                activated => { pv.open("checks:none", self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height); }
            }
            if !root.checks: Button {
                text: @tr("All levels…");
                clicked => { pv.open("deviants:levels", self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height); }
            }
            if !root.checks: Button {
                text: @tr("Max permits…");
                clicked => { pv.open("deviants:permits", self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height); }
            }
        }
        // the count in each tab (H5.1)
        TabBar { tabs: Api.collection-tabs; current: Api.collection-tab; select(i) => { Tabs.select("collections", i); } }
        HorizontalLayout {
            spacing: Tok.tight;
            SearchField {
                placeholder-text: @tr("Search");
                text <=> Api.check-search;
                edited => { Api.filter-checks(); }
            }
            Chip {
                y: 2px;
                text: @tr("Missing only");
                active: Api.check-missing;
                clicked => {
                    Api.check-missing = !Api.check-missing;
                    Api.filter-checks();
                }
            }
        }
        // Hunter Arts by art, levels I / II / III on one row (H5.3), in side by side groups
        // on a wide window, read across like the grids
        if Api.collection-tab == 0: Card {
            vertical-stretch: 1;
            opacity: art-settle.o;
            VerticalLayout {
                Rectangle {
                    height: 34px;
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        for g in root.art-cols: HorizontalLayout {
                            width: (arts.visible-width - (root.art-cols - 1) * 16px) / root.art-cols;
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 10px;
                            ColHead { text: @tr("Hunter Art"); horizontal-stretch: 1; }
                            ColHead { text: "I"; width: 56px; }
                            ColHead { text: "II"; width: 56px; }
                            ColHead { text: "III"; width: 56px; }
                        }
                    }
                    Hairline { y: parent.height - 1px; width: parent.width; }
                }
                if Api.arts.length == 0: EmptyState { text: Api.check-missing ? @tr("Every Hunter Art is unlocked.") : @tr("No art matches the search."); }
                arts := ListView {
                    for r in (Api.arts.length + root.art-cols - 1) / root.art-cols: Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            spacing: 16px;
                            for c in root.art-cols: Rectangle {
                                property <int> i: r * root.art-cols + c;
                                width: (arts.visible-width - (root.art-cols - 1) * 16px) / root.art-cols;
                                if i < Api.arts.length && Api.arts[i].changed: StagedBar { x: 2px; y: 7px; height: parent.height - 14px; }
                                if i < Api.arts.length: HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Text { text: Api.arts[i].name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    for k in 3: Rectangle {
                                        width: 56px;
                                        if k < Api.arts[i].ids.length: CheckBox {
                                            x: 0;
                                            checked: Api.arts[i].on[k];
                                            accessible-label: Api.arts[i].name + (Api.arts[i].ids.length == 1 ? "" : k == 0 ? " I" : k == 1 ? " II" : " III");
                                            toggled => { Api.set-check(Api.arts[i].ids[k], self.checked); }
                                        }
                                    }
                                }
                            }
                        }
                        Hairline { y: parent.height - 1px; width: parent.width; }
                    }
                }
            }
        }
        if Api.collection-tab >= 1 && Api.collection-tab <= 3: Card {
            vertical-stretch: 1;
            if Api.checks.length == 0: EmptyState { text: Api.check-missing ? @tr("Nothing is missing here.") : @tr("Nothing matches the search."); }
            grid := ListView {
                opacity: settle.o;
                property <int> seq: Api.jump-seq;
                function go() {
                    if Api.page == "collections" && Api.jump-row >= 0 {
                        self.content-y = -max(0, floor(Api.jump-row / root.cols) - 2) * 40px;
                    }
                }
                init => { self.go(); }
                changed seq => { self.go(); }
                for r in (Api.checks.length + root.cols - 1) / root.cols: HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 6px;
                    height: 40px;
                    for c in root.cols: Rectangle {
                        width: (grid.visible-width - 12px - (root.cols - 1) * 6px) / root.cols;
                        if r * root.cols + c < Api.checks.length: CheckCell {
                            r: Api.checks[r * root.cols + c];
                            flash: Api.highlight != "" && Api.highlight == "check:" + Api.collection-tab + ":" + self.r.key;
                        }
                    }
                }
            }
        }
        // Deviants as a table with column headers (H5.5)
        if Api.collection-tab == 4: HorizontalLayout {
            vertical-stretch: 1;
            alignment: start;
            Card {
                width: min(root.width - 2 * Tok.margin, Tok.row-max);
                VerticalLayout {
                    Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 12px;
                            Rectangle { width: Api.assets-ok ? 40px : 0px; }
                            ColHead { text: @tr("Deviant"); horizontal-stretch: 1; }
                            ColHead { text: @tr("Special Permits"); width: 150px; }
                            HorizontalLayout {
                                width: 312px;
                                spacing: Tok.tight;
                                alignment: start;
                                ColHead { text: @tr("Permit points · at the Courier"); }
                                ConfidenceTag { level: Confidence.derived; y: 8px; }
                            }
                            ColHead { text: @tr("Levels cleared"); width: 260px; }
                        }
                        Hairline { y: parent.height - 1px; width: parent.width; }
                    }
                    if Api.deviants.length == 0: EmptyState { text: Api.check-missing ? @tr("Every deviant has every level cleared.") : @tr("No deviant matches the search."); }
                    ListView {
                        for d in Api.deviants: Rectangle {
                            height: d.gate != "" ? 76px : 60px;
                            if d.was-permits != "" || d.was-levels != "" || d.was-points != "" || d.was-waiting != "": StagedBar { x: 2px; y: 8px; height: parent.height - 16px; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 12px;
                                Rectangle {
                                    width: Api.assets-ok ? 40px : 0px;
                                    Asset { y: 10px; width: 40px; height: 40px; source: d.icon; available: d.has-icon; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: d.name; overflow: elide; }
                                    if d.gate != "": Text { text: d.gate; color: Tok.warn; font-size: Tok.small; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    width: 150px;
                                    alignment: center;
                                    spacing: 2px;
                                    NumberBox { width: 100px; minimum: 0; maximum: 99; value: d.permits; label: @tr("Special Permits of {}", d.name); edited(v) => { Api.set-deviant(d.index, "permits", v); } }
                                    if d.was-permits != "": WasLine { was: d.was-permits; key: "permits:" + d.index; }
                                }
                                PointsCell {
                                    value: d.points;
                                    was: d.was-points;
                                    key: "permit-points:" + d.index;
                                    label: @tr("Special Permit points of {}", d.name);
                                    edited(v) => { Api.set-deviant(d.index, "points", v); }
                                }
                                PointsCell {
                                    value: d.waiting;
                                    was: d.was-waiting;
                                    key: "permit-wait:" + d.index;
                                    label: @tr("Points of {} waiting at the Courier", d.name);
                                    edited(v) => { Api.set-deviant(d.index, "waiting", v); }
                                }
                                VerticalLayout {
                                    width: 260px;
                                    alignment: center;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        NumberBox { width: 100px; minimum: 0; maximum: d.total; value: d.levels; label: @tr("Levels cleared of {}", d.name); edited(v) => { Api.set-deviant(d.index, "levels", v); } }
                                        Text { text: "/ " + d.total; color: Tok.muted; vertical-alignment: center; }
                                    }
                                    if d.was-levels != "": WasLine { was: d.was-levels; key: "levels:" + d.index; }
                                }
                            }
                            Hairline { y: parent.height - 1px; width: parent.width; }
                        }
                    }
                }
            }
        }
    }
    pv := PreviewPopup { x: 0; y: 0; page-width: root.width; }
}
