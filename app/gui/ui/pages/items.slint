import { LineEdit, ListView, Button, Palette } from "std-widgets.slint";
import {
    Api, Tok, Fmt, Card, Asset, Muted, ItemSlot, PageHeader, TabBar, NumberBox, StagedBar, WasLine, PreviewPopup,
    MoreButton, ListRow, EmptyState,
} from "../common.slint";

// One slot of the box grid: number, icon, name, count; staged slots show what they held.
component SlotCell inherits Rectangle {
    in property <ItemSlot> it;
    in property <bool> flash;
    callback edit();
    height: 44px;
    border-radius: 4px;
    background: root.flash ? Tok.accent-soft : ta.has-hover ? Tok.hover : transparent;
    accessible-role: button;
    accessible-label: "Slot " + (it.slot + 1) + ": " + (it.id == 0 ? "empty" : it.name + " ×" + it.count);
    ta := TouchArea { clicked => { root.edit(); } }
    if it.changed: StagedBar { x: 0; y: 6px; height: parent.height - 12px; }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 10px;
        // slot numbers in the secondary text colour (L5)
        Text { text: it.slot + 1; width: 36px; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; horizontal-alignment: right; }
        Rectangle {
            width: 28px;
            if it.id != 0: Asset { y: 8px; width: 28px; height: 28px; source: it.icon; available: it.has-icon; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: it.id == 0 ? "Empty" : it.name; color: it.id == 0 ? Tok.faint : Palette.foreground; overflow: elide; }
            if it.was != "": Text { text: "was " + it.was; color: Tok.accent-text; font-size: Tok.small; overflow: elide; }
            // stacks above the item's carry limit (written by older versions or other tools)
            if it.was == "" && it.id != 0 && it.count > it.max: Text { text: "over the limit of " + it.max; color: Tok.bad; font-size: Tok.small; overflow: elide; }
        }
        Text { text: it.id == 0 ? "" : "×" + it.count; color: it.id != 0 && it.count > it.max ? Tok.bad : Palette.foreground; width: 36px; vertical-alignment: center; horizontal-alignment: right; }
    }
}

export component ItemsPage inherits Rectangle {
    property <int> cols: root.width >= 1150px ? 3 : 2;
    // slot editor: slot, the item picked, its count, what the slot holds now
    property <int> edit-slot: -1;
    property <int> edit-id;
    property <int> edit-count: 1;
    property <int> edit-max: 99;
    property <int> held-id;
    property <string> held;
    property <string> edit-was;
    property <string> pick-search;
    property <length> pick-x;
    property <length> pick-y;
    property <length> pick-w: min(440px, root.width - 16px);
    property <length> pick-h: min(540px, root.height - 16px);
    // the editor fills a loadout position instead of a box or pouch slot
    property <bool> loadout-mode;
    function open-editor(it: ItemSlot, x: length, y: length) {
        root.open-at(it.slot, it.id, it.count, it.max, it.name, it.was, x, y);
    }
    function open-at(slot: int, id: int, count: int, max: int, name: string, was: string, x: length, y: length) {
        root.loadout-mode = Api.item-store == 2;
        root.edit-slot = slot;
        root.edit-id = id;
        root.held-id = id;
        root.edit-max = id == 0 ? 99 : max;
        root.edit-count = id == 0 ? 1 : min(count, max);
        root.held = id == 0 ? "Empty" : name + " ×" + count;
        root.edit-was = was;
        Api.search-picker("");
        root.pick-search = "";
        root.pick-x = clamp(x, 8px, root.width - root.pick-w - 8px);
        root.pick-y = clamp(y, 8px, root.height - root.pick-h - 8px);
        picker.show();
    }
    function commit(id: int, count: int) {
        if root.loadout-mode {
            Api.set-loadout-item(root.edit-slot, id, count);
        } else {
            Api.set-item(root.edit-slot, id, count);
        }
        picker.close();
    }
    function pick(id: int, max: int) {
        if root.edit-id != id {
            root.edit-id = id;
            root.edit-max = max;
            root.edit-count = id == root.held-id ? min(root.edit-count, max) : 1;
        }
    }
    function bulk(id: string, b: length, r: length) {
        pv.open(id, r, b);
    }
    property <string> popup-request: Api.snapshot-popup;
    changed popup-request => {
        if popup-request == "item-picker" && Api.item-slots.length > 0 {
            Api.snapshot-popup = "";
            root.open-editor(Api.item-slots[0], 260px, 200px);
        }
    }
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: "Items";
            subtitle: Api.item-store == 2 ? "Item loadouts · confirmed in game except where marked" : Fmt.num(Api.item-used) + " / " + Fmt.num(Api.item-total) + " slots used · confirmed in game except where marked";
            staged: Api.page-counts[2];
            // the first empty slot, like the Equipment page's Add
            if Api.item-store < 2: Button {
                text: "Add item";
                enabled: Api.item-free >= 0;
                clicked => { root.open-at(Api.item-free, 0, 0, 99, "", "", self.absolute-position.x - root.absolute-position.x + self.width - root.pick-w, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
            }
            if Api.item-store < 2: Button {
                text: "Sort & merge…";
                clicked => { root.bulk("items:sort", self.absolute-position.y - root.absolute-position.y + self.height, self.absolute-position.x - root.absolute-position.x + self.width); }
            }
            if Api.item-store < 2: Button {
                text: "Max counts…";
                clicked => { root.bulk("items:max", self.absolute-position.y - root.absolute-position.y + self.height, self.absolute-position.x - root.absolute-position.x + self.width); }
            }
            // the most destructive action of the app sits behind More… (04)
            if Api.item-store < 2: MoreButton {
                items: [Api.item-store == 0 ? "Empty box…" : "Empty pouch…"];
                activated => { root.bulk("items:empty", self.absolute-position.y - root.absolute-position.y + self.height, self.absolute-position.x - root.absolute-position.x + self.width); }
            }
        }
        TabBar {
            tabs: ["Item box", "Pouch", "Loadouts"];
            current: Api.item-store;
            select(i) => {
                Api.item-store = i;
                Api.filter-items(Api.item-filter);
            }
        }
        if Api.item-store < 2: LineEdit {
            placeholder-text: Api.item-store == 0 ? "Search the item box" : "Search the pouch";
            text <=> Api.item-filter;
            edited(t) => { Api.filter-items(t); }
        }
        // the box as a grid, like the in-game box (09.2), capped so counts stay near names
        if Api.item-store < 2: HorizontalLayout {
          vertical-stretch: 1;
          alignment: start;
          Card {
            width: min(root.width - 2 * Tok.margin, 1180px);
            list := ListView {
                property <int> seq: Api.jump-seq;
                function go() {
                    if Api.page == "items" && Api.jump-row >= 0 {
                        self.content-y = -max(0, floor(Api.jump-row / root.cols) - 2) * 44px;
                    }
                }
                init => { self.go(); }
                changed seq => { self.go(); }
                for r in (Api.item-slots.length + root.cols - 1) / root.cols: HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 6px;
                    height: 44px;
                    for c in root.cols: Rectangle {
                        width: (list.visible-width - 12px - (root.cols - 1) * 6px) / root.cols;
                        if r * root.cols + c < Api.item-slots.length: SlotCell {
                            it: Api.item-slots[r * root.cols + c];
                            flash: Api.highlight != "" && Api.highlight == (Api.item-store == 0 ? "item:box:" : "item:pouch:") + self.it.slot;
                            edit => { root.open-editor(self.it, self.absolute-position.x - root.absolute-position.x, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
                        }
                    }
                }
            }
          }
        }
        if Api.item-store < 2 && Api.item-slots.length == 0: Muted { text: "No slot matches the search."; }
        // at most 24 rows (runs of empty loadouts collapse into one), so no virtualized
        // ListView: the card hugs its rows and scrolls only when the window is shorter
        if Api.item-store == 2: HorizontalLayout {
          vertical-stretch: 1;
          spacing: Tok.pad;
          VerticalLayout {
          width: min(420px, root.width * 0.4);
          alignment: start;
          Card {
            max-height: loadouts.preferred-height + 2px;
            Flickable {
              // the width of the card, so long summaries elide instead of scrolling sideways
              content-width: self.width;
              content-height: loadouts.preferred-height;
              loadouts := VerticalLayout {
                for l in Api.loadouts: ListRow {
                    two-line: l.used;
                    selected: l.first == Api.loadout-sel || (l.index < 0 && Api.loadout-sel >= l.first && Api.loadout-sel <= l.last);
                    accessible-role: list-item;
                    accessible-label: l.name;
                    clicked => { Api.select-loadout(l.first); }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        Text { text: l.index >= 0 ? l.index + 1 : ""; width: 28px; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Text { text: l.name; color: l.used ? Palette.foreground : Tok.faint; overflow: elide; }
                            if l.used: Muted { text: l.summary; wrap: no-wrap; overflow: elide; }
                        }
                    }
                }
              }
            }
          }
          }
          Card {
            horizontal-stretch: 1;
            if Api.loadout-sel < 0: EmptyState { text: "Pick a loadout to edit its name and items."; }
            if Api.loadout-sel >= 0: VerticalLayout {
                padding: Tok.pad;
                spacing: 10px;
                HorizontalLayout {
                    spacing: Tok.gap;
                    Text { text: "Loadout " + (Api.loadout-sel + 1); font-size: 18px; font-weight: 600; vertical-alignment: center; }
                    name-ed := LineEdit {
                        // follows the loadout picked, once typed into too
                        property <string> cur: Api.loadout-name;
                        changed cur => { self.text = self.cur; }
                        width: 240px;
                        text: Api.loadout-name;
                        placeholder-text: "Name";
                        accessible-label: "Loadout name";
                        accepted(t) => { Api.set-loadout-name(t); }
                        changed has-focus => {
                            if !self.has-focus && self.text != Api.loadout-name {
                                Api.set-loadout-name(self.text);
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if Api.loadout-was != "": WasLine { was: Api.loadout-was; key: "loadout:" + Api.loadout-sel; }
                Muted { text: "The 32 pouch positions the loadout fills, with the counts it takes from the box."; }
                // two columns like the box grid
                lv := ListView {
                    vertical-stretch: 1;
                    for r in 16: HorizontalLayout {
                        spacing: 6px;
                        height: 44px;
                        for c in 2: Rectangle {
                            width: (lv.visible-width - 6px) / 2;
                            SlotCell {
                                it: Api.loadout-slots[r * 2 + c];
                                edit => { root.open-editor(self.it, self.absolute-position.x - root.absolute-position.x, self.absolute-position.y - root.absolute-position.y + self.height + 4px); }
                            }
                        }
                    }
                }
            }
          }
        }
    }
    pv := PreviewPopup { x: 0; y: 0; page-width: root.width; }
    // slot editor (R10): pick the item, then the count, then Done; anchored to its slot
    picker := PopupWindow {
        x: root.pick-x;
        y: root.pick-y;
        width: root.pick-w;
        height: root.pick-h;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tok.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tok.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0007;
            VerticalLayout {
                padding: Tok.pad;
                spacing: 10px;
                HorizontalLayout {
                    spacing: Tok.tight;
                    Text {
                        text: (root.loadout-mode ? "Loadout " + (Api.loadout-sel + 1) + " · position " : Api.item-store == 0 ? "Item box slot " : "Pouch slot ") + (root.edit-slot + 1);
                        font-size: Tok.section;
                        font-weight: 600;
                        horizontal-stretch: 1;
                    }
                    Text { text: root.held; color: Tok.muted; vertical-alignment: center; overflow: elide; }
                }
                if root.edit-was != "" && !root.loadout-mode: WasLine { was: root.edit-was; key: (Api.item-store == 0 ? "item:box:" : "item:pouch:") + root.edit-slot; }
                LineEdit {
                    text <=> root.pick-search;
                    placeholder-text: "Search items";
                    edited(t) => { Api.search-picker(t); }
                    // Enter takes the first match
                    accepted => {
                        if Api.pick-items.length > 0 {
                            root.pick(Api.pick-items[0].id, Api.pick-items[0].max);
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for p in Api.pick-items: Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: p.id == root.edit-id ? Tok.accent-soft : pa.has-hover ? Tok.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: p.name;
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 10px;
                            Asset { width: 24px; height: 24px; y: 6px; source: p.icon; available: p.has-icon; }
                            Text { text: p.name; vertical-alignment: center; overflow: elide; font-weight: p.id == root.edit-id ? 600 : 400; }
                        }
                        pa := TouchArea {
                            clicked => { root.pick(p.id, p.max); }
                            double-clicked => {
                                root.pick(p.id, p.max);
                                root.commit(p.id, min(root.edit-count, p.max));
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text { text: "Count"; vertical-alignment: center; }
                    NumberBox {
                        width: 120px;
                        value: root.edit-count;
                        minimum: 1;
                        maximum: root.edit-max;
                        label: "Count";
                        enabled: root.edit-id != 0;
                        edited(v) => { root.edit-count = v; }
                    }
                    Text { text: Api.item-store == 0 && !root.loadout-mode ? "of 99" : "of " + root.edit-max + " (carry limit)"; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: Tok.tight;
                    if root.held-id != 0: Button {
                        text: root.loadout-mode ? "Empty position" : "Empty slot";
                        clicked => { root.commit(0, 0); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Cancel"; clicked => { picker.close(); } }
                    Button {
                        text: "Done";
                        primary: true;
                        enabled: root.edit-id != 0;
                        clicked => { root.commit(root.edit-id, root.edit-count); }
                    }
                }
            }
        }
    }
}
