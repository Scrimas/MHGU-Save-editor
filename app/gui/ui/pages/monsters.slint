import { LineEdit, CheckBox, SpinBox, ListView, Button, Palette } from "std-widgets.slint";
import { Api, Tok, Card, Asset, Muted, MonsterRow } from "../common.slint";

global Cols {
    in-out property <length> num: 96px;
}

component Num inherits SpinBox {
    width: Cols.num;
    minimum: 0;
    maximum: 9999;
}

component Crown inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 20px;
    width: t.preferred-width + 12px;
    border-radius: 10px;
    background: tint.transparentize(0.8);
    border-width: 1px;
    border-color: tint.transparentize(0.4);
    t := Text { text: root.text; font-size: 11px; color: Palette.foreground; }
}

component MonsterLine inherits Rectangle {
    in property <MonsterRow> m;
    height: 56px;
    background: m.changed ? Palette.accent-background.transparentize(0.9) : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Asset {
            width: 44px;
            height: 44px;
            y: 6px;
            source: m.icon;
            available: m.has-icon;
            kind: "MON";
            label: "#" + m.index;
        }
        VerticalLayout {
            alignment: center;
            min-width: 120px;
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: m.name; overflow: elide; font-weight: m.changed ? 600 : 400; vertical-alignment: center; }
                if m.mini: Crown { text: "Mini"; tint: #4aa3df; }
                if m.crown == 2: Crown { text: "Gold"; tint: #e2b93b; }
                if m.crown == 1: Crown { text: "Silver"; tint: #a8b3bd; }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: m.sub; color: Tok.muted; font-size: 11px; overflow: elide; }
        }
        Num {
            y: 10px; height: 36px;
            value: m.hunts;
            accessible-label: "Hunts of " + m.name;
            edited(v) => { Api.set-monster(m.index, "hunts", v); }
        }
        Num {
            y: 10px; height: 36px;
            value: m.captures;
            accessible-label: "Captures of " + m.name;
            edited(v) => { Api.set-monster(m.index, "captures", v); }
        }
        if m.has-size: Num {
            y: 10px; height: 36px;
            maximum: 200;
            value: m.min;
            accessible-label: "Smallest size of " + m.name;
            edited(v) => { Api.set-monster(m.index, "min", v); }
        }
        if m.has-size: Num {
            y: 10px; height: 36px;
            maximum: 200;
            value: m.max;
            accessible-label: "Largest size of " + m.name;
            edited(v) => { Api.set-monster(m.index, "max", v); }
        }
        if !m.has-size: Text { width: 2 * Cols.num + 8px; text: "no size record"; color: Tok.faint; vertical-alignment: center; horizontal-alignment: center; font-size: 12px; }
        Rectangle {
            width: 40px;
            if m.has-notes: CheckBox {
                checked: m.notes;
                accessible-label: "Hunter's Notes page of " + m.name;
                toggled => { Api.set-monster(m.index, "notes", self.checked ? 1 : 0); }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Tok.line; }
}

export component MonstersPage inherits Rectangle {
    changed width => { Cols.num = self.width < 720px ? 80px : 96px; }
    init => { Cols.num = self.width < 720px ? 80px : 96px; }
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                Text { text: "Monsters"; font-size: 22px; font-weight: 600; }
                Muted { text: Api.monster-summary; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Max hunts"; clicked => { Api.monsters-bulk("max-hunts"); } }
            Button { text: "Every crown"; clicked => { Api.monsters-bulk("crowns"); } }
        }
        HorizontalLayout {
            spacing: 12px;
            LineEdit {
                placeholder-text: "Search monsters";
                text <=> Api.monster-filter;
                edited(t) => { Api.filter-monsters(t, Api.monster-large-only); }
            }
            CheckBox {
                text: "Large monsters only";
                checked <=> Api.monster-large-only;
                toggled => { Api.filter-monsters(Api.monster-filter, self.checked); }
            }
        }
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle { width: 44px; }
                        Text { text: "Monster"; horizontal-stretch: 1; min-width: 120px; color: Tok.muted; font-size: 12px; vertical-alignment: center; }
                        Text { width: Cols.num; text: "Hunted"; color: Tok.muted; font-size: 12px; vertical-alignment: center; }
                        Text { width: Cols.num; text: "Captured"; color: Tok.muted; font-size: 12px; vertical-alignment: center; }
                        Text { width: Cols.num; text: "Smallest %"; color: Tok.muted; font-size: 12px; vertical-alignment: center; }
                        Text { width: Cols.num; text: "Largest %"; color: Tok.muted; font-size: 12px; vertical-alignment: center; }
                        Text { width: 40px; text: "Notes"; color: Tok.muted; font-size: 12px; vertical-alignment: center; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tok.line; }
                }
                ListView {
                    for m in Api.monsters: MonsterLine { m: m; }
                }
            }
        }
        Muted {
            text: "Hunted counts kills only; the game shows hunted + captured. Sizes are % of the base size; crowns follow the game's own thresholds for each monster. Every edit also rebuilds the Guild Card's monster log, which the crown awards read.";
            font-size: 11px;
        }
    }
}
