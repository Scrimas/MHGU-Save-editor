import { LineEdit, CheckBox, ListView, Button, Palette } from "std-widgets.slint";
import {
    Api, Tok, Card, Asset, Muted, MonsterRow, PageHeader, Chip, ColHead, InfoTip, NumberBox, WasLine,
    Hairline, EmptyState, PreviewPopup, Pill, ListRow, SearchField,
} from "../common.slint";

global Cols {
    out property <length> hunted: 130px;
    out property <length> size: 170px;
}

// A count or size cell: a plain number until clicked (H4.4), "was … Undo" when staged.
component Cell inherits VerticalLayout {
    in property <int> value;
    in property <int> maximum: 9999;
    in property <string> suffix;
    in property <string> was;
    in property <string> key;
    in property <string> label;
    in property <string> crown;      // "Mini", "Silver", "Gold" or ""
    in property <color> crown-tint;
    in property <string> thresholds; // shown while the cell has focus (H4.2)
    callback edited(int);
    alignment: center;
    spacing: 1px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        nb := NumberBox {
            width: 84px;
            height: 30px;
            flat: true;
            spin: false;
            value: root.value;
            maximum: root.maximum;
            suffix: root.suffix;
            label: root.label;
            font-weight: root.was != "" ? 600 : 400;
            edited(v) => { root.edited(v); }
        }
        if root.crown != "": Pill { y: 4px; text: root.crown; tint: root.crown-tint; }
    }
    if (nb.has-focus && root.thresholds != "") || (!nb.has-focus && root.was != ""): HorizontalLayout {
        padding-left: 10px;
        if nb.has-focus: Text { text: root.thresholds; color: Tok.muted; font-size: Tok.small; }
        if !nb.has-focus: WasLine { was: root.was; key: root.key; }
    }
}

component MonsterLine inherits ListRow {
    in property <MonsterRow> m;
    property <string> k: "mon:" + m.index + ":";
    height: 60px;
    staged: m.changed;
    flash: Api.highlight != "" && Api.highlight == "mon:" + m.index;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Rectangle {
            width: Api.assets-ok ? 44px : 0px;
            Asset { y: 8px; width: 44px; height: 44px; source: m.icon; available: m.has-icon; }
        }
        // number, class and size range recede (H4.3)
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 120px;
            Text { text: m.name; overflow: elide; }
            Text { text: m.sub; color: Tok.muted; font-size: Tok.small; overflow: elide; }
        }
        Cell {
            width: Cols.hunted;
            value: m.hunts;
            was: m.was-hunts;
            key: root.k + "hunts";
            label: @tr("Hunted {}", m.name);
            edited(v) => { Api.set-monster(m.index, "hunts", v); }
        }
        Cell {
            width: Cols.hunted;
            value: m.captures;
            was: m.was-captures;
            key: root.k + "captures";
            label: @tr("Captured {}", m.name);
            edited(v) => { Api.set-monster(m.index, "captures", v); }
        }
        // crowns sit in the cells that earn them (H4.1)
        if m.has-size: Cell {
            width: Cols.size;
            value: m.min;
            maximum: 200;
            suffix: " %";
            was: m.was-min;
            key: root.k + "min";
            label: @tr("Smallest size of {}", m.name);
            crown: m.mini ? @tr("Mini") : "";
            crown-tint: Tok.accent-text;
            thresholds: m.thresholds;
            edited(v) => { Api.set-monster(m.index, "min", v); }
        }
        if m.has-size: Cell {
            width: Cols.size;
            value: m.max;
            maximum: 200;
            suffix: " %";
            was: m.was-max;
            key: root.k + "max";
            label: @tr("Largest size of {}", m.name);
            crown: m.crown == 2 ? @tr("Gold") : m.crown == 1 ? @tr("Silver") : "";
            crown-tint: m.crown == 2 ? (Tok.dark ? #e2b93b : #8a6100) : (Tok.dark ? #c3ccd4 : #4f5b66);
            thresholds: m.thresholds;
            edited(v) => { Api.set-monster(m.index, "max", v); }
        }
        if !m.has-size: Text { width: 2 * Cols.size + 10px; text: @tr("No size record"); color: Tok.faint; vertical-alignment: center; font-size: Tok.small; }
        Rectangle {
            width: 52px;
            if m.has-notes: CheckBox {
                x: 0;
                checked: m.notes;
                accessible-label: @tr("Hunter's Notes page of {}", m.name);
                toggled => { Api.set-monster(m.index, "notes", self.checked ? 1 : 0); }
            }
        }
    }
}

export component MonstersPage inherits Rectangle {
    function bulk(id: string, right: length, bottom: length) {
        pv.open(id, right, bottom);
    }
    VerticalLayout {
        padding: Tok.margin;
        padding-top: 16px;
        spacing: Tok.gap;
        PageHeader {
            title: @tr("Monsters");
            subtitle: Api.monster-summary;
            staged: Api.page-counts[8];
            Button {
                text: @tr("Max hunts…");
                clicked => { root.bulk("monsters:hunts", self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height); }
            }
            Button {
                text: @tr("Every crown…");
                clicked => { root.bulk("crowns", self.absolute-position.x - root.absolute-position.x + self.width, self.absolute-position.y - root.absolute-position.y + self.height); }
            }
        }
        HorizontalLayout {
            spacing: Tok.tight;
            SearchField {
                placeholder-text: @tr("Search monsters");
                text <=> Api.monster-filter;
                edited => { Api.filter-monsters(); }
            }
            // "Large monsters only" as a filter chip (C3)
            Chip {
                y: 2px;
                text: @tr("Large only");
                active: Api.monster-large-only;
                clicked => {
                    Api.monster-large-only = !Api.monster-large-only;
                    Api.filter-monsters();
                }
            }
            Chip {
                y: 2px;
                text: @tr("Missing a crown");
                active: Api.monster-missing;
                clicked => {
                    Api.monster-missing = !Api.monster-missing;
                    Api.filter-monsters();
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            alignment: start;
            Card {
                width: min(root.width - 2 * Tok.margin, Tok.row-max);
                VerticalLayout {
                    Rectangle {
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Rectangle { width: Api.assets-ok ? 44px : 0px; }
                            ColHead { text: @tr("Monster");horizontal-stretch: 1; min-width: 120px; }
                            HorizontalLayout {
                                width: Cols.hunted;
                                spacing: 6px;
                                padding-left: 10px;
                                alignment: start;
                                ColHead { text: @tr("Hunted"); }
                                InfoTip { y: 9px; text: @tr("Hunted counts kills only; the game's monster list shows hunted plus captured. Every edit also rebuilds the Guild Card's monster log."); }
                            }
                            HorizontalLayout {
                                width: Cols.hunted;
                                padding-left: 10px;
                                ColHead { text: @tr("Captured"); }
                            }
                            HorizontalLayout {
                                width: 2 * Cols.size + 10px;
                                spacing: 6px;
                                padding-left: 10px;
                                alignment: start;
                                ColHead { text: @tr("Smallest"); width: Cols.size - 10px; }
                                ColHead { text: @tr("Largest"); }
                                InfoTip {
                                    y: 9px;
                                    text: @tr("Sizes are % of the monster's base size. At or below its mini size it has the mini crown; at or above its silver or gold size, that crown. Click a size to see the monster's own sizes. The crown awards read the Guild Card's monster log, which every edit rebuilds.");
                                }
                            }
                            ColHead { text: @tr("Notes"); width: 52px; }
                        }
                        Hairline { y: parent.height - 1px; width: parent.width; }
                    }
                    if Api.monsters.length == 0: EmptyState { text: Api.monster-missing ? @tr("Every monster shown has its crowns.") : @tr("No monster matches the search."); }
                    ListView {
                        property <int> seq: Api.jump-seq;
                        function go() {
                            if Api.page == "monsters" && Api.jump-row >= 0 {
                                self.content-y = -max(0px, Api.jump-row * 60px - self.visible-height / 3);
                            }
                        }
                        // a jump that opened this page arrives before the list exists
                        init => { self.go(); }
                        changed seq => { self.go(); }
                        for m in Api.monsters: MonsterLine { m: m; }
                    }
                }
            }
        }
    }
    pv := PreviewPopup { x: 0; y: 0; page-width: root.width; }
}
