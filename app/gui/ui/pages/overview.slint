import { Button, ScrollView, Palette } from "std-widgets.slint";
import { Api, Tok, Card, Muted, StatTile, SectionTitle, Goal } from "../common.slint";

component GoalCard inherits Card {
    in property <Goal> goal;
    callback preview();
    min-height: 120px;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text { text: goal.title; font-weight: 600; wrap: word-wrap; }
        Muted { text: goal.detail; vertical-stretch: 1; }
        if goal.edits > 0: Muted { text: goal.edits + (goal.edits == 1 ? " byte to change" : " bytes to change"); font-size: 11px; }
        HorizontalLayout {
            alignment: start;
            Button {
                text: goal.edits == 0 ? "Already done" : "Preview changes";
                enabled: goal.edits > 0;
                clicked => { root.preview(); }
            }
        }
    }
}

export component OverviewPage inherits Rectangle {
    in-out property <string> preview-id;
    in-out property <[string]> preview-lines;
    property <int> cols: root.width > 1100px ? 3 : root.width > 700px ? 2 : 1;
    ScrollView {
        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            alignment: start;
            Text { text: "Overview"; font-size: 22px; font-weight: 600; }
            // stats grid
            for r in (Api.stats.length + 3) / 4: HorizontalLayout {
                spacing: 12px;
                for c in 4: VerticalLayout {
                    horizontal-stretch: 1;
                    if r * 4 + c < Api.stats.length: StatTile { card: Api.stats[r * 4 + c]; }
                }
            }
            SectionTitle { text: "Quick goals"; }
            Muted { text: "Each goal writes what playing would have written, including side effects such as quest set bits and the Guild Card. Preview first; nothing is saved until you write."; }
            for r in (Api.goals.length + cols - 1) / cols: HorizontalLayout {
                spacing: 12px;
                for c in cols: VerticalLayout {
                    horizontal-stretch: 1;
                    if r * cols + c < Api.goals.length: GoalCard {
                        goal: Api.goals[r * cols + c];
                        preview => {
                            root.preview-id = Api.goals[r * cols + c].id;
                            root.preview-lines = Api.preview-goal(root.preview-id);
                            popup.show();
                        }
                    }
                }
            }
        }
    }
    popup := PopupWindow {
        x: (root.width - min(560px, root.width - 32px)) / 2;
        y: 60px;
        width: min(560px, root.width - 32px);
        close-policy: close-on-click-outside;
        Card {
            background: Palette.background;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0006;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "Exactly what will change"; font-size: 16px; font-weight: 600; }
                ScrollView {
                    height: min(root.preview-lines.length * 22px + 8px, 360px);
                    VerticalLayout {
                        for l in root.preview-lines: Text { text: l; wrap: word-wrap; font-size: 12px; }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { popup.close(); } }
                    Button {
                        text: "Apply";
                        primary: true;
                        clicked => {
                            Api.apply-goal(root.preview-id);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}
