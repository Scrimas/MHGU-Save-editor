import { Button, ScrollView, Palette } from "std-widgets.slint";
import { Api, Tok, Card, Muted, StatTile, SectionTitle, Goal, PageHeader, ConfidenceTag, Confidence, PreviewPopup } from "../common.slint";

component GoalCard inherits Card {
    in property <Goal> goal;
    callback preview();
    VerticalLayout {
        padding: Tok.pad;
        spacing: 8px;
        HorizontalLayout {
            spacing: Tok.tight;
            Text { text: goal.title; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
            if goal.confidence != Confidence.confirmed: ConfidenceTag { level: goal.confidence; info: false; }
        }
        Text { text: goal.detail; color: Tok.muted; wrap: word-wrap; vertical-stretch: 1; vertical-alignment: top; }
        HorizontalLayout {
            spacing: Tok.tight;
            height: 32px;
            if goal.state == 0: Text { text: goal.count; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; horizontal-stretch: 1; }
            // a staged goal is not "Already done": it is in Review until written (01.5)
            if goal.state == 1: Text { text: "In Review"; color: Tok.accent-text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            if goal.state == 0: Button { text: "Preview…"; clicked => { root.preview(); } }
            if goal.state == 1: Button { text: "Undo"; clicked => { Api.undo(goal.op); } }
        }
    }
}

export component OverviewPage inherits Rectangle {
    // content width inside the page margins
    property <length> cw: root.width - 2 * Tok.margin;
    property <length> tile-w: (cw - 3 * Tok.gap) / 4;
    property <int> cols: cw >= 1100px ? 3 : cw >= 560px ? 2 : 1;
    property <length> goal-w: (cw - (cols - 1) * Tok.gap) / cols;
    property <string> popup-request: Api.snapshot-popup;
    changed popup-request => {
        if popup-request == "goal" && Api.goals.length > 0 {
            Api.snapshot-popup = "";
            pv.open(Api.goals[0].id, Tok.margin + root.goal-w, 440px);
        }
    }
    ScrollView {
        VerticalLayout {
            padding: Tok.margin;
            padding-top: 16px;
            spacing: Tok.gap;
            alignment: start;
            PageHeader {
                title: "Overview";
                subtitle: Api.slots[Api.slot].used ? "Character " + (Api.slot + 1) + ", " + Api.slots[Api.slot].name + " · confirmed in game except where marked" : "";
            }
            // stat tiles on a fixed 4-column grid, so the gutters line up (C1m); each
            // opens its page (H1.4)
            for r in (Api.stats.length + 3) / 4: HorizontalLayout {
                spacing: Tok.gap;
                alignment: start;
                for c in 4: Rectangle {
                    width: root.tile-w;
                    height: 108px;
                    if r * 4 + c < Api.stats.length: StatTile {
                        card: Api.stats[r * 4 + c];
                        open => {
                            if self.card.page == "collections" {
                                Api.select-collection(self.card.tab);
                            }
                            Api.page = self.card.page;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Tok.gap;
                padding-top: 12px;
                SectionTitle { text: "Quick goals"; vertical-alignment: center; }
                Text {
                    text: "Each goal adds its changes to Review. Nothing is written until you press Write.";
                    color: Tok.muted;
                    font-size: Tok.small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
            // only goals that can still change something get a card, in equal columns
            // (C3m, K1)
            if Api.goals.length == 0: Muted { text: "Every goal is already in this save."; }
            for r in (Api.goals.length + root.cols - 1) / root.cols: HorizontalLayout {
                spacing: Tok.gap;
                alignment: start;
                for c in root.cols: Rectangle {
                    width: root.goal-w;
                    min-height: 168px;
                    if r * root.cols + c < Api.goals.length: GoalCard {
                        goal: Api.goals[r * root.cols + c];
                        preview => {
                            pv.open(
                                self.goal.id,
                                self.absolute-position.x - root.absolute-position.x + self.width,
                                self.absolute-position.y - root.absolute-position.y + self.height);
                        }
                    }
                }
            }
            // done goals collapse into one compact group (C5m)
            if Api.goals-done.length > 0: VerticalLayout {
                spacing: Tok.tight;
                padding-top: 4px;
                Text { text: "Already in your save"; font-size: Tok.small; font-weight: 600; color: Tok.muted; }
                for r in (Api.goals-done.length + 2) / 3: HorizontalLayout {
                    spacing: Tok.tight;
                    alignment: start;
                    for c in 3: Rectangle {
                        visible: r * 3 + c < Api.goals-done.length;
                        height: 30px;
                        width: self.visible ? t.preferred-width + 28px : 0px;
                        border-radius: 15px;
                        border-width: 1px;
                        border-color: Tok.line;
                        t := Text {
                            text: "✓  " + (r * 3 + c < Api.goals-done.length ? Api.goals-done[r * 3 + c].title : "");
                            font-size: Tok.small;
                            color: Tok.muted;
                        }
                    }
                }
            }
        }
    }
    pv := PreviewPopup { x: 0; y: 0; page-width: root.width; }
}
