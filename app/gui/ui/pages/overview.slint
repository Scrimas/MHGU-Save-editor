import { Button, ScrollView, Palette } from "std-widgets.slint";
import { Api, Tok, Card, Muted, StatTile, SectionTitle, Goal, PageHeader, ConfidenceTag, Confidence, PreviewPopup, EmptyState } from "../common.slint";

component GoalCard inherits Card {
    in property <Goal> goal;
    callback preview();
    VerticalLayout {
        padding: Tok.pad;
        spacing: 8px;
        HorizontalLayout {
            spacing: Tok.tight;
            Text { text: goal.title; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
            if goal.confidence != Confidence.confirmed: ConfidenceTag { level: goal.confidence; info: false; }
        }
        Text { text: goal.detail; color: Tok.muted; wrap: word-wrap; vertical-stretch: 1; vertical-alignment: top; }
        HorizontalLayout {
            spacing: Tok.tight;
            height: 32px;
            if goal.state == 0: Text { text: goal.count; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; horizontal-stretch: 1; }
            // a staged goal is not "Already done": it is in Review until written (01.5)
            if goal.state == 1: Text { text: @tr("In Review"); color: Tok.accent-text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            if goal.state == 0: Button { text: @tr("Preview…"); clicked => { root.preview(); } }
            if goal.state == 1: Button { text: @tr("Undo"); clicked => { Api.undo(goal.op); } }
        }
    }
}

export component OverviewPage inherits Rectangle {
    // content width inside the page margins
    property <length> cw: root.width - 2 * Tok.margin;
    // stat tiles as many a row as fit at 200 px, the rows balanced (8 go 4 + 4, not 7 + 1)
    property <int> tile-fit: max(1, floor((cw + Tok.gap) / (200px + Tok.gap)));
    property <int> tile-cols: Api.stats.length == 0 ? 1 : ceil(Api.stats.length / ceil(Api.stats.length / tile-fit));
    // from 1100 px, one more column each time a card of 355 px fits, never more than goals
    property <int> cols: cw >= 1100px ? max(3, min(Api.goals.length, floor((cw + Tok.gap) / (355px + Tok.gap)))) : cw >= 560px ? 2 : 1;
    property <length> goal-w: (cw - (cols - 1) * Tok.gap) / cols;
    // The column and row counts ease, so on a switch each card slides to its new place and
    // width; the width itself follows the window at once.
    property <float> tile-cols-f: tile-cols;
    animate tile-cols-f { duration: 180ms; easing: ease-in-out; }
    property <float> tile-rows-f: ceil(Api.stats.length / tile-cols);
    animate tile-rows-f { duration: 180ms; easing: ease-in-out; }
    property <float> cols-f: cols;
    animate cols-f { duration: 180ms; easing: ease-in-out; }
    property <float> rows-f: ceil(Api.goals.length / cols);
    animate rows-f { duration: 180ms; easing: ease-in-out; }
    property <length> tile-w-now: (cw - (tile-cols-f - 1) * Tok.gap) / tile-cols-f;
    property <length> goal-w-now: (cw - (cols-f - 1) * Tok.gap) / cols-f;
    // every goal card as tall as the tallest at the width it is going to
    property <length> goal-h: max(168px, measure.preferred-height);
    property <string> popup-request: Api.snapshot-popup;
    changed popup-request => {
        if popup-request == "goal" && Api.goals.length > 0 {
            Api.snapshot-popup = "";
            pv.open(Api.goals[0].id, Tok.margin + root.goal-w, 440px);
        }
    }
    ScrollView {
        VerticalLayout {
            padding: Tok.margin;
            padding-top: 16px;
            spacing: Tok.gap;
            alignment: start;
            PageHeader {
                title: @tr("Overview");
                subtitle: Api.slots[Api.slot].used ? @tr("Character {}, {} · confirmed in game except where marked", Api.slot + 1, Api.slots[Api.slot].name) : "";
            }
            // stat tiles in equal columns, so the gutters line up (C1m); each opens its page
            // (H1.4)
            Rectangle {
                height: max(0px, root.tile-rows-f * (108px + Tok.gap) - Tok.gap);
                for s[i] in Api.stats: StatTile {
                    property <float> at-col: Math.mod(i, root.tile-cols);
                    animate at-col { duration: 180ms; easing: ease-in-out; }
                    property <float> at-row: floor(i / root.tile-cols);
                    animate at-row { duration: 180ms; easing: ease-in-out; }
                    x: self.at-col * (root.tile-w-now + Tok.gap);
                    y: self.at-row * (108px + Tok.gap);
                    width: root.tile-w-now;
                    height: 108px;
                    card: s;
                    open => {
                        if self.card.page == "collections" {
                            Api.select-collection(self.card.tab);
                        }
                        Api.page = self.card.page;
                    }
                }
            }
            HorizontalLayout {
                spacing: Tok.gap;
                padding-top: 12px;
                SectionTitle { text: @tr("Quick goals"); vertical-alignment: center; }
                Text {
                    text: @tr("Each goal adds its changes to Review. Nothing is written until you press Write.");
                    color: Tok.muted;
                    font-size: Tok.small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
            // only goals that can still change something get a card, in equal columns
            // (C3m, K1)
            if Api.goals.length == 0: Card { EmptyState { text: @tr("Every goal is already in this save."); } }
            if Api.goals.length > 0: Rectangle {
                height: max(0px, root.rows-f * (root.goal-h + Tok.gap) - Tok.gap);
                for g[i] in Api.goals: GoalCard {
                    property <float> at-col: Math.mod(i, root.cols);
                    animate at-col { duration: 180ms; easing: ease-in-out; }
                    property <float> at-row: floor(i / root.cols);
                    animate at-row { duration: 180ms; easing: ease-in-out; }
                    x: self.at-col * (root.goal-w-now + Tok.gap);
                    y: self.at-row * (root.goal-h + Tok.gap);
                    width: root.goal-w-now;
                    height: root.goal-h;
                    goal: g;
                    preview => {
                        pv.open(
                            self.goal.id,
                            self.absolute-position.x - root.absolute-position.x + self.width,
                            self.absolute-position.y - root.absolute-position.y + self.height);
                    }
                }
            }
            // done goals collapse into one compact group (C5m)
            if Api.goals-done.length > 0: VerticalLayout {
                spacing: Tok.tight;
                padding-top: 4px;
                Text { text: @tr("Already in your save"); font-size: Tok.small; font-weight: 600; color: Tok.muted; }
                for r in (Api.goals-done.length + 2) / 3: HorizontalLayout {
                    spacing: Tok.tight;
                    alignment: start;
                    for c in 3: Rectangle {
                        visible: r * 3 + c < Api.goals-done.length;
                        height: 30px;
                        width: self.visible ? t.preferred-width + 28px : 0px;
                        border-radius: 15px;
                        border-width: 1px;
                        border-color: Tok.line;
                        t := Text {
                            text: "✓  " + (r * 3 + c < Api.goals-done.length ? Api.goals-done[r * 3 + c].title : "");
                            font-size: Tok.small;
                            color: Tok.muted;
                        }
                    }
                }
            }
        }
    }
    // hidden copies of the goal cards at the width they are going to: the tallest sets
    // the height of all
    Rectangle {
        visible: false;
        measure := HorizontalLayout {
            for g in Api.goals: GoalCard { width: root.goal-w; goal: g; }
        }
    }
    pv := PreviewPopup { x: 0; y: 0; page-width: root.width; }
}
