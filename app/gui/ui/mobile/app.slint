// The editor on phones and tablets (Android; the desktop with --features mobile). The same
// Api global as ui/app.slint, so the Rust side does not know which one it drives.
//
// Window width classes (dp): under 600 the navigation bar and More; from 600 the rail and
// the drawer with every page (tablets, a foldable's inner screen, landscape). A foldable
// switches as it opens: the window resizes, the app does not restart (AndroidManifest.xml).
import { Palette } from "std-widgets.slint";
import { M } from "theme.slint";
import { Api, Fmt, Tabs, Win } from "../common.slint";
import { MaterialPalette } from "@material";
import { TopBar, ReviewFab, Snack } from "widgets.slint";
import { NavBar, NavRail, Drawer, Dest, DrawerEntry } from "nav.slint";
import { ReviewSheet, SlotSheet, MoreSheet, MoreEntry, MenuSheet, AboutSheet, ExportImportSheet, AskSheet, SnapshotsSheet } from "sheets.slint";
import { WriteScreen } from "write.slint";
import { OpenPage, RecompGuide } from "pages/open.slint";
import { OverviewPage, GoalSheet } from "pages/overview.slint";
import { PlaceholderPage } from "pages/placeholder.slint";
import { SettingsSheet } from "pages/settings.slint";

export { Api, Fmt, Tabs, MaterialPalette }

// A page with its top app bar. Two of them while a predictive back gesture leaves a page:
// the Overview behind, the page shrinking over it.
component PageLayer inherits Rectangle {
    in property <string> page;
    in property <string> title;
    in property <string> subtitle;
    in property <length> top-inset;
    in property <length> pad;
    in property <length> side-inset;
    callback avatar();
    callback open-page(string, int);
    callback preview(string);
    background: M.surface;
    // set here so the radius and clip set where it is used apply (see Press)
    border-radius: 0px;
    clip: false;
    VerticalLayout {
        padding-top: root.top-inset;
        TopBar {
            title: root.title;
            subtitle: root.subtitle;
            avatar: true;
            avatar-clicked => { root.avatar(); }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.page == "overview": OverviewPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
                open-page(page, tab) => { root.open-page(page, tab); }
                preview(id) => { root.preview(id); }
            }
            if root.page != "overview": PlaceholderPage { name: root.title; }
        }
    }
}

export component AppWindow inherits Window {
    title: Api.loaded ? @tr("MHGU Save Editor — {}", Api.source-label != "" ? Api.source-label : Api.file-path) : @tr("MHGU Save Editor");
    icon: @image-url("../../assets/icon.svg");
    default-font-family: Fmt.font;
    // a phone's size when it runs on the desktop
    preferred-width: 412px;
    preferred-height: 915px;
    min-width: 320px;
    min-height: 480px;
    background: M.surface;

    // the status and navigation bars, the camera cutout: the app draws edge to edge
    property <length> inset-top: root.safe-area-insets.top;
    property <length> inset-bottom: root.safe-area-insets.bottom;
    property <length> inset-left: root.safe-area-insets.left;
    property <length> inset-right: root.safe-area-insets.right;
    property <bool> compact: root.width < M.medium-from;

    property <string> scheme: Api.force-scheme;
    changed scheme => {
        if scheme == "light" {
            Palette.color-scheme = ColorScheme.light;
        } else if scheme == "dark" {
            Palette.color-scheme = ColorScheme.dark;
        } else if scheme == "system" {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    // Rust builds a page's models when it is shown
    property <string> page-now: Api.page;
    changed page-now => { Api.page-shown(); }

    // sheets and screens over the pages
    property <bool> slot-open;
    property <bool> more-open;
    property <bool> menu-open;
    property <bool> about-open;
    property <bool> settings-open;
    property <bool> drawer-open;
    property <bool> guide-open;
    property <bool> export-open;
    property <bool> goal-open;
    // the Open screen over an open save (More, Open save…); it closes once another opens
    property <bool> open-screen;
    property <string> opened: Api.file-path;
    changed opened => { root.open-screen = false; }
    out property <bool> any-modal: Api.snapshots-open || root.open-screen || Api.write-open || Api.review-open || root.slot-open || root.more-open || root.menu-open || root.about-open || root.settings-open || root.drawer-open || root.export-open || root.goal-open || Api.quit-open || Api.open-ask != "";

    // the five destinations of the bar and the rail; More holds the other pages. Api.page-counts
    // follows the desktop sidebar: overview character items equipment palicoes quests requests
    // collections unlocks monsters cards options database advanced
    property <int> more-badge: Api.page-counts[1] + Api.page-counts[4] + Api.page-counts[6] + Api.page-counts[7] + Api.page-counts[8] + Api.page-counts[9] + Api.page-counts[10] + Api.page-counts[11];
    property <[Dest]> dests: [
        { id: "overview", label: @tr("Overview"), icon: @image-url("icons/overview.svg"), icon-on: @image-url("icons/overview-filled.svg"), badge: Api.page-counts[0] },
        { id: "items", label: @tr("Items"), icon: @image-url("icons/items.svg"), icon-on: @image-url("icons/items-filled.svg"), badge: Api.page-counts[2] },
        { id: "equipment", label: @tr("Equipment"), icon: @image-url("icons/equipment.svg"), icon-on: @image-url("icons/equipment-filled.svg"), badge: Api.page-counts[3] },
        { id: "quests", label: @tr("Quests"), icon: @image-url("icons/quests.svg"), icon-on: @image-url("icons/quests-filled.svg"), badge: Api.page-counts[5] },
        { id: "more", label: @tr("More"), icon: @image-url("icons/more.svg"), icon-on: @image-url("icons/more.svg"), badge: root.more-badge },
    ];
    property <int> dest: Api.page == "overview" ? 0 : Api.page == "items" ? 1 : Api.page == "equipment" ? 2 : Api.page == "quests" ? 3 : 4;
    property <[MoreEntry]> more-pages: [
        { id: "character", label: @tr("Character"), badge: Api.page-counts[1], icon: @image-url("icons/person.svg") },
        { id: "palicoes", label: @tr("Palicoes"), badge: Api.page-counts[4], icon: @image-url("icons/paw.svg") },
        { id: "requests", label: @tr("Requests"), badge: Api.page-counts[6], icon: @image-url("icons/request.svg") },
        { id: "collections", label: @tr("Collections"), badge: Api.page-counts[7], icon: @image-url("icons/star.svg") },
        { id: "unlocks", label: @tr("Unlocks"), badge: Api.page-counts[8], icon: @image-url("icons/unlock.svg") },
        { id: "monsters", label: @tr("Monsters"), badge: Api.page-counts[9], icon: @image-url("icons/claw.svg") },
        { id: "cards", label: @tr("Guild Cards"), badge: Api.page-counts[10], icon: @image-url("icons/card.svg") },
        { id: "options", label: @tr("Options"), badge: Api.page-counts[11], icon: @image-url("icons/tune.svg") },
    ];
    property <[DrawerEntry]> drawer: [
        { id: "overview", label: @tr("Overview"), badge: Api.page-counts[0] },
        { id: "character", label: @tr("Character"), badge: Api.page-counts[1] },
        { id: "items", label: @tr("Items"), badge: Api.page-counts[2] },
        { id: "equipment", label: @tr("Equipment"), badge: Api.page-counts[3] },
        { id: "palicoes", label: @tr("Palicoes"), badge: Api.page-counts[4] },
        { id: "quests", label: @tr("Quests"), badge: Api.page-counts[5] },
        { id: "requests", label: @tr("Requests"), badge: Api.page-counts[6] },
        { id: "collections", label: @tr("Collections"), badge: Api.page-counts[7] },
        { id: "unlocks", label: @tr("Unlocks"), badge: Api.page-counts[8] },
        { id: "monsters", label: @tr("Monsters"), badge: Api.page-counts[9] },
        { id: "cards", label: @tr("Guild Cards"), badge: Api.page-counts[10] },
        { id: "options", label: @tr("Options"), badge: Api.page-counts[11] },
        { id: "snapshots", label: @tr("Snapshots"), gap: true },
        { id: "open", label: @tr("Open save…") },
        { id: "settings", label: @tr("Settings") },
        { id: "about", label: @tr("About") },
    ];

    pure function page-title(id: string) -> string {
        return id == "overview" ? @tr("Overview")
            : id == "character" ? @tr("Character")
            : id == "items" ? @tr("Items")
            : id == "equipment" ? @tr("Equipment")
            : id == "palicoes" ? @tr("Palicoes")
            : id == "quests" ? @tr("Quests")
            : id == "requests" ? @tr("Requests")
            : id == "collections" ? @tr("Collections")
            : id == "unlocks" ? @tr("Unlocks")
            : id == "monsters" ? @tr("Monsters")
            : id == "cards" ? @tr("Guild Cards")
            : id == "options" ? @tr("Options")
            : "";
    }

    // a page or one of the app's screens, from More or the drawer
    function go(id: string) {
        root.more-open = false;
        root.drawer-open = false;
        if id == "open" {
            root.open-screen = true;
        } else if id == "settings" {
            root.settings-open = true;
        } else if id == "about" {
            root.about-open = true;
        } else if id == "snapshots" {
            Api.list-snapshots();
            Api.snapshots-open = true;
        } else {
            Api.page = id;
        }
    }

    function pick-dest(i: int) {
        if i == 4 {
            root.more-open = true;
        } else {
            Api.page = root.dests[i].id;
        }
    }

    // Android's Back: the open sheet or screen first, then the page, then leave (asking first
    // when changes are not written). false lets the app close.
    function back() -> bool {
        if Api.quit-open {
            Api.quit-open = false;
            return true;
        }
        if Api.open-ask != "" {
            Api.open-ask = "";
            return true;
        }
        if root.goal-open {
            root.goal-open = false;
            return true;
        }
        if Api.restore-ask != "" {
            Api.restore-ask = "";
            return true;
        }
        if Api.snapshots-open {
            Api.snapshots-open = false;
            return true;
        }
        if Api.write-open {
            Api.write-open = false;
            return true;
        }
        if root.export-open || root.about-open || root.settings-open || root.menu-open || root.slot-open || root.more-open || root.drawer-open {
            root.export-open = false;
            root.about-open = false;
            root.settings-open = false;
            root.menu-open = false;
            root.slot-open = false;
            root.more-open = false;
            root.drawer-open = false;
            return true;
        }
        if Api.review-open {
            Api.review-open = false;
            return true;
        }
        if root.guide-open {
            root.guide-open = false;
            return true;
        }
        if root.open-screen {
            root.open-screen = false;
            return true;
        }
        if !Api.loaded {
            return false;
        }
        if Api.page != "overview" {
            Api.page = "overview";
            return true;
        }
        if Api.change-count > 0 {
            Api.quit-open = true;
            return true;
        }
        return false;
    }

    // Predictive back (Android 14): what Back would close, in back()'s order; the gesture's
    // progress (it springs back when cancelled); and whether Back has anything to do in the
    // app at all; when it does not, Android plays its back-to-home animation (MainActivity).
    out property <string> back-target: Api.quit-open ? "quit" : Api.open-ask != "" ? "ask" : root.goal-open ? "goal"
        : Api.snapshots-open ? "snapshots" : Api.write-open ? "write"
        : root.export-open ? "export" : root.about-open ? "about" : root.settings-open ? "settings" : root.menu-open ? "menu"
        : root.slot-open ? "slot" : root.more-open ? "more" : root.drawer-open ? "drawer"
        : Api.review-open ? "review" : root.guide-open ? "guide" : root.open-screen ? "open"
        : Api.loaded && Api.page != "overview" ? "page" : Api.loaded && Api.change-count > 0 ? "leave" : "";
    out property <bool> can-back: root.back-target != "";
    changed can-back => { Api.back-enabled(self.can-back); }
    init => {
        Api.back-enabled(root.can-back);
        Win.width = self.width;
        Win.height = self.height;
    }
    changed width => { Win.width = self.width; }
    changed height => { Win.height = self.height; }
    property <float> bp: Api.back-active ? Api.back-progress : 0;
    animate bp { duration: Api.back-active ? 0ms : M.anim; easing: ease-out; }
    // Android's progress follows the finger across the whole screen width, so a usual swipe
    // stays small: the whole effect is reached a third of the way, eased out
    property <float> bpe: 1 - (1 - min(1, 3 * root.bp)) * (1 - min(1, 3 * root.bp));
    pure function drag(target: string) -> float {
        return root.back-target == target ? root.bpe : 0;
    }
    // a full screen shrinking toward the side the swipe started from
    pure function shift(target: string) -> length {
        return (Api.back-from-right ? -1 : 1) * 32px * root.drag(target);
    }

    // the snackbar: the app's message, else "added to Review" after a change
    property <int> staged: Api.change-count;
    property <bool> staged-snack;
    changed staged => {
        // (a write or Undo all brings it down: no snackbar then)
        root.staged-snack = self.staged > 0;
        snack-timer.restart();
    }
    snack-timer := Timer {
        interval: 4s;
        running: root.staged-snack;
        triggered => { root.staged-snack = false; }
    }
    property <bool> snack-shown: Api.toast != "" || (root.staged-snack && Api.loaded && !root.any-modal);

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Back || e.text == Key.Escape {
                return root.back() ? accept : reject;
            }
            if e.modifiers.control && (e.text == "z" || e.text == "Z") {
                Api.undo-last();
                return accept;
            }
            return reject;
        }

        // no save yet (or Open save…): how to open one
        if (!Api.loaded || root.open-screen) && !root.guide-open: OpenPage {
            drag: root.drag("open");
            x: root.shift("open");
            transform-scale-x: 1 - 0.1 * self.drag;
            transform-scale-y: 1 - 0.1 * self.drag;
            closable: Api.loaded;
            close => { root.open-screen = false; }
            top-inset: root.inset-top;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            guide => { root.guide-open = true; }
            export-import => { root.export-open = true; }
            menu => { root.menu-open = true; }
        }
        if (!Api.loaded || root.open-screen) && root.guide-open: RecompGuide {
            drag: root.drag("guide");
            x: root.shift("guide");
            transform-scale-x: 1 - 0.1 * self.drag;
            transform-scale-y: 1 - 0.1 * self.drag;
            top-inset: root.inset-top;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            back => { root.guide-open = false; }
        }

        // a save is open: the rail (wide windows) or the bar (phones), and the page
        if Api.loaded && !root.open-screen: Rectangle {
            property <length> rail-w: root.compact ? 0px : 80px + root.inset-left;
            property <length> bar-h: root.compact ? 80px + root.inset-bottom : 0px;
            if !root.compact: NavRail {
                x: 0;
                height: parent.height;
                items: root.dests;
                current: root.dest;
                top-inset: root.inset-top;
                left-inset: root.inset-left;
                picked(i) => {
                    if i == 4 {
                        root.drawer-open = true;
                    } else {
                        root.pick-dest(i);
                    }
                }
                menu => { root.drawer-open = true; }
                review => { Api.review-open = true; }
            }
            content := Rectangle {
                x: parent.rail-w;
                y: 0;
                width: parent.width - parent.rail-w;
                height: parent.height - parent.bar-h;
                // room under the content for the Review button
                property <length> pad: (root.compact && Api.change-count > 0 ? 88px : 16px) + (root.compact ? 0px : root.inset-bottom);
                property <length> side: root.compact ? max(root.inset-left, root.inset-right) : root.inset-right;
                property <string> overview-sub: Api.slots[Api.slot].used ? @tr("{} · slot {} · HR {}", Api.slots[Api.slot].name, Api.slot + 1, Api.slots[Api.slot].hr) : "";
                property <float> p: root.drag("page");
                // (the page moves as the full screens do, toward the side the swipe started from)
                // the page Back goes to, while the gesture is under way
                if content.p > 0: PageLayer {
                    page: "overview";
                    title: root.page-title("overview");
                    subtitle: content.overview-sub;
                    top-inset: root.inset-top;
                    pad: content.pad;
                    side-inset: content.side;
                }
                PageLayer {
                    x: (Api.back-from-right ? -1 : 1) * 32px * content.p;
                    transform-scale-x: 1 - 0.1 * content.p;
                    transform-scale-y: 1 - 0.1 * content.p;
                    border-radius: 28px * content.p;
                    clip: content.p > 0;
                    page: Api.page;
                    title: root.page-title(Api.page);
                    subtitle: Api.page == "overview" ? content.overview-sub : "";
                    top-inset: root.inset-top;
                    pad: content.pad;
                    side-inset: content.side;
                    avatar => { root.slot-open = true; }
                    open-page(page, tab) => {
                        if page == "collections" {
                            Api.select-collection(tab);
                        }
                        Api.page = page;
                    }
                    preview(id) => {
                        if Api.open-preview(id) {
                            root.goal-open = true;
                        }
                    }
                }
            }
            if root.compact: NavBar {
                y: parent.height - self.height;
                items: root.dests;
                current: root.dest;
                bottom-inset: root.inset-bottom;
                picked(i) => { root.pick-dest(i); }
            }
            // the Review button, above the bar (and above a snackbar)
            if root.compact && Api.change-count > 0: ReviewFab {
                property <length> lift: root.snack-shown ? snack.height + 8px : 0px;
                animate lift { duration: M.anim; easing: ease-out; }
                x: parent.width - self.width - 16px - root.inset-right;
                y: parent.height - parent.bar-h - 16px - self.height - self.lift;
                count: Api.change-count;
                clicked => { Api.review-open = true; }
            }
        }

        snack := Snack {
            property <length> bottom: Api.loaded && root.compact ? 80px + root.inset-bottom + 12px : root.inset-bottom + 12px;
            width: min(root.width - 24px - root.inset-left - root.inset-right, 560px);
            x: (root.width - self.width) / 2;
            y: root.snack-shown ? root.height - self.bottom - self.height : root.height + 8px;
            animate y { duration: M.anim; easing: ease-out; }
            text: Api.toast != "" ? Api.toast : @tr("Added to Review");
            sub: Api.toast != "" ? Api.toast-sub : "";
            action: Api.toast != "" ? Api.toast-action : @tr("Undo");
            error: Api.toast != "" && Api.toast-error;
            act => {
                if Api.toast != "" {
                    Api.toast-act();
                } else {
                    root.staged-snack = false;
                    Api.undo-last();
                }
            }
        }

        // sheets, then the full-screen Write above everything
        ReviewSheet {
            drag: root.drag("review");
            open: Api.review-open;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            close => { Api.review-open = false; }
            goto(key) => {
                Api.review-open = false;
                Api.goto(key);
            }
            write => {
                Api.check-emulator();
                Api.write-open = true;
            }
        }
        SlotSheet {
            drag: root.drag("slot");
            open: root.slot-open;
            bottom-inset: root.inset-bottom;
            close => { root.slot-open = false; }
        }
        MoreSheet {
            drag: root.drag("more");
            open: root.more-open;
            bottom-inset: root.inset-bottom;
            pages: root.more-pages;
            current: Api.page;
            close => { root.more-open = false; }
            picked(id) => { root.go(id); }
        }
        MenuSheet {
            drag: root.drag("menu");
            open: root.menu-open;
            bottom-inset: root.inset-bottom;
            close => { root.menu-open = false; }
            picked(id) => {
                root.menu-open = false;
                root.go(id);
            }
        }
        SettingsSheet {
            drag: root.drag("settings");
            open: root.settings-open;
            bottom-inset: root.inset-bottom;
            close => { root.settings-open = false; }
        }
        AboutSheet {
            drag: root.drag("about");
            open: root.about-open;
            bottom-inset: root.inset-bottom;
            close => { root.about-open = false; }
        }
        ExportImportSheet {
            drag: root.drag("export");
            open: root.export-open;
            bottom-inset: root.inset-bottom;
            close => { root.export-open = false; }
        }
        SnapshotsSheet {
            drag: root.drag("snapshots");
            open: Api.snapshots-open;
            bottom-inset: root.inset-bottom;
            close => {
                Api.snapshots-open = false;
                Api.restore-ask = "";
            }
        }
        GoalSheet {
            drag: root.drag("goal");
            open: root.goal-open;
            bottom-inset: root.inset-bottom;
            close => { root.goal-open = false; }
        }
        AskSheet {
            open: Api.quit-open;
            drag: root.drag("quit");
            bottom-inset: root.inset-bottom;
            question: @tr("Leave without writing?");
            text: @tr("The changes in Review are not in the save yet. Leaving drops them.");
            yes: @tr("Leave");
            close => { Api.quit-open = false; }
            confirmed => { Api.quit(); }
        }
        AskSheet {
            open: Api.open-ask != "";
            drag: root.drag("ask");
            bottom-inset: root.inset-bottom;
            question: @tr("Open another save?");
            text: @tr("The changes in Review are not in the save yet. Opening another save drops them.");
            yes: @tr("Open");
            close => { Api.open-ask = ""; }
            confirmed => { Api.open-confirmed(); }
        }
        Drawer {
            drag: root.drag("drawer");
            shown: root.drawer-open;
            entries: root.drawer;
            current: Api.page;
            top-inset: root.inset-top;
            left-inset: root.inset-left;
            close => { root.drawer-open = false; }
            picked(id) => { root.go(id); }
        }
        WriteScreen {
            open: Api.write-open;
            drag: root.drag("write");
            x: root.shift("write");
            transform-scale-x: 1 - 0.1 * self.drag;
            transform-scale-y: 1 - 0.1 * self.drag;
            top-inset: root.inset-top;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            close => { Api.write-open = false; }
            back-to-review => {
                Api.write-open = false;
                Api.review-open = true;
            }
        }
    }
}
