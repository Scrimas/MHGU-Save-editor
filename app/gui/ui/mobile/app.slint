                sel := HorizontalLayout {
                    padding-left: 16px + root.inset-left;
                    padding-right: 16px + root.inset-right;
                    padding-top: 16px;
                    padding-bottom: 16px + root.inset-bottom;
                    spacing: 8px;
                    Btn {
