                        title: root.page-title(root.peek-page);
                        subtitle: root.peek-page == "overview" ? content.overview-sub : root.page-sub(root.peek-page);
                        top-inset: root.inset-top;
                        pad: content.pad;
                        side-inset: content.side;
                        actions: (root.peek-page == "items" && Api.item-store < 2) || (root.peek-page == "equipment" && Api.equip-owner < 2);
                    }
