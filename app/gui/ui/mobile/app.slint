// The editor on phones and tablets (Android; the desktop with --features mobile). The same
// Api global as ui/app.slint, so the Rust side does not know which one it drives.
//
// Window width classes (dp): under 600 the navigation bar and More; from 600 the rail and
// the drawer with every page (tablets, a foldable's inner screen, landscape). A foldable
// switches as it opens: the window resizes, the app does not restart (AndroidManifest.xml).
import { Palette } from "std-widgets.slint";
import { M } from "theme.slint";
import { Api, Fmt, Tabs, Win } from "../common.slint";
import { MaterialPalette } from "@material";
import { Btn, TopBar, ReviewFab, Snack } from "widgets.slint";
import { NavBar, NavRail, Drawer, Dest, DrawerEntry } from "nav.slint";
import { Claim, Gest, Pager } from "gestures.slint";
import { ReviewSheet, SlotSheet, MoreSheet, MoreEntry, MenuSheet, AboutSheet, ExportImportSheet, AskSheet, SnapshotsSheet, ChoiceSheet, CharactersSheet, MhxxSheet } from "sheets.slint";
import { WriteScreen } from "write.slint";
import { OpenPage, RecompGuide } from "pages/open.slint";
import { OverviewPage, GoalSheet } from "pages/overview.slint";
import { PlaceholderPage } from "pages/placeholder.slint";
import { ItemsPage, ItemSheet, ItemEdit, ItemsPeek } from "pages/items.slint";
import { FillSheet } from "pages/fill.slint";
import { EquipmentPage, EquipPickSheet, DecoSheet, EquipView, EquipPick, DecoPick, EquipmentPeek } from "pages/equipment.slint";
import { ChoiceList, Choice } from "pick.slint";
import { QuestsPage, QuestSheet, ArenaSheet, QuestEdit, QuestsPeek } from "pages/quests.slint";
import { RequestsPage, RequestSheet, CollectionsPage, CollectionsPeek, DeviantSheet, UnlocksPage, MonstersPage, MonsterSheet, ListEdit } from "pages/lists.slint";
import { OptionsPage, CardsPage, OptionsPeek, CardsPeek } from "pages/misc.slint";
import { CharacterPage } from "pages/character.slint";
import { PalicoesPage, PalicoView, PalicoesPeek } from "pages/palicoes.slint";
import { ColourSheet, ColourEdit } from "colour.slint";
import { NewsSheet, SettingsScreen, SettingsView, UpdateSheet, VersionSheet } from "pages/settings.slint";

// (the Peek globals: the neighbouring tabs' previews, built by src/views/peek.rs)
export { Api, Fmt, Tabs, MaterialPalette, Gest, CollectionsPeek, ItemsPeek, EquipmentPeek, QuestsPeek, PalicoesPeek, OptionsPeek, CardsPeek }

// A page with its top app bar. Two of them while a predictive back gesture leaves a page:
// the Overview behind, the page shrinking over it.
component PageLayer inherits Rectangle {
    in property <string> page;
    in property <string> title;
    in property <string> subtitle;
    in property <length> top-inset;
    in property <length> pad;
    in property <length> side-inset;
    // the page's own actions, behind ⋮ in its top app bar
    in property <bool> actions;
    // quests picked one by one: the bar says how many, with Close
    in property <bool> selecting;
    // Back's preview of leaving the page's detail view (0 to 1), then its way out
    in property <float> back-p;
    in property <float> back-out;
    callback leave-selection();
    callback avatar();
    callback open-page(string, int);
    callback preview(string);
    callback show-actions();
    background: M.surface;
    // set here so the radius and clip set where it is used apply (see Press)
    border-radius: 0px;
    clip: false;
    VerticalLayout {
        padding-top: root.top-inset;
        TopBar {
            title: root.selecting ? @tr("{} selected", Api.quest-selected) : root.title;
            subtitle: root.selecting ? "" : root.subtitle;
            close: root.selecting;
            back-clicked => { root.leave-selection(); }
            avatar: !root.selecting;
            avatar-clicked => { root.avatar(); }
            overflow: root.actions && !root.selecting;
            overflow-clicked => { root.show-actions(); }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.page == "overview": OverviewPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
                open-page(page, tab) => { root.open-page(page, tab); }
                preview(id) => { root.preview(id); }
            }
            if root.page == "items": ItemsPage {
                back-p: root.back-p;
                back-out: root.back-out;
                bottom-pad: root.pad;
                side-inset: root.side-inset;
                preview(id) => { root.preview(id); }
            }
            if root.page == "equipment": EquipmentPage {
                back-p: root.back-p;
                back-out: root.back-out;
                bottom-pad: root.pad;
                side-inset: root.side-inset;
            }
            if root.page == "quests": QuestsPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
            }
            if root.page == "requests": RequestsPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
            }
            if root.page == "collections": CollectionsPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
                preview(id) => { root.preview(id); }
            }
            if root.page == "unlocks": UnlocksPage {
                back-p: root.back-p;
                back-out: root.back-out;
                bottom-pad: root.pad;
                side-inset: root.side-inset;
                preview(id) => { root.preview(id); }
            }
            if root.page == "monsters": MonstersPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
                preview(id) => { root.preview(id); }
            }
            if root.page == "character": CharacterPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
            }
            if root.page == "palicoes": PalicoesPage {
                back-p: root.back-p;
                back-out: root.back-out;
                bottom-pad: root.pad;
                side-inset: root.side-inset;
            }
            if root.page == "options": OptionsPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
            }
            if root.page == "cards": CardsPage {
                bottom-pad: root.pad;
                side-inset: root.side-inset;
            }
            if root.page != "overview" && root.page != "items" && root.page != "equipment" && root.page != "quests"
                && root.page != "requests" && root.page != "collections" && root.page != "unlocks" && root.page != "monsters"
                && root.page != "options" && root.page != "cards" && root.page != "character" && root.page != "palicoes": PlaceholderPage { name: root.title; }
        }
    }
}

export component AppWindow inherits Window {
    title: Api.loaded ? @tr("MHGU Save Editor — {}", Api.source-label != "" ? Api.source-label : Api.file-path) : @tr("MHGU Save Editor");
    icon: @image-url("../../assets/icon.svg");
    default-font-family: Fmt.font;
    // a phone's size when it runs on the desktop
    preferred-width: 412px;
    preferred-height: 915px;
    min-width: 320px;
    min-height: 480px;
    background: M.surface;

    // the status and navigation bars, the camera cutout: the app draws edge to edge
    property <length> inset-top: root.safe-area-insets.top;
    property <length> inset-bottom: root.safe-area-insets.bottom;
    property <length> inset-left: root.safe-area-insets.left;
    property <length> inset-right: root.safe-area-insets.right;
    property <bool> compact: root.width < M.medium-from;

    property <string> scheme: Api.force-scheme;
    changed scheme => {
        if scheme == "light" {
            Palette.color-scheme = ColorScheme.light;
        } else if scheme == "dark" {
            Palette.color-scheme = ColorScheme.dark;
        } else if scheme == "system" {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    // (the pages' pagers and the navigation bar take no swipe under a sheet or a screen)
    property <bool> modal-now: root.any-modal;
    changed modal-now => { Gest.modal = self.modal-now; }
    // Rust builds a page's models when it is shown
    property <string> page-now: Api.page;
    changed page-now => { Api.page-shown(); }

    // sheets and screens over the pages
    property <bool> slot-open;
    property <bool> more-open;
    property <bool> menu-open;
    property <bool> about-open;
    property <bool> settings-open;
    property <bool> drawer-open;
    property <bool> guide-open;
    property <bool> export-open;
    property <bool> goal-open;
    // the page's ⋮ actions
    property <bool> actions-open;
    // the Open screen over an open save (More, Open save…); it closes once another opens
    property <bool> open-screen;
    property <string> opened: Api.file-path;
    changed opened => { root.open-screen = false; }
    out property <bool> any-modal: Api.snapshots-open || root.open-screen || Api.write-open || Api.review-open || root.slot-open || root.more-open || root.menu-open || root.about-open || root.settings-open || root.drawer-open || root.export-open || root.goal-open || root.actions-open || ItemEdit.open || Api.fill-open || Choice.open || EquipPick.open || DecoPick.open || QuestEdit.open || QuestEdit.arena-open || ListEdit.request >= 0 || ListEdit.deviant >= 0 || ListEdit.monster >= 0 || ColourEdit.open || Api.characters-open || Api.mhxx-title != "" || Api.quit-open || Api.open-ask != "" || Api.update-open || Api.news-title != "";

    // the five destinations of the bar and the rail; More holds the other pages. Api.page-counts
    // follows the desktop sidebar: overview character items equipment palicoes quests requests
    // collections unlocks monsters cards options database advanced
    property <int> more-badge: Api.page-counts[1] + Api.page-counts[4] + Api.page-counts[6] + Api.page-counts[7] + Api.page-counts[8] + Api.page-counts[9] + Api.page-counts[10] + Api.page-counts[11];
    property <[Dest]> dests: [
        { id: "overview", label: @tr("Overview"), icon: @image-url("icons/overview.svg"), icon-on: @image-url("icons/overview-filled.svg"), badge: Api.page-counts[0] },
        { id: "items", label: @tr("Items"), icon: @image-url("icons/items.svg"), icon-on: @image-url("icons/items-filled.svg"), badge: Api.page-counts[2] },
        { id: "equipment", label: @tr("Equipment"), icon: @image-url("icons/equipment.svg"), icon-on: @image-url("icons/equipment-filled.svg"), badge: Api.page-counts[3] },
        { id: "quests", label: @tr("Quests"), icon: @image-url("icons/quests.svg"), icon-on: @image-url("icons/quests-filled.svg"), badge: Api.page-counts[5] },
        { id: "more", label: @tr("More"), icon: @image-url("icons/more.svg"), icon-on: @image-url("icons/more.svg"), badge: root.more-badge },
    ];
    property <int> dest: Api.page == "overview" ? 0 : Api.page == "items" ? 1 : Api.page == "equipment" ? 2 : Api.page == "quests" ? 3 : 4;
    property <[MoreEntry]> more-pages: [
        { id: "character", label: @tr("Character"), badge: Api.page-counts[1], icon: @image-url("icons/person.svg") },
        { id: "palicoes", label: @tr("Palicoes"), badge: Api.page-counts[4], icon: @image-url("icons/paw.svg") },
        { id: "requests", label: @tr("Requests"), badge: Api.page-counts[6], icon: @image-url("icons/request.svg") },
        { id: "collections", label: @tr("Collections"), badge: Api.page-counts[7], icon: @image-url("icons/star.svg") },
        { id: "unlocks", label: @tr("Unlocks"), badge: Api.page-counts[8], icon: @image-url("icons/unlock.svg") },
        { id: "monsters", label: @tr("Monsters"), badge: Api.page-counts[9], icon: @image-url("icons/claw.svg") },
        { id: "cards", label: @tr("Guild Cards"), badge: Api.page-counts[10], icon: @image-url("icons/card.svg") },
        { id: "options", label: @tr("Options"), badge: Api.page-counts[11], icon: @image-url("icons/tune.svg") },
    ];
    property <[DrawerEntry]> drawer: [
        { id: "overview", label: @tr("Overview"), badge: Api.page-counts[0] },
        { id: "character", label: @tr("Character"), badge: Api.page-counts[1] },
        { id: "items", label: @tr("Items"), badge: Api.page-counts[2] },
        { id: "equipment", label: @tr("Equipment"), badge: Api.page-counts[3] },
        { id: "palicoes", label: @tr("Palicoes"), badge: Api.page-counts[4] },
        { id: "quests", label: @tr("Quests"), badge: Api.page-counts[5] },
        { id: "requests", label: @tr("Requests"), badge: Api.page-counts[6] },
        { id: "collections", label: @tr("Collections"), badge: Api.page-counts[7] },
        { id: "unlocks", label: @tr("Unlocks"), badge: Api.page-counts[8] },
        { id: "monsters", label: @tr("Monsters"), badge: Api.page-counts[9] },
        { id: "cards", label: @tr("Guild Cards"), badge: Api.page-counts[10] },
        { id: "options", label: @tr("Options"), badge: Api.page-counts[11] },
        { id: "snapshots", label: @tr("Snapshots"), gap: true },
        { id: "open", label: @tr("Open save…") },
        { id: "settings", label: @tr("Settings") },
        { id: "about", label: @tr("About") },
    ];

    // the page's subtitle under its title
    pure function page-sub(id: string) -> string {
        return id == "items" && Api.item-store < 2 ? @tr("{} / {} slots used", Fmt.num(Api.item-used), Fmt.num(Api.item-total))
            : id == "equipment" ? Api.equip-summary
            : id == "quests" ? Api.quest-summary
            : id == "requests" ? Api.request-summary
            : id == "collections" ? Api.checks-summary
            : id == "unlocks" ? Api.unlock-summary
            : id == "monsters" ? Api.monster-summary
            : id == "palicoes" ? Api.palico-summary
            : id == "options" ? Api.options-summary
            : id == "cards" ? Api.cards-summary
            : "";
    }
    // the actions behind the page's ⋮ (page-action runs them)
    property <[string]> page-actions: Api.page == "items" && Api.item-store == 0 ? [@tr("Export box to CSV…"), @tr("Import box from CSV…"), @tr("Empty box…")]
        : Api.page == "items" && Api.item-store == 1 ? [@tr("Empty pouch…")]
        : Api.page == "equipment" && Api.equip-owner < 2 ? [@tr("Export box to CSV…"), @tr("Import box from CSV…")]
        : [];
    function page-action(i: int) {
        root.actions-open = false;
        if Api.page == "items" && Api.item-store == 0 && i == 0 {
            Api.item-export();
        } else if Api.page == "items" && Api.item-store == 0 && i == 1 {
            Api.item-import();
        } else if Api.page == "items" {
            root.preview("items:empty");
        } else if Api.page == "equipment" && i == 0 {
            Api.equip-export();
        } else if Api.page == "equipment" {
            Api.equip-import();
        }
    }
    // a pick of the option sheet (pick.slint), by what it was opened for
    function choose(key: string, n: int, i: int) {
        if key == "skill" {
            Api.set-equip(n == 0 ? "skill0" : "skill1", i);
        } else if key == "set-piece" {
            Api.set-set-piece(n, i);
        } else if key == "arts-style" {
            Api.set-arts(0, "style", 0, i);
        } else if key == "arts-art" {
            Api.set-arts(0, "art", n, i);
        } else if key == "char" {
            Api.set-character(Choice.s, i);
        } else if key == "look" {
            Api.set-look(Choice.s, Choice.s == "voice" ? i + 1 : i);
        } else if key == "card" {
            Api.set-card(Choice.s, i);
        } else if key == "char-arts-style" {
            Api.set-arts(-1, "style", 0, i);
        } else if key == "char-arts-art" {
            Api.set-arts(-1, "art", n, i);
        } else if key == "palico-field" {
            Api.set-palico-field(Choice.s, i);
        } else if key == "palico-bias" {
            Api.set-palico("bias", i);
        } else if key == "palico-target" {
            Api.set-palico("target", i + 1);
        } else if key == "palico-look" {
            Api.set-palico-look(Choice.s, i);
        } else if key == "palico-move" {
            Api.set-palico-entry("moves", Api.palico.move-rows[n].slot, Api.palico.move-rows[n].ids[i], Api.palico.move-rows[n].on);
        } else if key == "palico-skill" {
            Api.set-palico-entry("skills", Api.palico.skill-rows[n].slot, Api.palico.skill-rows[n].ids[i], Api.palico.skill-rows[n].on);
        } else if key == "setting" {
            Api.set-setting(Choice.s, i);
        } else if key == "option" {
            Api.set-option(Choice.s, i);
        } else if key == "chat-group" {
            Api.set-chat-group(i);
        } else if key == "pet-costume" {
            Api.set-pet(n, "costume", i);
        } else if key == "arena-set" {
            Api.set-arena(Api.arena[n].index, i, max(1, Api.arena[n].minutes * 6000 + Api.arena[n].seconds * 100 + Api.arena[n].hundredths));
        }
    }
    function preview(id: string) {
        if Api.open-preview(id) {
            root.goal-open = true;
        }
    }

    pure function page-title(id: string) -> string {
        return id == "overview" ? @tr("Overview")
            : id == "character" ? @tr("Character")
            : id == "items" ? @tr("Items")
            : id == "equipment" ? @tr("Equipment")
            : id == "palicoes" ? @tr("Palicoes")
            : id == "quests" ? @tr("Quests")
            : id == "requests" ? @tr("Requests")
            : id == "collections" ? @tr("Collections")
            : id == "unlocks" ? @tr("Unlocks")
            : id == "monsters" ? @tr("Monsters")
            : id == "cards" ? @tr("Guild Cards")
            : id == "options" ? @tr("Options")
            : "";
    }

    // a page or one of the app's screens, from More or the drawer
    function go(id: string) {
        root.more-open = false;
        root.drawer-open = false;
        if id == "open" {
            root.open-screen = true;
        } else if id == "settings" {
            root.settings-open = true;
        } else if id == "about" {
            root.about-open = true;
        } else if id == "snapshots" {
            Api.list-snapshots();
            Api.snapshots-open = true;
        } else {
            Api.page = id;
        }
    }

    function pick-dest(i: int) {
        if i == 4 {
            root.more-open = true;
        } else {
            Api.page = root.dests[i].id;
        }
    }

    // Android's Back: the open sheet or screen first, then the page, then leave (asking first
    // when changes are not written). false lets the app close.
    public function back() -> bool {
        if Api.quit-open {
            Api.quit-open = false;
            return true;
        }
        if Api.open-ask != "" {
            Api.open-ask = "";
            return true;
        }
        if Api.update-open {
            if Api.update.state == "downloading" {
                Api.cancel-update();
            } else {
                Api.update-open = false;
                Api.update-closed();
            }
            return true;
        }
        if Api.news-title != "" {
            Api.news-title = "";
            return true;
        }
        if root.goal-open {
            root.goal-open = false;
            return true;
        }
        if Api.mhxx-title != "" {
            Api.mhxx-title = "";
            return true;
        }
        if Choice.open {
            Choice.open = false;
            return true;
        }
        if ColourEdit.open {
            ColourEdit.open = false;
            return true;
        }
        if Api.characters-open {
            Api.characters-open = false;
            return true;
        }
        if ListEdit.request >= 0 || ListEdit.deviant >= 0 || ListEdit.monster >= 0 {
            ListEdit.request = -1;
            ListEdit.deviant = -1;
            ListEdit.monster = -1;
            return true;
        }
        if QuestEdit.open || QuestEdit.arena-open {
            QuestEdit.open = false;
            QuestEdit.arena-open = false;
            return true;
        }
        if EquipPick.open || DecoPick.open {
            EquipPick.open = false;
            DecoPick.open = false;
            return true;
        }
        if ItemEdit.open {
            ItemEdit.back();
            return true;
        }
        if Api.fill-open {
            Api.fill-open = false;
            return true;
        }
        if root.actions-open {
            root.actions-open = false;
            return true;
        }
        if Api.restore-ask != "" {
            Api.restore-ask = "";
            return true;
        }
        if Api.snapshots-open {
            Api.snapshots-open = false;
            return true;
        }
        if Api.write-open {
            Api.write-open = false;
            return true;
        }
        if root.settings-open && SettingsView.versions && SettingsView.version-open {
            SettingsView.version-open = false;
            return true;
        }
        if root.settings-open && SettingsView.versions {
            SettingsView.versions = false;
            return true;
        }
        if root.export-open || root.about-open || root.settings-open || root.menu-open || root.slot-open || root.more-open || root.drawer-open {
            root.export-open = false;
            root.about-open = false;
            root.settings-open = false;
            root.menu-open = false;
            root.slot-open = false;
            root.more-open = false;
            root.drawer-open = false;
            return true;
        }
        if Api.review-open {
            Api.review-open = false;
            return true;
        }
        if root.guide-open {
            root.guide-open = false;
            return true;
        }
        if root.open-screen {
            root.open-screen = false;
            return true;
        }
        if !Api.loaded {
            return false;
        }
        if Api.page == "quests" && Api.quest-selecting {
            Api.quest-select-none();
            return true;
        }
        if Api.page == "items" && Api.item-store == 2 && Api.loadout-sel >= 0 {
            Api.select-loadout(-1);
            return true;
        }
        if Api.page == "palicoes" && PalicoView.detail && Api.palico-tab <= 1 && root.width - (root.compact ? 0px : 80px) < M.expanded-from {
            PalicoView.detail = false;
            return true;
        }
        if Api.page == "unlocks" && ListEdit.unlock-detail && root.width - (root.compact ? 0px : 80px) < M.expanded-from {
            ListEdit.unlock-detail = false;
            return true;
        }
        if Api.page == "equipment" && (EquipView.detail || EquipView.set-detail) && root.width - (root.compact ? 0px : 80px) < M.expanded-from {
            EquipView.detail = false;
            EquipView.set-detail = false;
            return true;
        }
        if Api.page != "overview" {
            Api.page = "overview";
            return true;
        }
        if Api.change-count > 0 {
            Api.quit-open = true;
            return true;
        }
        return false;
    }

    // Predictive back (Android 14): what Back would close, in back()'s order; the gesture's
    // progress (it springs back when cancelled); and whether Back has anything to do in the
    // app at all; when it does not, Android plays its back-to-home animation (MainActivity).
    out property <string> back-target: Api.quit-open ? "quit" : Api.open-ask != "" ? "ask"
        : Api.update-open ? "update" : Api.news-title != "" ? "news" : root.goal-open ? "goal"
        : Api.mhxx-title != "" ? "mhxx" : Choice.open ? "choice" : ColourEdit.open ? "colour" : Api.characters-open ? "characters" : EquipPick.open ? "equip-pick" : DecoPick.open ? "deco-pick"
        : QuestEdit.open ? "quest" : QuestEdit.arena-open ? "arena"
        : ListEdit.request >= 0 ? "request" : ListEdit.deviant >= 0 ? "deviant" : ListEdit.monster >= 0 ? "monster"
        : ItemEdit.open ? (ItemEdit.picking && ItemEdit.id != 0 ? "item-pick" : "item") : Api.fill-open ? "fill" : root.actions-open ? "actions"
        : Api.snapshots-open ? "snapshots" : Api.write-open ? "write"
        : root.export-open ? "export" : root.about-open ? "about"
        : root.settings-open && SettingsView.versions && SettingsView.version-open ? "version" : root.settings-open ? "settings" : root.menu-open ? "menu"
        : root.slot-open ? "slot" : root.more-open ? "more" : root.drawer-open ? "drawer"
        : Api.review-open ? "review" : root.guide-open ? "guide" : root.open-screen ? "open"
        : Api.loaded && Api.page == "quests" && Api.quest-selecting ? "selection"
        : Api.loaded && Api.page == "items" && Api.item-store == 2 && Api.loadout-sel >= 0 ? "loadout"
        : Api.loaded && Api.page == "equipment" && (EquipView.detail || EquipView.set-detail) && root.width - (root.compact ? 0px : 80px) < M.expanded-from ? "piece"
        : Api.loaded && Api.page == "unlocks" && ListEdit.unlock-detail && root.width - (root.compact ? 0px : 80px) < M.expanded-from ? "unlock"
        : Api.loaded && Api.page == "palicoes" && PalicoView.detail && Api.palico-tab <= 1 && root.width - (root.compact ? 0px : 80px) < M.expanded-from ? "palico"
        : Api.loaded && Api.page != "overview" ? "page" : Api.loaded && Api.change-count > 0 ? "leave" : "";
    out property <bool> can-back: root.back-target != "";
    changed can-back => { Api.back-enabled(self.can-back); }
    init => {
        Api.back-enabled(root.can-back);
        Win.width = self.width;
        Win.height = self.height;
    }
    changed width => { Win.width = self.width; }
    changed height => { Win.height = self.height; }
    // the gesture's progress: measured from the finger by the touch recogniser
    // (src/android/gesture.rs; since Android 15 the back callback's own progress stays at
    // 0 for a NativeActivity, whose touches Android's back dispatcher never sees)
    property <float> bp: Api.back-active ? Api.back-progress : 0;
    animate bp { duration: Api.back-active ? 0ms : M.anim; easing: ease-out; }
    // Android's progress follows the finger across the whole screen width, so a usual swipe
    // stays small: the whole effect is reached a third of the way, eased out
    property <float> bpe: 1 - (1 - min(1, 3 * root.bp)) * (1 - min(1, 3 * root.bp));
    // Back went through by the gesture: what it closes goes on from where the preview had it
    // (`left`, at `left-p`). Sheets and screens slide away themselves; a page or a detail
    // view first leaves, over what is already drawn behind it (`out-t`, 0 to 1), and then
    // Back happens.
    property <string> left;
    property <float> left-p;
    property <float> out-t;
    property <duration> out-dur;
    animate out-t { duration: root.out-dur; easing: ease-in; }
    pure function drag(target: string) -> float {
        return root.left == target ? root.left-p : root.back-target == target ? root.bpe : 0;
    }
    pure function gone(target: string) -> float {
        return root.left == target ? root.out-t : 0;
    }
    // (src/android/back.rs, when the gesture is let go past its threshold)
    public function back-swiped() {
        if root.left != "" || root.bpe < 0.01 || M.anim == 0ms {
            // (no preview to go on from: a Back key on Android 14, animations off)
            root.back();
        } else {
            root.left = root.back-target;
            root.left-p = root.bpe;
            if root.left == "page" || root.left == "piece" || root.left == "unlock" || root.left == "palico" || root.left == "loadout" {
                root.out-dur = M.anim;
                root.out-t = 1;
            } else {
                root.back();
            }
        }
    }
    Timer {
        interval: M.anim + 30ms;
        running: root.left != "";
        triggered => {
            if root.out-t > 0 && root.back-target == root.left {
                root.back();
            }
            root.out-dur = 0ms;
            root.out-t = 0;
            root.left = "";
        }
    }
    // a full screen shrinking toward the side the swipe started from
    pure function shift(target: string) -> length {
        return (Api.back-from-right ? -1 : 1) * 32px * root.drag(target);
    }
    // a detail view inside a page (a piece, a set, a loadout, a Palico, an unlock list):
    // its preview and its way out, for the page
    property <float> detail-p: root.drag("piece") + root.drag("unlock") + root.drag("palico") + root.drag("loadout");
    property <float> detail-out: root.gone("piece") + root.gone("unlock") + root.gone("palico") + root.gone("loadout");

    // The destinations as one strip (gestures.slint): Overview, Items, Equipment and Quests
    // side by side, each with its tabs. A swipe past a page's last tab goes on to the next
    // destination's first tab, and back to the previous one's last; a swipe on the
    // navigation bar goes to the neighbour as a tap on it does, at the tab it had.
    property <string> peek-page;
    property <bool> bar-drag;
    function peek-dest(s: int) {
        root.peek-page = root.dests[root.dest + s].id;
        if !root.bar-drag {
            if root.peek-page == "items" {
                // (its last tab opens on the list of loadouts, not inside one)
                if Api.loadout-sel >= 0 {
                    Api.select-loadout(-1);
                }
                Tabs.select("items", s > 0 ? 0 : 2);
            } else if root.peek-page == "equipment" {
                EquipView.detail = false;
                EquipView.set-detail = false;
                Tabs.select("equipment", s > 0 ? 0 : 3);
            } else if root.peek-page == "quests" {
                Tabs.select("quests", 0);
            }
        }
        // its models, while another page is the one shown
        Gest.build-page(root.peek-page);
    }

    // a message swiped or tapped away is not shown again while it stands
    property <string> gone-toast;
    property <string> toast-now: Api.toast;
    changed toast-now => {
        if self.toast-now == "" {
            root.gone-toast = "";
        }
    }
    function snack-dismiss() {
        if Api.toast != "" {
            root.gone-toast = Api.toast;
        } else {
            root.staged-snack = false;
        }
    }

    // the snackbar: the app's message, else "added to Review" after a change
    property <int> staged: Api.change-count;
    property <bool> staged-snack;
    changed staged => {
        // (a write or Undo all brings it down: no snackbar then)
        root.staged-snack = self.staged > 0;
        snack-timer.restart();
    }
    snack-timer := Timer {
        interval: 4s;
        running: root.staged-snack;
        triggered => { root.staged-snack = false; }
    }
    property <bool> snack-shown: (Api.toast != "" && Api.toast != root.gone-toast) || (root.staged-snack && Api.loaded && !root.any-modal);

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Back && Api.back-by-callback {
                return accept;
            }
            if e.text == Key.Back || e.text == Key.Escape {
                return root.back() ? accept : reject;
            }
            if e.modifiers.control && (e.text == "z" || e.text == "Z") {
                Api.undo-last();
                return accept;
            }
            return reject;
        }

        // no save yet (or Open save…): how to open one
        if (!Api.loaded || root.open-screen) && !root.guide-open: OpenPage {
            drag: root.drag("open");
            x: root.shift("open");
            transform-scale-x: 1 - 0.1 * self.drag;
            transform-scale-y: 1 - 0.1 * self.drag;
            closable: Api.loaded;
            close => { root.open-screen = false; }
            top-inset: root.inset-top;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            guide => { root.guide-open = true; }
            export-import => { root.export-open = true; }
            menu => { root.menu-open = true; }
        }
        if (!Api.loaded || root.open-screen) && root.guide-open: RecompGuide {
            drag: root.drag("guide");
            x: root.shift("guide");
            transform-scale-x: 1 - 0.1 * self.drag;
            transform-scale-y: 1 - 0.1 * self.drag;
            top-inset: root.inset-top;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            back => { root.guide-open = false; }
        }

        // a save is open: the rail (wide windows) or the bar (phones), and the page
        if Api.loaded && !root.open-screen: Rectangle {
            property <length> rail-w: root.compact ? 0px : 80px + root.inset-left;
            property <length> bar-h: root.compact ? 80px + root.inset-bottom : 0px;
            // a sideways drag on a page or on the bar that nothing takes (a detail view, a
            // page without tabs, past the last tab) is no tap on what is under the finger.
            // Rows of chips and a text field with the cursor keep theirs (Keep)
            Claim {
                property <bool> on: !root.any-modal && Gest.sx >= parent.rail-w;
                kind: 8;
                back: self.on;
                forth: self.on;
            }
            if !root.compact: NavRail {
                x: 0;
                height: parent.height;
                items: root.dests;
                current: root.dest;
                top-inset: root.inset-top;
                left-inset: root.inset-left;
                picked(i) => {
                    if i == 4 {
                        root.drawer-open = true;
                    } else {
                        root.pick-dest(i);
                    }
                }
                menu => { root.drawer-open = true; }
                review => { Api.review-open = true; }
            }
            content := Rectangle {
                clip: strip.side != 0;
                x: parent.rail-w;
                y: 0;
                width: parent.width - parent.rail-w;
                height: parent.height - parent.bar-h;
                // room under the content for the Review button
                property <length> pad: (root.compact && Api.change-count > 0 ? 88px : 16px) + (root.compact ? 0px : root.inset-bottom);
                property <length> side: root.compact ? max(root.inset-left, root.inset-right) : root.inset-right;
                property <string> overview-sub: Api.slots[Api.slot].used ? @tr("{} · slot {} · HR {}", Api.slots[Api.slot].name, Api.slot + 1, Api.slots[Api.slot].hr) : "";
                property <float> p: root.drag("page");
                // (the page moves as the full screens do, toward the side the swipe started from)
                // the page Back goes to, while the gesture is under way
                if content.p > 0 || root.gone("page") > 0: PageLayer {
                    page: "overview";
                    title: root.page-title("overview");
                    subtitle: content.overview-sub;
                    top-inset: root.inset-top;
                    pad: content.pad;
                    side-inset: content.side;
                }
                strip := Pager {
                    kind: 5;
                    enabled: root.dest < 4 && !root.any-modal;
                    has-prev: root.dest > 0;
                    has-next: root.dest < 3;
                    // where the page's own pager would take the swipe, had it a tab that way
                    allow-next: Gest.wb[7] == Gest.touch;
                    allow-prev: Gest.wf[7] == Gest.touch;
