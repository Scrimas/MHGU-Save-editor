            }
        }
        SlotSheet {
            drag: root.drag("slot");
            top: root.back-target == "slot";
            open: root.slot-open;
            bottom-inset: root.inset-bottom;
            close => { root.slot-open = false; }
        }
        MoreSheet {
            drag: root.drag("more");
            top: root.back-target == "more";
            open: root.more-open;
            bottom-inset: root.inset-bottom;
            pages: root.more-pages;
            current: Api.page;
            close => { root.more-open = false; }
            picked(id) => { root.go(id); }
        }
        MenuSheet {
            drag: root.drag("menu");
            top: root.back-target == "menu";
            open: root.menu-open;
            bottom-inset: root.inset-bottom;
            close => { root.menu-open = false; }
            picked(id) => {
                root.menu-open = false;
                root.go(id);
            }
        }

        AboutSheet {
            drag: root.drag("about");
            top: root.back-target == "about";
            open: root.about-open;
            bottom-inset: root.inset-bottom;
            close => { root.about-open = false; }
        }
        ExportImportSheet {
            drag: root.drag("export");
            top: root.back-target == "export";
            open: root.export-open;
            bottom-inset: root.inset-bottom;
            close => { root.export-open = false; }
        }
        SnapshotsSheet {
            drag: root.drag("snapshots");
            top: root.back-target == "snapshots";
            open: Api.snapshots-open;
            bottom-inset: root.inset-bottom;
            close => {
                Api.snapshots-open = false;
                Api.restore-ask = "";
            }
        }
        ItemSheet {
            drag: root.drag("item");
            top: root.back-target == "item" || root.back-target == "item-pick";
            bottom-inset: root.inset-bottom;
        }
        FillSheet {
            drag: root.drag("fill");
            top: root.back-target == "fill";
            bottom-inset: root.inset-bottom;
        }
        EquipPickSheet {
            drag: root.drag("equip-pick");
            top: root.back-target == "equip-pick";
            bottom-inset: root.inset-bottom;
        }
        DecoSheet {
            drag: root.drag("deco-pick");
            top: root.back-target == "deco-pick";
            bottom-inset: root.inset-bottom;
        }
        RequestSheet {
            drag: root.drag("request");
            top: root.back-target == "request";
            bottom-inset: root.inset-bottom;
        }
        DeviantSheet {
            drag: root.drag("deviant");
            top: root.back-target == "deviant";
            bottom-inset: root.inset-bottom;
        }
        MonsterSheet {
            drag: root.drag("monster");
            top: root.back-target == "monster";
            bottom-inset: root.inset-bottom;
        }
        QuestSheet {
            drag: root.drag("quest");
            top: root.back-target == "quest";
            bottom-inset: root.inset-bottom;
        }
        ArenaSheet {
            drag: root.drag("arena");
            top: root.back-target == "arena";
            bottom-inset: root.inset-bottom;
        }
        CharactersSheet {
            drag: root.drag("characters");
            top: root.back-target == "characters";
            bottom-inset: root.inset-bottom;
        }
        MhxxSheet {
            drag: root.drag("mhxx");
            top: root.back-target == "mhxx";
            bottom-inset: root.inset-bottom;
        }
        ColourSheet {
            drag: root.drag("colour");
            top: root.back-target == "colour";
            bottom-inset: root.inset-bottom;
            apply(hex) => {
                if ColourEdit.kind == "look" {
                    Api.set-look-colour(ColourEdit.key, hex);
                } else {
                    Api.set-pigment(ColourEdit.where, ColourEdit.part, hex);
                }
            }
        }
        ChoiceList {
            drag: root.drag("choice");
            top: root.back-target == "choice";
            bottom-inset: root.inset-bottom;
            picked(key, n, i) => { root.choose(key, n, i); }
        }
        ChoiceSheet {
            drag: root.drag("actions");
            top: root.back-target == "actions";
            open: root.actions-open;
            bottom-inset: root.inset-bottom;
            entries: root.page-actions;
            close => { root.actions-open = false; }
            picked(i) => { root.page-action(i); }
        }
        GoalSheet {
            drag: root.drag("goal");
            top: root.back-target == "goal";
            open: root.goal-open;
            bottom-inset: root.inset-bottom;
            close => { root.goal-open = false; }
        }
        AskSheet {
            open: Api.quit-open;
            drag: root.drag("quit");
            top: root.back-target == "quit";
            bottom-inset: root.inset-bottom;
            question: @tr("Leave without writing?");
            text: @tr("The changes in Review are not in the save yet. Leaving drops them.");
            yes: @tr("Leave");
            close => { Api.quit-open = false; }
            confirmed => { Api.quit(); }
        }
        AskSheet {
            open: Api.open-ask != "";
            drag: root.drag("ask");
            top: root.back-target == "ask";
            bottom-inset: root.inset-bottom;
            question: @tr("Open another save?");
            text: @tr("The changes in Review are not in the save yet. Opening another save drops them.");
            yes: @tr("Open");
            close => { Api.open-ask = ""; }
            confirmed => { Api.open-confirmed(); }
        }
        Drawer {
            drag: root.drag("drawer");
            shown: root.drawer-open;
            entries: root.drawer;
            current: Api.page;
            top-inset: root.inset-top;
            left-inset: root.inset-left;
            close => { root.drawer-open = false; }
            picked(id) => { root.go(id); }
        }
        SettingsScreen {
            open: root.settings-open;
            drag: root.drag("settings");
            x: root.shift("settings");
            transform-scale-x: 1 - 0.1 * self.drag;
            transform-scale-y: 1 - 0.1 * self.drag;
            top-inset: root.inset-top;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            close => { root.settings-open = false; }
        }
        VersionSheet {
            open: root.settings-open;
            drag: root.drag("version");
            top: root.back-target == "version";
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
        }
        WriteScreen {
            open: Api.write-open;
            drag: root.drag("write");
            x: root.shift("write");
            transform-scale-x: 1 - 0.1 * self.drag;
            transform-scale-y: 1 - 0.1 * self.drag;
            top-inset: root.inset-top;
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
            close => { Api.write-open = false; }
            back-to-review => {
                Api.write-open = false;
                Api.review-open = true;
            }
        }
        // The snackbar, over the sheets as well (the Redo of a change undone in Review). A
        // swipe sideways or a tap sends it away at once, the way it would leave anyway.
        snack := Snack {
            // above the navigation bar; above the Review sheet while that is open and leaves
            // the room (the Redo of a change undone there: not on the sheet's own title)
            property <bool> over-review: Api.review-open && review.panel-h + self.height + 24px <= root.height - root.inset-top;
            property <length> bottom: self.over-review ? review.panel-h + 12px : Api.loaded && root.compact ? 80px + root.inset-bottom + 12px : root.inset-bottom + 12px;
            // the finger's pull, then its way out
            property <length> off;
            property <duration> off-dur;
            property <bool> away;
            animate off { duration: self.off-dur; easing: ease-out; }
            property <bool> shown: root.snack-shown;
            // (sent away: back in place once it is out of sight, for the next message)
            Timer {
                interval: M.anim + 40ms;
                running: !snack.shown && (snack.away || snack.off != 0);
                triggered => {
                    snack.off-dur = 0ms;
                    snack.off = 0;
                    snack.away = false;
                }
            }
            function leave(way: int) {
                self.off-dur = M.anim;
                self.off = way * root.width;
                self.away = true;
            }
            Timer {
                interval: M.anim;
                running: snack.away && snack.shown;
                triggered => { root.snack-dismiss(); }
            }
            width: min(root.width - 24px - root.inset-left - root.inset-right, 560px);
            x: (root.width - self.width) / 2 + self.off;
            y: root.snack-shown ? root.height - self.bottom - self.height : root.height + 8px;
            opacity: self.away && !self.shown ? 0 : 1 - 0.5 * min(1, abs(self.off) / max(1px, self.width));
            animate y { duration: M.anim; easing: ease-out; }
            text: Api.toast != "" ? Api.toast : @tr("Added to Review");
            sub: Api.toast != "" ? Api.toast-sub : "";
            action: Api.toast != "" ? Api.toast-action : @tr("Undo");
            error: Api.toast != "" && Api.toast-error;
            act => {
                if Api.toast != "" {
                    Api.toast-act();
                } else {
                    root.staged-snack = false;
                    Api.undo-last();
                }
            }
            tapped => { self.leave(1); }
            property <length> py: Gest.sy - self.absolute-position.y;
            property <bool> on: self.shown && !self.away && self.py >= 0 && self.py < self.height && Gest.sx >= self.absolute-position.x - self.off && Gest.sx < self.absolute-position.x - self.off + self.width;
            Claim {
                kind: 1;
                back: snack.on;
                forth: snack.on;
                moved(d) => {
                    snack.off-dur = 0ms;
                    snack.off = d;
                }
                ended(v) => {
                    if abs(snack.off) > 0.4 * snack.width || (abs(snack.off) > 24px && abs(v) > 350 && v * (snack.off / 1px) > 0) {
                        snack.leave(snack.off > 0 ? 1 : -1);
                    } else {
                        snack.off-dur = M.anim;
                        snack.off = 0;
                    }
                }
                cancelled => {
                    snack.off-dur = M.anim;
                    snack.off = 0;
                }
            }
        }
        // over everything (Check now opens it from Settings)
        UpdateSheet {
            drag: root.drag("update");
            top: root.back-target == "update";
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
        }
        NewsSheet {
            drag: root.drag("news");
            top: root.back-target == "news";
            bottom-inset: root.inset-bottom;
            side-inset: max(root.inset-left, root.inset-right);
        }
    }
}
