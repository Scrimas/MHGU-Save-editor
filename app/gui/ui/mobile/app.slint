                        clicked => { Api.quest-mark-selected(false); }
                    }
                    Btn {
                        horizontal-stretch: 1;
                        text: @tr("Mark cleared");
                        enabled: Api.quest-selected > 0;
                        clicked => { Api.quest-mark-selected(true); }
