                Rectangle {
                    x: strip.shift + (Api.back-from-right ? -1 : 1) * (32px * content.p + content.width * root.gone("page"));
                    width: content.width;
                    transform-scale-x: 1 - 0.1 * content.p;
                    transform-scale-y: 1 - 0.1 * content.p;
                    border-radius: 28px * content.p;
                    clip: content.p > 0;
                    PageLayer {
                        page: Api.page;
                        title: root.page-title(Api.page);
                        subtitle: Api.page == "overview" ? content.overview-sub : root.page-sub(Api.page);
                        top-inset: root.inset-top;
                        pad: content.pad;
                        side-inset: content.side;
                        back-p: root.detail-p;
                        back-out: root.detail-out;
                        actions: root.page-actions.length > 0;
                        show-actions => { root.actions-open = true; }
                        selecting: Api.page == "quests" && Api.quest-selecting;
                        leave-selection => { Api.quest-select-none(); }
                        avatar => { root.slot-open = true; }
                        open-page(page, tab) => {
