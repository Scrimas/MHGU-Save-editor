            // (not while quests are selected: the bar under the list holds the actions then)
            if root.compact && Api.change-count > 0 && !(Api.page == "quests" && Api.quest-selecting): ReviewFab {
                property <length> lift: root.snack-shown ? snack.height + 8px : 0px;
