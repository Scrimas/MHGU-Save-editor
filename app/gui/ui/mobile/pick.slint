// One choice among many (a talisman skill, a set's piece, a Hunter Art): a bottom sheet
// with a search when the list is long. Opened through the Choice global; app.slint acts
// on the pick by its key.
import { M } from "theme.slint";
import { Btn, Ico, Press, SearchBar, Sheet, Tap } from "widgets.slint";
import { Api } from "../common.slint";

export global Choice {
    in-out property <bool> open;
    in-out property <string> title;
    // what the pick sets (app.slint's choose), and its index (a set's part, an art slot)
    in-out property <string> key;
    in-out property <int> n;
    // a string the pick goes with (an option's id)
    in-out property <string> s;
    in-out property <[string]> options;
    in-out property <int> value: -1;
    in-out property <string> search;
    // the entries shown: those the search matches (Api.filter-choices)
    out property <[int]> shown: Api.filter-choices(options, search);
    public function show(key: string, n: int, title: string, options: [string], value: int) {
        Choice.key = key;
        Choice.n = n;
        Choice.title = title;
        Choice.options = options;
        Choice.value = value;
        Choice.search = "";
        Choice.open = true;
    }
    public function show-for(key: string, s: string, title: string, options: [string], value: int) {
        Choice.s = s;
        Choice.show(key, 0, title, options, value);
    }
}

export component ChoiceList inherits Sheet {
    callback picked(string, int, int);
    shown: Choice.open;
    title: Choice.title;
    content-h: Choice.options.length > 8 ? 2000px : lay.preferred-height;
    close => { Choice.open = false; }
    lay := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 8px;
        spacing: 8px;
        if Choice.options.length > 8: HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            SearchBar {
                placeholder: @tr("Search");
                text <=> Choice.search;
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            preferred-height: rows.preferred-height;
            rows := VerticalLayout {
                alignment: start;
                for i in Choice.shown: Rectangle {
                    height: max(48px, lab.preferred-height + 16px);
                    border-radius: 12px;
                    background: i == Choice.value ? M.secondary-container : transparent;
                    accessible-role: list-item;
                    accessible-label: Choice.options[i];
                    accessible-item-selected: i == Choice.value;
                    accessible-action-default => {
                        Choice.open = false;
                        root.picked(Choice.key, Choice.n, i);
                    }
                    Press { on: ta.pressed; border-radius: parent.border-radius; }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        lab := Text {
                            text: Choice.options[i];
                            color: i == Choice.value ? M.on-secondary-container : M.on-surface;
                            font-size: M.body-large;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if i == Choice.value: VerticalLayout {
                            alignment: center;
                            Ico { source: @image-url("icons/check.svg"); tint: M.on-secondary-container; }
                        }
                    }
                    ta := Tap {
                        tapped => {
                            Choice.open = false;
                            root.picked(Choice.key, Choice.n, i);
                        }
                    }
                }
            }
        }
    }
}
