import { Button, ComboBox, ListView, CheckBox, ScrollView, Palette, AboutSlint } from "std-widgets.slint";
import { Api, Tok, Card, Muted, NavButton, Dot, SlotInfo, Confidence } from "common.slint";
import { OpenPage } from "pages/open.slint";
import { OverviewPage } from "pages/overview.slint";
import { CharacterPage } from "pages/character.slint";
import { ItemsPage } from "pages/items.slint";
import { EquipmentPage } from "pages/equipment.slint";
import { PalicoesPage } from "pages/palicoes.slint";
import { QuestsPage } from "pages/quests.slint";
import { RequestsPage } from "pages/requests.slint";
import { CollectionsPage } from "pages/collections.slint";
import { MonstersPage } from "pages/monsters.slint";
import { AdvancedPage } from "pages/advanced.slint";

export { Api }

component ReviewPanel inherits Rectangle {
    background: Palette.background;
    border-width: 1px;
    border-color: Tok.line;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            Text { text: "Review"; font-size: 16px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { Api.review-open = false; } }
        }
        if Api.change-count == 0: Muted { text: "No edits yet. Every change appears here with what it writes; you can undo each one."; }
        ListView {
            vertical-stretch: 1;
            for c in Api.changes: Rectangle {
                height: max(56px, lay.preferred-height);
                lay := HorizontalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Dot { level: c.confidence; y: 14px; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: c.title; wrap: word-wrap; font-weight: 600; font-size: 12px; }
                        Text { text: c.detail; wrap: word-wrap; color: Tok.muted; font-size: 11px; }
                    }
                    Button { text: "Undo"; clicked => { Api.undo(c.id); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Tok.line; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Undo all"; enabled: Api.change-count > 0; clicked => { Api.undo-all(); } }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Write to save…";
                primary: true;
                enabled: Api.change-count > 0;
                clicked => { Api.check-emulator(); Api.write-open = true; }
            }
        }
    }
}

component WriteDialog inherits Rectangle {
    property <bool> snapshot: true;
    property <bool> done;
    background: #0008;
    TouchArea { }
    Card {
        background: Palette.background;
        width: min(520px, root.width - 32px);
        height: lay.preferred-height;
        drop-shadow-blur: 30px;
        drop-shadow-color: #0008;
        lay := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: done ? "Save written" : "Write " + Api.change-count + (Api.change-count == 1 ? " change" : " changes"); font-size: 18px; font-weight: 600; }
            if !done: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Dot { level: Api.emulator-running ? Confidence.unresolved : Confidence.confirmed; y: 6px; }
                    Text {
                        text: Api.emulator-running ? "An emulator is running. Close it first: it writes its own copy of the save on exit and would undo these changes." : "No emulator running.";
                        wrap: word-wrap;
                        color: Api.emulator-running ? Tok.bad : Palette.foreground;
                        horizontal-stretch: 1;
                    }
                    if Api.emulator-running: Button { text: "Check again"; clicked => { Api.check-emulator(); } }
                }
                CheckBox { text: "Take a snapshot of the save folder first (recommended)"; checked <=> root.snapshot; }
                Muted { text: "Snapshots go to " + Api.snapshot-dir; font-size: 11px; }
                Text { text: "These files get the same bytes (each keeps its own header):"; font-size: 12px; }
                for t in Api.write-targets: Text { text: "  " + t; font-size: 11px; color: Tok.muted; overflow: elide; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { Api.write-open = false; } }
                    Button {
                        text: root.snapshot ? "Snapshot and write" : "Write without snapshot";
                        primary: true;
                        enabled: !Api.emulator-running;
                        clicked => { root.done = Api.write(root.snapshot); }
                    }
                }
            }
            if done: VerticalLayout {
                spacing: 10px;
                Text { text: Api.write-step-info; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Show snapshots"; clicked => { Api.open-snapshots(); } }
                    Button { text: "Done"; primary: true; clicked => { root.done = false; Api.write-open = false; } }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: Api.loaded ? "MHGU Save Editor — " + Api.file-path : "MHGU Save Editor";
    icon: @image-url("../assets/icon.svg");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 760px;
    min-height: 520px;
    background: Palette.background;
    // Columns are placed by hand: a layout whose widths depend on the window width
    // would feed back into the window's own size constraints.
    property <bool> dock: root.width >= 1440px;
    property <length> side: root.width >= 1000px ? 216px : 184px;
    property <length> review-w: Api.review-open && dock ? 360px : 0px;

    Rectangle {
        // sidebar
        Rectangle {
            x: 0;
            width: side;
            height: root.height;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Text { text: "MHGU Save Editor"; font-size: 15px; font-weight: 700; height: 34px; vertical-alignment: center; x: 10px; }
                if Api.loaded: VerticalLayout {
                    spacing: 6px;
                    padding-bottom: 8px;
                    ComboBox {
                        model: [Api.slots[0].used ? "1 · " + Api.slots[0].name : "1 · empty", Api.slots[1].used ? "2 · " + Api.slots[1].name : "2 · empty", Api.slots[2].used ? "3 · " + Api.slots[2].name : "3 · empty"];
                        current-index: Api.slot;
                        selected => { Api.select-slot(self.current-index); }
                    }
                    Muted { text: "HR " + Api.slots[Api.slot].hr + " · " + Api.slots[Api.slot].playtime; font-size: 11px; x: 6px; }
                }
                for p in [
                    {id: "overview", t: "Overview"}, {id: "character", t: "Character"}, {id: "items", t: "Items"},
                    {id: "equipment", t: "Equipment"}, {id: "palicoes", t: "Palicoes"}, {id: "quests", t: "Quests"},
                    {id: "requests", t: "Requests"}, {id: "collections", t: "Collections"}, {id: "monsters", t: "Monsters"},
                    {id: "advanced", t: "Save map"},
                ]: NavButton {
                    text: p.t;
                    active: Api.page == p.id;
                    enabled: Api.loaded && Api.slots[Api.slot].used;
                    clicked => { Api.page = p.id; }
                }
                Rectangle { vertical-stretch: 1; }
                NavButton { text: "Open another save…"; clicked => { Api.open-dialog(); } }
                NavButton { text: "About"; clicked => { about.show(); } }
            }
        }
        Rectangle {
            x: side;
            width: root.width - side - review-w;
            height: root.height;
            // top bar
            Rectangle {
                y: 0;
                height: 52px;
                visible: Api.loaded;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 14px;
                    spacing: 10px;
                    Text { text: Api.file-path; color: Tok.muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Button {
                        y: 10px;
                        height: 32px;
                        text: Api.change-count == 0 ? "Review" : "Review (" + Api.change-count + ")";
                        checkable: true;
                        checked: Api.review-open;
                        clicked => { Api.review-open = !Api.review-open; }
                    }
                    Button {
                        y: 10px;
                        height: 32px;
                        text: "Write…";
                        primary: Api.change-count > 0;
                        enabled: Api.change-count > 0;
                        clicked => { Api.check-emulator(); Api.write-open = true; }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Tok.line; }
            }
            Rectangle {
                y: Api.loaded ? 52px : 0px;
                height: parent.height - self.y;
                Rectangle {
                    if Api.page == "open": OpenPage { }
                    if Api.page == "overview": OverviewPage { }
                    if Api.page == "character": CharacterPage { }
                    if Api.page == "items": ItemsPage { }
                    if Api.page == "equipment": EquipmentPage { }
                    if Api.page == "palicoes": PalicoesPage { }
                    if Api.page == "quests": QuestsPage { }
                    if Api.page == "requests": RequestsPage { }
                    if Api.page == "collections": CollectionsPage { }
                    if Api.page == "monsters": MonstersPage { }
                    if Api.page == "advanced": AdvancedPage { }
                }
            }
        }
        if Api.review-open && dock: ReviewPanel { x: root.width - 360px; width: 360px; height: root.height; }
    }
    if Api.review-open && !dock: Rectangle {
        background: #0005;
        TouchArea { clicked => { Api.review-open = false; } }
        ReviewPanel { x: parent.width - self.width; width: min(380px, parent.width - 40px); height: parent.height; }
    }
    if Api.write-open: WriteDialog { }
    if Api.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: min(t.preferred-width + 32px, parent.width - 32px);
        height: t.preferred-height + 20px;
        border-radius: 8px;
        background: Api.toast-error ? Tok.bad : Palette.foreground;
        t := Text { text: Api.toast; color: Palette.background; wrap: word-wrap; width: parent.width - 32px; horizontal-alignment: center; }
    }
    about := PopupWindow {
        x: (root.width - 420px) / 2;
        y: 80px;
        width: 420px;
        close-policy: close-on-click-outside;
        Card {
            background: Palette.background;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0006;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "MHGU Save Editor"; font-size: 16px; font-weight: 600; }
                Muted { text: Api.build-info; }
                Muted { text: "Built on the notes of the mhgu-save-reverse-engineering project. Monster Hunter and its assets are © CAPCOM; this is an unofficial fan tool."; }
                AboutSlint { }
            }
        }
    }
}
