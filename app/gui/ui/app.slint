import { Button, ComboBox, ListView, CheckBox, ScrollView, Palette, AboutSlint, LineEdit, ProgressIndicator } from "std-widgets.slint";
import {
    Api, Win, Tok, Fmt, Card, Muted, NavButton, Dot, SlotInfo, Confidence, ConfidenceTag, Hairline, TextLink,
    Modal, EmptyState, ChangeRow, Chevron, SectionTitle, Reveal, SettingsInfo, KeyActivate, FocusRing,
} from "common.slint";
import { OpenPage } from "pages/open.slint";
import { OverviewPage } from "pages/overview.slint";
import { CharacterPage } from "pages/character.slint";
import { ItemsPage } from "pages/items.slint";
import { EquipmentPage } from "pages/equipment.slint";
import { PalicoesPage } from "pages/palicoes.slint";
import { QuestsPage } from "pages/quests.slint";
import { RequestsPage } from "pages/requests.slint";
import { CollectionsPage } from "pages/collections.slint";
import { MonstersPage } from "pages/monsters.slint";
import { DatabasePage } from "pages/database.slint";
import { AdvancedPage } from "pages/advanced.slint";

export { Api, Fmt }

// One Review entry (mockup A1): old → new per value, Undo, a click opens the field.
component ReviewEntry inherits VerticalLayout {
    in property <ChangeRow> c;
    spacing: 6px;
    if c.first: Text {
        text: c.group;
        font-size: Tok.small;
        font-weight: 600;
        color: Tok.muted;
        height: 28px;
        vertical-alignment: bottom;
    }
    Rectangle {
        border-radius: Tok.radius;
        border-width: 1px;
        border-color: Tok.line;
        background: ta.has-hover ? Tok.hover : transparent;
        height: body.preferred-height;
        accessible-role: button;
        accessible-label: c.single ? @tr("{}: {} to {}. Opens the field.", c.title, c.old, c.new) : @tr("{}. Opens the field.", c.title);
        accessible-action-default => { Api.goto(c.key); }
        fk := KeyActivate { activated => { Api.goto(c.key); } }
        FocusRing { shown: fk.has-focus; border-radius: Tok.radius; }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Api.goto(c.key); }
        }
        Rectangle { x: 0; width: 3px; border-radius: 1.5px; background: Tok.accent; }
        // no spacing: the rows below bring the 4px above them, so collapsed Reveals cost nothing
        body := VerticalLayout {
            padding: 12px;
            padding-left: 16px;
            HorizontalLayout {
                spacing: Tok.tight;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: c.title; font-weight: 600; overflow: elide; }
                    Reveal {
                        shown: c.sub != "";
                        Muted { text: c.sub; }
                    }
                    Reveal {
                        shown: c.warning != "";
                        Text { text: c.warning; color: Tok.bad; font-size: Tok.small; wrap: word-wrap; }
                    }
                }
                if c.single: Text { text: c.old; color: Tok.muted; vertical-alignment: center; }
                if c.single: Text { text: "→"; color: Tok.muted; vertical-alignment: center; }
                if c.single: Text { text: c.new; font-weight: 600; vertical-alignment: center; }
                if c.confidence != Confidence.confirmed: ConfidenceTag { level: c.confidence; info: false; }
                Button { text: @tr("Undo"); clicked => { Api.undo(c.id); } }
            }
            for l in c.lines: HorizontalLayout {
                spacing: Tok.tight;
                padding-top: 4px;
                height: 34px;
                Text { text: l.label; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                if l.warning != "": Text { text: l.warning; color: Tok.bad; font-size: Tok.small; vertical-alignment: center; overflow: elide; max-width: 220px; }
                Text { text: l.old; color: Tok.muted; vertical-alignment: center; }
                Text { text: "→"; color: Tok.muted; vertical-alignment: center; }
                Text { text: l.new; font-weight: 600; vertical-alignment: center; }
            }
            Reveal {
                shown: c.more > 0;
                gap: 4px;
                Muted { text: @tr("and {} more", Fmt.num(c.more)); }
            }
            Reveal {
                shown: c.note != "";
                gap: 4px;
                Muted { text: c.note; }
            }
        }
    }
}

component ReviewPanel inherits Rectangle {
    background: Tok.raised;
    border-width: 1px;
    border-color: Tok.line;
    VerticalLayout {
        padding: Tok.pad;
        spacing: 10px;
        HorizontalLayout {
            spacing: Tok.tight;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: @tr("Review"); font-size: Tok.section; font-weight: 600; }
                Muted { text: Api.review-summary; }
            }
            Button { text: @tr("Close"); clicked => { Api.review-open = false; } }
        }
        if Api.change-count == 0: EmptyState {
            vertical-stretch: 1;
            text: @tr("Nothing staged yet. Every edit appears here with the value it replaces, and you can undo each one.");
        }
        if Api.change-count > 0: ListView {
            vertical-stretch: 1;
            for c in Api.changes: ReviewEntry { c: c; }
        }
        Hairline { }
        HorizontalLayout {
            spacing: 6px;
            Dot { level: Confidence.derived; y: 5px; }
            Muted {
                text: @tr("Derived: worked out from the game's code, not yet checked in game. Untagged changes are confirmed in game.");
                horizontal-stretch: 1;
            }
        }
        if Api.warn-count > 0: HorizontalLayout {
            spacing: 6px;
            Dot { level: Confidence.unresolved; y: 5px; background: Tok.bad; }
            Muted {
                text: Api.warn-why;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            spacing: Tok.tight;
            Button { text: @tr("Undo all"); enabled: Api.change-count > 0; clicked => { Api.undo-all(); } }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Write…");
                primary: true;
                enabled: Api.change-count > 0;
                clicked => { Api.check-emulator(); Api.write-open = true; }
            }
        }
    }
}

// Write dialog (mockup A2): what changes, then the checks, then the files.
component WriteDialog inherits Modal {
    property <bool> snapshot: Api.settings.snapshot-first;
    property <bool> paths;
    card-width: 560px;
    dismiss => { Api.write-open = false; }
    Text { text: Api.write-title; font-size: 20px; font-weight: 600; wrap: word-wrap; }
    Muted { text: Api.write-sub; }
    SectionTitle { text: @tr("What changes"); font-size: Tok.small; color: Tok.muted; }
    Rectangle {
        border-radius: Tok.radius;
        border-width: 1px;
        border-color: Tok.line;
        height: min(rows.preferred-height, 220px);
        Flickable {
            content-height: rows.preferred-height;
            rows := VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                for r[i] in Api.write-rows: Rectangle {
                    height: 40px;
                    if i > 0: Hairline { y: 0; width: parent.width; }
                    HorizontalLayout {
                        spacing: Tok.tight;
                        Text { text: r.title; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if r.warning != "": Text { text: r.warning; color: Tok.bad; font-size: Tok.small; vertical-alignment: center; overflow: elide; max-width: 200px; }
                        if r.right != "": Text { text: r.right; color: Tok.muted; vertical-alignment: center; }
                        if r.old != "": Text { text: r.old; color: Tok.muted; vertical-alignment: center; }
                        if r.old != "": Text { text: "→"; color: Tok.muted; vertical-alignment: center; }
                        if r.new != "": Text { text: r.new; font-weight: 600; vertical-alignment: center; }
                        if r.confidence != Confidence.confirmed: ConfidenceTag { level: r.confidence; info: false; }
                    }
                }
            }
        }
    }
    TextLink {
        text: @tr("Back to Review");
        font-weight: 400;
        clicked => {
            Api.write-open = false;
            Api.review-open = true;
        }
    }
    SectionTitle { text: @tr("Before writing"); font-size: Tok.small; color: Tok.muted; }
    HorizontalLayout {
        spacing: 10px;
        Dot { level: Api.emulator-running ? Confidence.unresolved : Confidence.confirmed; y: 7px; background: Api.emulator-running ? Tok.bad : Tok.ok; }
        VerticalLayout {
            horizontal-stretch: 1;
            Text {
                text: Api.emulator-running ? @tr("{} is running", Api.emulator-name) : @tr("{} is not running", Api.emulator-name);
                font-weight: Api.emulator-running ? 600 : 400;
                wrap: word-wrap;
            }
            Reveal {
                shown: Api.emulator-running;
                Muted { text: @tr("Close it first: it overwrites the save when it exits."); }
            }
        }
        if Api.emulator-running: Button { text: @tr("Check again"); clicked => { Api.check-emulator(); } }
    }
    VerticalLayout {
        CheckBox { text: @tr("Take a snapshot first (recommended)"); checked <=> root.snapshot; }
        VerticalLayout {
            padding-top: 2px;
            padding-left: 28px;
            Muted { text: @tr("You can restore it any time from Snapshots in the sidebar."); }
        }
        Reveal {
            shown: Api.derived-count > 0;
            gap: Tok.gap;
            HorizontalLayout {
                spacing: 10px;
                Dot { level: Confidence.derived; y: 6px; }
                Text {
                    text: root.snapshot
                        ? @tr("{n} change is Derived: worked out from the game's code, not yet checked in game. Keep the snapshot on." | "{n} changes are Derived: worked out from the game's code, not yet checked in game. Keep the snapshot on." % Api.derived-count)
                        : @tr("{n} change is Derived: worked out from the game's code, not yet checked in game. A snapshot lets you go back." | "{n} changes are Derived: worked out from the game's code, not yet checked in game. A snapshot lets you go back." % Api.derived-count);
                    color: Tok.warn;
                    font-size: Tok.small;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
        // written as they are: a warning, never a refusal
        Reveal {
            shown: Api.warn-count > 0;
            gap: Tok.gap;
            HorizontalLayout {
                spacing: 10px;
                Dot { level: Confidence.unresolved; y: 6px; background: Tok.bad; }
                Text {
                    text: @tr("{n} value the game cannot produce is written as it is." | "{n} values the game cannot produce are written as they are." % Api.warn-count) + " " + Api.warn-why;
                    color: Tok.bad;
                    font-size: Tok.small;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
    SectionTitle { text: @tr("Files"); font-size: Tok.small; color: Tok.muted; }
    VerticalLayout {
        HorizontalLayout {
            spacing: Tok.tight;
            Text {
                text: Api.write-targets.length == 1 ? @tr("The data goes into the save file.") : @tr("The same data goes into all {n} save file." | "The same data goes into all {n} save files." % Api.write-targets.length);
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 4px;
                TextLink {
                    text: root.paths ? @tr("Hide paths") : @tr("Show paths");
                    font-weight: 400;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.paths = !root.paths; }
                }
                Chevron { dir: root.paths ? "up" : "down"; y: (parent.height - self.height) / 2; stroke: Tok.accent-text; }
            }
        }
        Reveal {
            shown: root.paths;
            gap: Tok.gap;
            spacing: 2px;
            Muted { text: @tr("The emulator keeps two copies of the save, each with a backup; every one gets the same bytes and keeps its own header."); }
            for t in Api.write-targets: Text { text: t; font-size: Tok.small; color: Tok.muted; font-family: "monospace"; overflow: elide; }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: Tok.tight;
        Button { text: @tr("Cancel"); clicked => { Api.write-open = false; } }
        Button {
            text: root.snapshot ? @tr("Snapshot and write") : @tr("Write without snapshot");
            primary: true;
            enabled: !Api.emulator-running;
            clicked => {
                if Api.write(root.snapshot) {
                    Api.write-open = false;
                }
            }
        }
    }
}

// Snapshots (mockup A3): every copy taken before a write, with Restore.
component SnapshotsDialog inherits Modal {
    card-width: 560px;
    dismiss => {
        Api.snapshots-open = false;
        Api.restore-ask = "";
    }
    // the list, or the Restore question; Reveals rather than `if` (see Reveal)
    VerticalLayout {
        Reveal {
            shown: Api.restore-ask == "";
            spacing: Tok.gap;
            Text { text: @tr("Snapshots"); font-size: 20px; font-weight: 600; }
            Muted { text: @tr("A copy of the whole save folder, taken before each write and before each restore."); }
            VerticalLayout {
                Reveal {
                    shown: Api.snapshots.length == 0;
                    EmptyState { text: @tr("No snapshots of this save yet. Write takes one first unless you untick it."); }
                }
                if Api.snapshots.length > 0: Rectangle {
                    border-radius: Tok.radius;
                    border-width: 1px;
                    border-color: Tok.line;
                    height: min(list.preferred-height, 320px);
                    Flickable {
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            for s[i] in Api.snapshots: Rectangle {
                                height: 58px;
                                if i > 0: Hairline { y: 0; width: parent.width; }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: Tok.tight;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: s.when; overflow: elide; }
                                        Muted { text: s.before; wrap: no-wrap; overflow: elide; }
                                    }
                                    Button {
                                        y: (parent.height - 32px) / 2;
                                        height: 32px;
                                        text: @tr("Restore…");
                                        clicked => {
                                            Api.restore-ask = s.dir;
                                            Api.restore-when = s.when;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Tok.tight;
                Text { text: Api.snapshot-dir; color: Tok.muted; font-size: Tok.small; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: @tr("Open folder"); clicked => { Api.open-snapshots(); } }
                Button { text: @tr("Close"); clicked => { Api.snapshots-open = false; } }
            }
        }
        Reveal {
            shown: Api.restore-ask != "";
            spacing: Tok.gap;
            Text { text: @tr("Restore the save from {}?", Api.restore-when); font-size: 20px; font-weight: 600; wrap: word-wrap; }
            VerticalLayout {
                Muted { text: @tr("Every save file goes back to that copy. The save as it is now is snapshotted first, so you can undo this from Snapshots."); }
                Reveal {
                    shown: Api.change-count > 0;
                    gap: Tok.gap;
                    Text {
                        text: @tr("Your staged change is dropped." | "Your {n} staged changes are dropped." % Api.change-count);
                        color: Tok.warn;
                        font-size: Tok.small;
                        wrap: word-wrap;
                    }
                }
                Reveal {
                    shown: Api.emulator-running;
                    gap: Tok.gap;
                    Text { text: @tr("{} is running. Close it first: it overwrites the save when it exits.", Api.emulator-name); color: Tok.bad; font-size: Tok.small; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tok.tight;
                Button { text: @tr("Cancel"); clicked => { Api.restore-ask = ""; } }
                Button {
                    text: @tr("Restore");
                    primary: true;
                    enabled: !Api.emulator-running;
                    clicked => {
                        Api.restore(Api.restore-ask);
                        Api.restore-ask = "";
                    }
                }
            }
        }
    }
}

// One setting: what it is on the left, its controls on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: Tok.tight;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.title; wrap: word-wrap; }
        Reveal {
            shown: root.hint != "";
            gap: 2px;
            Muted { text: root.hint; }
        }
    }
    // controls keep their own height beside a two-line hint
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: Tok.tight;
            @children
        }
    }
}

// A path or name that can be taken out of a list.
component RemovableRow inherits HorizontalLayout {
    in property <string> text;
    callback remove();
    spacing: Tok.tight;
    padding-left: 12px;
    Text { text: root.text; font-size: Tok.small; font-family: "monospace"; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
    Button { text: @tr("Remove"); clicked => { root.remove(); } }
}

component SettingsDialog inherits Modal {
    property <SettingsInfo> s: Api.settings;
    property <string> emulator;
    card-width: 600px;
    dismiss => { Api.settings-open = false; }
    Text { text: @tr("Settings"); font-size: 20px; font-weight: 600; }
    Flickable {
        height: min(body.preferred-height, Win.height - 190px);
        content-height: body.preferred-height;
        body := VerticalLayout {
            spacing: Tok.gap;
            SectionTitle { text: @tr("Appearance"); }
            SettingRow {
                title: @tr("Language");
                ComboBox {
                    width: 210px;
                    model: s.languages;
                    current-index: s.language;
                    selected => { Api.set-setting("language", self.current-index); }
                }
            }
            SettingRow {
                title: @tr("Theme");
                ComboBox {
                    width: 170px;
                    model: [@tr("System"), @tr("Light"), @tr("Dark")];
                    current-index: s.theme;
                    selected => { Api.set-setting("theme", self.current-index); }
                }
            }
            if s.matugen-offered: VerticalLayout {
                spacing: Tok.tight;
                CheckBox {
                    text: @tr("Colours from matugen (the wallpaper's palette)");
                    checked: s.matugen;
                    toggled => { Api.set-setting("matugen", self.checked ? 1 : 0); }
                }
                if s.matugen && s.matugen-hint != "": Muted { text: s.matugen-hint; }
                if s.matugen && !Api.colors-on: HorizontalLayout {
                    spacing: Tok.tight;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Tok.input;
                        border-radius: Tok.radius;
                        border-width: 1px;
                        border-color: Tok.input-border;
                        height: snippet.preferred-height + 16px;
                        // selectable, to copy into config.toml
                        snippet := TextInput {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: s.matugen-snippet;
                            read-only: true;
                            single-line: false;
                            wrap: char-wrap;
                            font-size: Tok.small;
                            font-family: "monospace";
                            color: Palette.foreground;
                        }
                    }
                    Button {
                        text: s.matugen-template ? @tr("Template saved") : @tr("Save template");
                        enabled: !s.matugen-template;
                        clicked => { Api.save-matugen-template(); }
                    }
                }
            }
            SettingRow {
                title: @tr("Interface size");
                hint: s.scale-now;
                ComboBox {
                    width: 170px;
                    model: [@tr("System"), "100 %", "125 %", "150 %", "175 %", "200 %"];
                    current-index: s.scale;
                    selected => { Api.set-setting("scale", self.current-index); }
                }
            }
            Hairline { }
            SectionTitle { text: @tr("Snapshots"); }
            SettingRow {
                title: @tr("Snapshot folder");
                hint: s.snapshot-dir;
                Button { text: @tr("Change…"); clicked => { Api.pick-snapshot-dir(); } }
                Button { text: @tr("Default"); enabled: s.snapshot-custom; clicked => { Api.set-setting("snapshot-default-dir", 0); } }
            }
            SettingRow {
                title: @tr("Keep per save");
                hint: @tr("After each new snapshot, the oldest beyond this number are deleted.");
                ComboBox {
                    width: 170px;
                    model: [@tr("All"), @tr("Last {}", 5), @tr("Last {}", 10), @tr("Last {}", 20), @tr("Last {}", 50)];
                    current-index: s.keep;
                    selected => { Api.set-setting("keep", self.current-index); }
                }
            }
            CheckBox {
                text: @tr("Tick \"Take a snapshot first\" in the Write dialog");
                checked: s.snapshot-first;
                toggled => { Api.set-setting("snapshot-first", self.checked ? 1 : 0); }
            }
            Hairline { }
            SectionTitle { text: @tr("Saves"); }
            CheckBox {
                text: @tr("Open the last save on start");
                checked: s.reopen;
                toggled => { Api.set-setting("reopen", self.checked ? 1 : 0); }
            }
            SettingRow {
                title: @tr("Recent saves");
                hint: s.recent == 0 ? @tr("None yet") : @tr("{n} save listed on the Open page" | "{n} saves listed on the Open page" % s.recent);
                Button { text: @tr("Clear"); enabled: s.recent > 0; clicked => { Api.clear-recent(); } }
            }
            SettingRow {
                title: @tr("Save folders");
                hint: @tr("Searched for saves besides the folders found on their own (Ryujinx, the yuzu family): portable installs or any other folder.");
                Button { text: @tr("Add folder…"); clicked => { Api.add-save-folder(); } }
            }
            for f[i] in s.folders: RemovableRow {
                text: f;
                remove => { Api.remove-save-folder(i); }
            }
            Hairline { }
            SectionTitle { text: @tr("Emulator check"); }
            Muted { text: @tr("Write and Restore wait while an emulator runs, since it overwrites the save when it exits. Always checked: {}.", s.builtin); }
            HorizontalLayout {
                spacing: Tok.tight;
                LineEdit {
                    placeholder-text: @tr("Another process name");
                    text <=> root.emulator;
                    accepted => {
                        Api.add-emulator(root.emulator);
                        root.emulator = "";
                    }
                }
                Button {
                    text: @tr("Add");
                    enabled: root.emulator != "";
                    clicked => {
                        Api.add-emulator(root.emulator);
                        root.emulator = "";
                    }
                }
            }
            for e[i] in s.emulators: RemovableRow {
                text: e;
                remove => { Api.remove-emulator(i); }
            }
            Hairline { }
            SectionTitle { text: @tr("Safety"); }
            CheckBox {
                text: @tr("Confirmed changes only");
                checked: s.confirmed-only;
                toggled => { Api.set-setting("confirmed-only", self.checked ? 1 : 0); }
            }
            Muted { text: @tr("Changes tagged Derived (worked out from the game's code, not yet checked in game) are refused. Changes already in Review stay."); }
            Hairline { }
            SectionTitle { text: @tr("Updates"); }
            CheckBox {
                text: @tr("Check for a new version on start");
                checked: s.check-updates;
                toggled => { Api.set-setting("check-updates", self.checked ? 1 : 0); }
            }
            SettingRow {
                title: @tr("Version");
                hint: Api.update.status;
                Button {
                    text: @tr("Check now");
                    enabled: Api.update.state != "checking" && Api.update.state != "downloading" && Api.update.state != "ready";
                    clicked => { Api.check-update(); }
                }
                if Api.update.state == "available" || Api.update.state == "failed" || Api.update.state == "ready": Button {
                    text: Api.update.state == "ready" ? @tr("Restart…") : @tr("Update…");
                    clicked => { Api.update-open = true; }
                }
            }
            Muted { text: @tr("Asks GitHub for the latest release. Nothing is downloaded until you choose to update."); }
        }
    }
    HorizontalLayout {
        alignment: end;
        Button { text: @tr("Close"); primary: true; clicked => { Api.settings-open = false; } }
    }
}

export component AppWindow inherits Window {
    title: Api.loaded ? @tr("MHGU Save Editor — {}", Api.file-path) : @tr("MHGU Save Editor");
    icon: @image-url("../assets/icon.svg");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 760px;
    min-height: 520px;
    background: Tok.page;
    // Columns are placed by hand: a layout whose widths depend on the window width
    // would feed back into the window's own size constraints.
    property <bool> dock: root.width >= 1440px;
    property <length> side: root.width >= 1000px ? 220px : 188px;
    animate side { duration: 180ms; easing: ease-in-out; }
    property <bool> about-open;
    init => {
        Win.width = self.width;
        Win.height = self.height;
    }
    changed width => { Win.width = self.width; }
    changed height => { Win.height = self.height; }
    property <string> popup-request: Api.snapshot-popup;
    changed popup-request => {
        if popup-request == "about" {
            Api.snapshot-popup = "";
            root.about-open = true;
        } else if popup-request == "path" {
            Api.snapshot-popup = "";
            path-pop.show();
        } else if popup-request == "settings" {
            Api.snapshot-popup = "";
            Api.settings-open = true;
        }
    }
    property <string> scheme: Api.force-scheme;
    changed scheme => {
        if scheme == "light" {
            Palette.color-scheme = ColorScheme.light;
        } else if scheme == "dark" {
            Palette.color-scheme = ColorScheme.dark;
        } else if scheme == "system" {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    // Review slides in and out (open), and the pages make room for it while docked (dk)
    property <float> open: Api.review-open ? 1 : 0;
    animate open { duration: 180ms; easing: ease-in-out; }
    property <float> dk: dock ? 1 : 0;
    animate dk { duration: 180ms; easing: ease-in-out; }
    property <length> review-w: 380px * open * dk;
    property <[string]> nav-ids: ["overview", "character", "items", "equipment", "palicoes", "quests", "requests", "collections", "monsters", "database", "advanced"];
    property <[string]> nav-titles: [@tr("Overview"), @tr("Character"), @tr("Items"), @tr("Equipment"), @tr("Palicoes"), @tr("Quests"), @tr("Requests"), @tr("Collections"), @tr("Monsters"), @tr("Database"), @tr("Save map")];
    // Shortcuts: Ctrl+S Write…, Ctrl+Z undo the latest change, Ctrl+F search the page,
    // Ctrl+O open a save, Escape closes Review. Dialogs take the keyboard while open
    // (Modal); when the last one closes the window takes it back.
    forward-focus: keys;
    property <string> page-now: Api.page;
    changed page-now => { Api.page-shown(); }
    property <bool> any-modal: Api.write-open || Api.snapshots-open || Api.settings-open || Api.update-open || Api.quit-open || Api.open-ask != "" || root.about-open;
    changed any-modal => {
        if !any-modal {
            keys.focus();
        }
    }
    // the whole window, so keys a field does not use reach it (its children keep the
    // indentation they had before it)
    keys := FocusScope {
    key-pressed(e) => {
        if e.modifiers.control && !e.modifiers.alt {
            if e.text == "s" || e.text == "S" {
                if Api.change-count > 0 {
                    Api.check-emulator();
                    Api.write-open = true;
                }
                return accept;
            }
            if e.text == "z" || e.text == "Z" {
                Api.undo-last();
                return accept;
            }
            if e.text == "f" || e.text == "F" {
                Api.search-seq += 1;
                return accept;
            }
            if e.text == "o" || e.text == "O" {
                Api.open-dialog();
                return accept;
            }
        }
        if e.text == Key.Escape && Api.review-open {
            Api.review-open = false;
            return accept;
        }
        return reject;
    }

    Rectangle {
        // sidebar
        Rectangle {
            x: 0;
            width: side;
            height: root.height;
            background: Tok.side;
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Text { text: @tr("MHGU Save Editor"); font-size: 15px; font-weight: 700; height: 36px; vertical-alignment: center; x: 10px; }
                if Api.loaded: VerticalLayout {
                    spacing: 6px;
                    padding-bottom: 8px;
                    ComboBox {
                        model: [Api.slots[0].used ? "1 · " + Api.slots[0].name : @tr("{} · empty", 1), Api.slots[1].used ? "2 · " + Api.slots[1].name : @tr("{} · empty", 2), Api.slots[2].used ? "3 · " + Api.slots[2].name : @tr("{} · empty", 3)];
                        current-index: Api.slot;
                        selected => { Api.select-slot(self.current-index); }
                    }
                    Muted { text: Api.slots[Api.slot].used ? @tr("HR {} · {}", Api.slots[Api.slot].hr, Api.slots[Api.slot].playtime) : @tr("No character in this slot"); x: 6px; }
                }
                for id[i] in root.nav-ids: NavButton {
                    text: root.nav-titles[i];
                    count: Api.page-counts[i];
                    active: Api.page == id;
                    enabled: Api.loaded && Api.slots[Api.slot].used;
                    clicked => { Api.page = id; }
                }
                Rectangle { vertical-stretch: 1; }
                NavButton {
                    text: @tr("Snapshots…");
                    enabled: Api.loaded;
                    clicked => {
                        Api.list-snapshots();
                        Api.snapshots-open = true;
                    }
                }
                NavButton { text: @tr("Open save…"); clicked => { Api.open-dialog(); } }
                NavButton { text: @tr("Settings…"); clicked => { Api.settings-open = true; } }
                NavButton { text: @tr("About"); clicked => { root.about-open = true; } }
            }
        }
        Rectangle {
            x: side;
            width: root.width - side - review-w;
            height: root.height;
            // top bar
            Rectangle {
                y: 0;
                height: 52px;
                visible: Api.loaded;
                HorizontalLayout {
                    padding-left: Tok.margin;
                    padding-right: 14px;
                    spacing: 10px;
                    // the path shortened from the start; a click shows all of it (K2)
                    Rectangle {
                        horizontal-stretch: 1;
                        path-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { path-pop.show(); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if Api.path-label != "": Text { text: Api.path-label; color: Tok.muted; font-size: Tok.small; vertical-alignment: center; }
                            Text {
                                text: Api.path-tail;
                                color: path-ta.has-hover ? Palette.foreground : Tok.muted;
                                font-size: Tok.small;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        path-pop := PopupWindow {
                            x: 0;
                            y: parent.height - 6px;
                            width: min(640px, root.width - side - 48px);
                            close-policy: close-on-click-outside;
                            Rectangle {
                                background: Tok.raised;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Tok.line;
                                drop-shadow-blur: 20px;
                                drop-shadow-color: #0006;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    Text { text: @tr("Save file"); font-weight: 600; }
                                    path-text := TextInput {
                                        text: Api.file-path;
                                        read-only: true;
                                        wrap: char-wrap;
                                        font-size: Tok.small;
                                        font-family: "monospace";
                                        color: Palette.foreground;
                                    }
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: Tok.tight;
                                        Button { text: @tr("Open folder"); clicked => { Api.open-folder(); path-pop.close(); } }
                                        Button {
                                            text: @tr("Copy");
                                            clicked => {
                                                path-text.select-all();
                                                path-text.copy();
                                                Api.copy-path();
                                                path-pop.close();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if Api.value-count > 0: HorizontalLayout {
                        spacing: 6px;
                        horizontal-stretch: 0;
                        Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Tok.accent; y: (parent.height - self.height) / 2; }
                        Text {
                            text: @tr("{} value not written yet" | "{} values not written yet" % Api.value-count, Fmt.num(Api.value-count));
                            color: Tok.accent-text;
                            font-size: Tok.small;
                            vertical-alignment: center;
                        }
                    }
                    // only Write uses the accent; Review is a plain button (C12)
                    Button {
                        y: 10px;
                        height: 32px;
                        text: Api.change-count == 0 ? @tr("Review") : @tr("Review ({})", Api.change-count);
                        clicked => { Api.review-open = !Api.review-open; }
                    }
                    Button {
                        y: 10px;
                        height: 32px;
                        text: @tr("Write…");
                        primary: Api.change-count > 0;
                        enabled: Api.change-count > 0;
                        clicked => { Api.check-emulator(); Api.write-open = true; }
                    }
                }
                Hairline { y: parent.height - 1px; width: parent.width; }
            }
            Rectangle {
                y: Api.loaded ? 52px : 0px;
                height: parent.height - self.y;
                // an empty character slot has no pages: nothing there can be edited
                property <bool> char-ok: !Api.loaded || Api.slots[Api.slot].used;
                Rectangle {
                    if Api.page == "open": OpenPage { }
                    if !char-ok && Api.page != "open": EmptyState {
                        text: @tr("Character slot {} is empty. Pick a character in the sidebar; a new one is made in game.", Api.slot + 1);
                    }
                    if char-ok && Api.page == "overview": OverviewPage { }
                    if char-ok && Api.page == "character": CharacterPage { }
                    if char-ok && Api.page == "items": ItemsPage { }
                    if char-ok && Api.page == "equipment": EquipmentPage { }
                    if char-ok && Api.page == "palicoes": PalicoesPage { }
                    if char-ok && Api.page == "quests": QuestsPage { }
                    if char-ok && Api.page == "requests": RequestsPage { }
                    if char-ok && Api.page == "collections": CollectionsPage { }
                    if char-ok && Api.page == "monsters": MonstersPage { }
                    if char-ok && Api.page == "database": DatabasePage { }
                    if char-ok && Api.page == "advanced": AdvancedPage { }
                }
            }
        }
        if root.open > 0 && dock: ReviewPanel { x: root.width - 380px * root.open; width: 380px; height: root.height; }
    }
    if root.open > 0 && !dock: Rectangle {
        background: #0005;
        opacity: root.open;
        TouchArea { clicked => { Api.review-open = false; } }
        ReviewPanel { x: parent.width - self.width * root.open; width: min(400px, parent.width - 40px); height: parent.height; }
    }
    if Api.write-open: WriteDialog { }
    if Api.snapshots-open: SnapshotsDialog { }
    if Api.settings-open: SettingsDialog { }
    if Api.update-open: Modal {
        property <string> state: Api.update.state;
        card-width: 480px;
        dismiss => {
            if state != "downloading" { Api.update-open = false; }
        }
        Text {
            text: state == "ready" ? @tr("Version {} is installed", Api.update.version) : @tr("Version {} is available", Api.update.version);
            font-size: 20px;
            font-weight: 600;
        }
        VerticalLayout {
            Muted { text: Api.update.body; }
            Reveal {
                shown: state == "downloading";
                gap: Tok.gap;
                ProgressIndicator { progress: Api.update.progress; }
            }
            Reveal {
                shown: state == "ready" && Api.change-count > 0;
                gap: Tok.gap;
                Muted { text: @tr("Write or undo the staged changes before restarting."); }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: Tok.tight;
            Button { text: @tr("Release notes"); clicked => { Api.update-page(); } }
            Button {
                text: state == "ready" ? @tr("Later") : state == "downloading" ? @tr("Cancel") : @tr("Not now");
                clicked => {
                    if state == "downloading" {
                        Api.cancel-update();
                    } else {
                        Api.update-open = false;
                    }
                }
            }
            if Api.update.can-install && state != "ready": Button {
                text: state == "failed" ? @tr("Try again") : @tr("Download and install");
                primary: true;
                enabled: state != "downloading";
                clicked => { Api.install-update(); }
            }
            if state == "ready": Button {
                text: @tr("Restart now");
                primary: true;
                enabled: Api.change-count == 0;
                clicked => { Api.restart-update(); }
            }
        }
    }
    if Api.quit-open: Modal {
        card-width: 460px;
        dismiss => { Api.quit-open = false; }
        Text { text: @tr("Quit without writing?"); font-size: 20px; font-weight: 600; }
        Muted {
            text: @tr("{n} change ({}) is not written to the save and will be lost." | "{n} changes ({}) are not written to the save and will be lost." % Api.change-count, @tr("{} value" | "{} values" % Api.value-count, Fmt.num(Api.value-count)));
        }
        HorizontalLayout {
            alignment: end;
            spacing: Tok.tight;
            Button { text: @tr("Cancel"); clicked => { Api.quit-open = false; } }
            Button { text: @tr("Quit without writing"); clicked => { Api.quit(); } }
            Button {
                text: @tr("Write…");
                primary: true;
                clicked => {
                    Api.quit-open = false;
                    Api.check-emulator();
                    Api.write-open = true;
                }
            }
        }
    }
    if Api.open-ask != "": Modal {
        card-width: 460px;
        dismiss => { Api.open-ask = ""; }
        Text { text: @tr("Open another save without writing?"); font-size: 20px; font-weight: 600; }
        Muted {
            text: @tr("{n} change ({}) is not written to the save and will be lost." | "{n} changes ({}) are not written to the save and will be lost." % Api.change-count, @tr("{} value" | "{} values" % Api.value-count, Fmt.num(Api.value-count)));
        }
        HorizontalLayout {
            alignment: end;
            spacing: Tok.tight;
            Button { text: @tr("Cancel"); clicked => { Api.open-ask = ""; } }
            Button { text: @tr("Open without writing"); clicked => { Api.open-confirmed(); } }
            Button {
                text: @tr("Write…");
                primary: true;
                clicked => {
                    Api.open-ask = "";
                    Api.check-emulator();
                    Api.write-open = true;
                }
            }
        }
    }
    if root.about-open: Modal {
        card-width: 440px;
        dismiss => { root.about-open = false; }
        Text { text: @tr("MHGU Save Editor"); font-size: 20px; font-weight: 600; }
        Muted { text: Api.build-info; }
        Muted { text: @tr("Built on the save format notes of the MHGU-Save-editor project (github.com/Scrimas/MHGU-Save-editor). Monster Hunter and its assets are © CAPCOM; this is an unofficial fan tool."); }
        // the notices GPL section 5(d) asks an interactive program to show
        Muted { text: @tr("Copyright © 2026 Scrimas. Free software under the GNU General Public License, version 3 or later, with ABSOLUTELY NO WARRANTY."); }
        // the badge stays small: it was the largest, brightest element on screen (Q15)
        HorizontalLayout {
            alignment: start;
            AboutSlint { width: 200px; height: 80px; }
        }
        HorizontalLayout {
            alignment: end;
            Button { text: @tr("Close"); clicked => { root.about-open = false; } }
        }
    }
    if Api.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: min(lay.preferred-width, parent.width - 32px);
        height: lay.preferred-height;
        border-radius: 8px;
        background: Api.toast-error ? Tok.bad : Tok.dark ? #f3f3f3 : #2b2b2b;
        drop-shadow-blur: 16px;
        drop-shadow-color: #0006;
        lay := HorizontalLayout {
            padding: 12px;
            padding-left: 18px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: Api.toast;
                    color: Api.toast-error ? #ffffff : Tok.dark ? #1c1c1c : #ffffff;
                    font-weight: Api.toast-sub != "" ? 600 : 400;
                    wrap: word-wrap;
                    max-width: 520px;
                }
                if Api.toast-sub != "": Text { text: Api.toast-sub; color: Tok.dark ? #1c1c1cb0 : #ffffffb0; font-size: Tok.small; }
            }
            // the toast is inverted against the theme, so its button is too
            if Api.toast-action != "": Rectangle {
                y: (parent.height - self.height) / 2;
                width: tb.preferred-width + 28px;
                height: 32px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Tok.dark ? #0000002e : #ffffff3d;
                background: tba.pressed ? (Tok.dark ? #e6e6e6 : #4a4a4a) : tba.has-hover ? (Tok.dark ? #f0f0f0 : #444444) : (Tok.dark ? #ffffff : #3a3a3a);
                accessible-role: button;
                accessible-label: Api.toast-action;
                accessible-action-default => { Api.toast-act(); }
                tk := KeyActivate { activated => { Api.toast-act(); } }
                FocusRing { shown: tk.has-focus; border-radius: 4px; }
                tb := Text { text: Api.toast-action; color: Tok.dark ? #1c1c1c : #ffffff; }
                tba := TouchArea { clicked => { Api.toast-act(); } }
            }
        }
    }
    }
}
